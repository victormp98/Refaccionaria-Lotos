@model RefaccionariaWeb.Models.SucursalConfig

@{
    ViewData["Title"] = "Configuración de la Tienda";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom p-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-shop me-2"></i>Datos de la Sucursal
                    </h4>
                    <p class="text-muted small mb-0">Configura la ubicación para el retiro de pedidos en tienda.</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NombreTienda" class="form-label fw-bold small">Nombre Comercial</label>
                            <input asp-for="NombreTienda" class="form-control rounded-3" placeholder="Ej. Refaccionaria Lotos" />
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Direccion" class="form-label fw-bold small">Calle y Número</label>
                                <input asp-for="Direccion" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CP" class="form-label fw-bold small">C.P.</label>
                                <input asp-for="CP" class="form-control rounded-3" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ciudad" class="form-label fw-bold small">Ciudad</label>
                                <input asp-for="Ciudad" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label fw-bold small">Estado</label>
                                <input asp-for="Estado" class="form-control rounded-3" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Telefono" class="form-label fw-bold small">Teléfono de Contacto</label>
                            <input asp-for="Telefono" class="form-control rounded-3" />
                        </div>

                        <div class="d-grid mt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm py-3">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>