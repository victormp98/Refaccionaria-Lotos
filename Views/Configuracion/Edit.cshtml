@model RefaccionariaWeb.Models.SucursalConfig

@{
    ViewData["Title"] = "Configuración de la Tienda";
}

<style>
    .form-control:focus {
        border-color: #2E86C1;
        box-shadow: 0 0 0 0.25rem rgba(46, 134, 193, 0.1);
    }

    .config-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
        color: #2E86C1;
    }

    .form-control-custom {
        border-left: none;
        background-color: #f8f9fa;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card config-card shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                    <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
                        <i class="bi bi-gear-wide-connected text-primary fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Ajustes de Sucursal</h3>
                    <p class="text-muted small">Esta información aparecerá en los tickets y pedidos de tus clientes.</p>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        @* NOMBRE DE LA TIENDA *@
                        <div class="mb-3">
                            <label asp-for="NombreTienda" class="form-label fw-bold small text-muted text-uppercase">Nombre Comercial</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill"><i class="bi bi-shop"></i></span>
                                <input asp-for="NombreTienda" class="form-control form-control-lg rounded-end-pill form-control-custom fs-6" placeholder="Ej. Refaccionaria Lotos" />
                            </div>
                            <span asp-validation-for="NombreTienda" class="text-danger small"></span>
                        </div>

                        @* RFC DE LA SUCURSAL (EL QUE FALTABA) *@
                        <div class="mb-3">
                            <label asp-for="RFC" class="form-label fw-bold small text-muted text-uppercase">RFC de la Empresa</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill"><i class="bi bi-card-text"></i></span>
                                <input asp-for="RFC" class="form-control rounded-end-pill form-control-custom" placeholder="ABC123456XYZ" />
                            </div>
                            <span asp-validation-for="RFC" class="text-danger small"></span>
                        </div>

                        @* DIRECCIÓN Y CP *@
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Direccion" class="form-label fw-bold small text-muted text-uppercase">Calle y Número</label>
                                <div class="input-group">
                                    <span class="input-group-text rounded-start-pill"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Direccion" class="form-control rounded-end-pill form-control-custom" />
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CP" class="form-label fw-bold small text-muted text-uppercase">C.P.</label>
                                <input asp-for="CP" class="form-control rounded-pill bg-light border" placeholder="88000" />
                            </div>
                        </div>

                        @* CIUDAD Y ESTADO *@
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ciudad" class="form-label fw-bold small text-muted text-uppercase">Ciudad</label>
                                <input asp-for="Ciudad" class="form-control rounded-pill bg-light border" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label fw-bold small text-muted text-uppercase">Estado</label>
                                <input asp-for="Estado" class="form-control rounded-pill bg-light border" />
                            </div>
                        </div>

                        @* TELÉFONO *@
                        <div class="mb-4">
                            <label asp-for="Telefono" class="form-label fw-bold small text-muted text-uppercase">Teléfono de Contacto</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Telefono" class="form-control rounded-end-pill form-control-custom" placeholder="899 000 0000" />
                            </div>
                        </div>

                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm py-3 transition-all">
                                <i class="bi bi-cloud-check me-2"></i>Actualizar Configuración
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-link btn-sm text-decoration-none text-muted">Cancelar y Volver</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>