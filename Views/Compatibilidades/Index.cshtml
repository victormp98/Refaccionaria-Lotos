@model IEnumerable<RefaccionariaWeb.Models.Compatibilidad>
@{
    ViewData["Title"] = "Relaciones";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-diagram-3-fill text-primary me-2"></i> Relaciones</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow fw-bold"><i class="bi bi-link-45deg"></i> Nueva</a>
    </div>

    @* PC *@
    <div class="table-responsive d-none d-md-block shadow-sm rounded-4 border bg-white mx-auto" style="max-width: 1100px;">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4 py-3">Pieza</th>
                    <th class="text-center">Vínculo</th>
                    <th>Auto Compatible</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4"><b>@item.Producto.Nombre</b><br><small class="text-muted">@item.Producto.SKU</small></td>
                        <td class="text-center text-muted small"><i class="bi bi-link-45deg fs-4"></i></td>
                        <td><span class="badge bg-dark rounded-pill px-3">@item.Vehiculo.Marca @item.Vehiculo.Modelo</span></td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit" style="background:#e3f2fd; color:#0d6efd; padding:6px 12px; border-radius:8px; text-decoration:none;"><i class="bi bi-pencil-square"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-del" style="background:#ffebee; color:#dc3545; padding:6px 12px; border-radius:8px; text-decoration:none;"><i class="bi bi-trash"></i> Quitar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* MÓVIL *@
    <div class="d-block d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 border-start border-5 border-warning">
                <div class="card-body">
                    <div class="row text-center align-items-center g-2">
                        <div class="col-5 text-start"><small class="text-muted d-block">PIEZA</small><b class="text-primary">@item.Producto.Nombre</b></div>
                        <div class="col-2"><i class="bi bi-arrow-right text-muted"></i></div>
                        <div class="col-5 text-end"><small class="text-muted d-block">AUTO</small><b class="text-dark">@item.Vehiculo.Marca</b></div>
                    </div>
                    <div class="d-flex justify-content-end mt-3 border-top pt-2">
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">Quitar Relación</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>