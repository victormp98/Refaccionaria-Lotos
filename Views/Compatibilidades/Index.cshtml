@model IEnumerable<RefaccionariaWeb.Models.Compatibilidad>

@{
    ViewData["Title"] = "Relaciones de Compatibilidad";
}

<style>
    .link-icon {
        font-size: 1.2rem;
        color: #6c757d;
        transition: 0.3s;
    }

    tr:hover .link-icon {
        transform: rotate(45deg);
        color: #0d6efd;
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
        text-decoration: none;
    }

    .btn-edit {
        background: #e3f2fd;
        color: #0d6efd;
    }

    .btn-del {
        background: #ffebee;
        color: #dc3545;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Relaciones</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow fw-bold"><i class="bi bi-link-45deg me-1"></i> Nueva Relación</a>
    </div>

    <div class="table-responsive d-none d-md-block shadow-sm rounded-4 border bg-white mx-auto" style="max-width: 1100px;">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-muted small fw-bold">
                    <th class="ps-4">PRODUCTO / PIEZA</th>
                    <th class="text-center">VÍNCULO</th>
                    <th>VEHÍCULO COMPATIBLE</th>
                    <th class="text-end pe-4">OPERACIONES</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@item.Producto.Nombre</div>
                            <small class="text-muted">SKU: @item.Producto.SKU</small>
                        </td>
                        <td class="text-center"><i class="bi bi-link-45deg link-icon"></i></td>
                        <td>
                            <span class="badge bg-dark rounded-pill px-3">@item.Vehiculo.Marca @item.Vehiculo.Modelo</span>
                            <small class="d-block text-muted">Años: @item.Vehiculo.AnioInicio - @item.Vehiculo.AnioFin</small>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit"><i class="bi bi-pencil-square"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-del"><i class="bi bi-trash"></i> Quitar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* MÓVIL *@
    <div class="d-block d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 overflow-hidden border-start border-5 border-info">
                <div class="card-body">
                    <div class="row align-items-center g-2 text-center">
                        <div class="col-5 text-start"><small class="text-muted d-block" style="font-size:0.6rem">PIEZA</small><div class="fw-bold text-primary text-truncate">@item.Producto.Nombre</div></div>
                        <div class="col-2"><i class="bi bi-arrow-left-right text-muted"></i></div>
                        <div class="col-5 text-end"><small class="text-muted d-block" style="font-size:0.6rem">AUTO</small><div class="fw-bold text-dark text-truncate">@item.Vehiculo.Marca</div></div>
                    </div>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light w-100 rounded-pill mt-3 btn-sm text-danger fw-bold"><i class="bi bi-trash"></i> Eliminar Relación</a>
                </div>
            </div>
        }
    </div>
</div>