@model List<RefaccionariaWeb.Models.DTOs.ItemCarrito>
@using RefaccionariaWeb.Models
@using RefaccionariaWeb.Extensions

@{
    ViewData["Title"] = "Tu Carrito";
    bool hayErrores = Model.Any(x => !x.EsValido);
    decimal total = Model.Sum(x => x.SubTotal);
}

<style>
    /* Estilo para el botón fijo en móvil estilo ML */
    @@media (max-width: 767.98px) {
        .sticky-summary-mobile {
            position: fixed;
            bottom: 60px; /* Sobre la barra de navegación móvil */
            left: 0;
            right: 0;
            background: white;
            padding: 15px;
            box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
            z-index: 1030;
            border-top: 1px solid #eee;
        }

        body {
            padding-bottom: 180px;
        }
        /* Espacio para que el botón no tape el contenido */
    }

    .qty-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="container py-3">
    <h2 class="fw-bold mb-4">Carrito</h2>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-dash display-1 text-muted"></i>
            <h4 class="mt-3">Tu carrito está vacío</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-3 px-4">Ir al catálogo</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* LISTA DE PRODUCTOS *@
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-3 col-md-2">
                                    <img src="@item.ImagenUrl" class="img-fluid rounded" alt="@item.Nombre">
                                </div>
                                <div class="col-9 col-md-10">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="fw-bold mb-0 text-truncate" style="max-width: 80%;">@item.Nombre</h6>
                                        <a asp-action="Eliminar" asp-route-id="@item.ProductoId" class="text-danger"><i class="bi bi-trash"></i></a>
                                    </div>
                                    <div class="mt-1 fw-bold text-dark">$@item.Precio.ToString("N2")</div>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        @* Selector de cantidad compacto *@
                                        <div class="d-flex align-items-center border rounded-pill p-1">
                                            <a href="@Url.Action("ActualizarCantidad", "Carrito", new { id = item.ProductoId, cantidad = item.Cantidad - 1 })"
                                               class="btn btn-light btn-sm rounded-circle qty-btn @(item.Cantidad <= 1 ? "disabled" : "")">
                                                <i class="bi bi-dash"></i>
                                            </a>
                                            <span class="mx-3 fw-bold">@item.Cantidad</span>
                                            <a href="@Url.Action("ActualizarCantidad", "Carrito", new { id = item.ProductoId, cantidad = item.Cantidad + 1 })"
                                               class="btn btn-light btn-sm rounded-circle qty-btn @(item.Cantidad >= item.StockMaximo ? "disabled" : "")">
                                                <i class="bi bi-plus"></i>
                                            </a>
                                        </div>
                                        <div class="fw-bold text-primary d-none d-md-block">$@item.SubTotal.ToString("N2")</div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.MensajeError))
                                    {
                                        <small class="text-danger d-block mt-1">@item.MensajeError</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* SECCIÓN DE RECOMENDACIONES (ESTILO ML) *@
                <div class="mt-5">
                    <h5 class="fw-bold mb-3">También te puede interesar</h5>
                    <div class="row row-cols-2 row-cols-md-4 g-3">
                        @foreach (var prod in ViewBag.Recomendaciones as List<RefaccionariaWeb.Models.Producto>)
                        {
                            <div class="col">
                                <div class="card h-100 border-0 shadow-sm rounded-4">
                                    <img src="@prod.ImagenUrl" class="card-img-top p-2 rounded-4" style="height: 120px; object-fit: contain;">
                                    <div class="card-body p-2 text-center">
                                        <div class="small fw-bold text-truncate">@prod.Nombre</div>
                                        <div class="text-success fw-bold small">$@prod.PrecioVenta.ToString("N2")</div>
                                        <a asp-controller="Productos" asp-action="Details" asp-route-id="@prod.Id" class="btn btn-outline-primary btn-sm rounded-pill mt-2 w-100">Ver</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* RESUMEN DE COMPRA (PC) *@
            <div class="col-lg-4 d-none d-md-block">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Resumen</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Productos (@Model.Sum(x => x.Cantidad))</span>
                            <span>$@total.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-success fw-bold">
                            <span>Envío</span>
                            <span>Gratis</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">Total</span>
                            <span class="h4 fw-bold text-primary">$@total.ToString("N2")</span>
                        </div>
                        <div class="d-grid">
                            <a asp-controller="Pedidos" asp-action="Create" class="btn btn-success btn-lg rounded-pill fw-bold @(hayErrores ? "disabled" : "")">
                                Continuar compra
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* PANEL FIJO ABAJO (MÓVIL) *@
        <div class="sticky-summary-mobile d-md-none">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Total (@Model.Sum(x => x.Cantidad) prod.)</span>
                <span class="h5 fw-bold mb-0 text-primary">$@total.ToString("N2")</span>
            </div>
            <div class="d-grid">
                <a asp-controller="Pedidos" asp-action="Create" class="btn btn-success btn-lg rounded-pill fw-bold @(hayErrores ? "disabled" : "")">
                    Continuar compra
                </a>
            </div>
        </div>
    }
</div>