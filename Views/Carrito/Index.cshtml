@model List<RefaccionariaWeb.Models.DTOs.ItemCarrito>
@using RefaccionariaWeb.Models
@using RefaccionariaWeb.Extensions

@{
    ViewData["Title"] = "Tu Carrito";
    bool hayErrores = Model.Any(x => !x.EsValido);
    decimal total = Model.Sum(x => x.SubTotal);
}

<style>
    @@media (max-width: 767.98px) {
        .sticky-summary-mobile {
            position: fixed;
            bottom: 60px;
            left: 0;
            right: 0;
            background: white;
            padding: 15px;
            box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
            z-index: 1030;
            border-top: 1px solid #eee;
        }

        body {
            padding-bottom: 180px;
        }
    }

    .qty-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-link {
        text-decoration: none;
        color: inherit;
        transition: 0.2s;
    }

        .product-link:hover {
            color: #0d6efd;
        }
</style>

<div class="container py-3">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart-fill text-primary"></i> Mi Carrito</h2>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="bi bi-cart-dash display-1 text-muted opacity-25"></i>
            <h4 class="mt-3">Tu carrito está vacío</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-3 px-4">Explorar catálogo</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                        <div class="card-body">
                            <div class="row align-items-center">
                                @* IMAGEN CON LINK *@
                                <div class="col-3 col-md-2">
                                    <a asp-controller="Productos" asp-action="Details" asp-route-id="@item.ProductoId">
                                        <img src="@item.ImagenUrl" class="img-fluid rounded border" alt="@item.Nombre">
                                    </a>
                                </div>

                                @* INFO DEL PRODUCTO *@
                                <div class="col-9 col-md-10">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <a asp-controller="Productos" asp-action="Details" asp-route-id="@item.ProductoId" class="product-link">
                                                <h6 class="fw-bold mb-0 text-truncate" style="max-width: 200px;">@item.Nombre</h6>
                                            </a>
                                            <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                                <span class="badge bg-light text-dark border">Ref: @item.ProductoId</span>
                                                <span class="ms-1 fw-bold text-primary">@item.StockMaximo disp.</span>
                                            </div>
                                        </div>
                                        <a asp-action="Eliminar" asp-route-id="@item.ProductoId" class="btn btn-sm btn-outline-danger border-0 rounded-circle">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>

                                    <div class="mt-2 fw-bold text-success fs-5">$@item.Precio.ToString("N2")</div>

                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div class="d-flex align-items-center border rounded-pill p-1 bg-light">
                                            <a href="@Url.Action("ActualizarCantidad", "Carrito", new { id = item.ProductoId, cantidad = item.Cantidad - 1 })"
                                               class="btn btn-white btn-sm rounded-circle shadow-sm qty-btn @(item.Cantidad <= 1 ? "disabled" : "")">
                                                <i class="bi bi-dash"></i>
                                            </a>
                                            <span class="mx-3 fw-bold">@item.Cantidad</span>
                                            <a href="@Url.Action("ActualizarCantidad", "Carrito", new { id = item.ProductoId, cantidad = item.Cantidad + 1 })"
                                               class="btn btn-white btn-sm rounded-circle shadow-sm qty-btn @(item.Cantidad >= item.StockMaximo ? "disabled" : "")">
                                                <i class="bi bi-plus"></i>
                                            </a>
                                        </div>
                                        <div class="text-end">
                                            <div class="small text-muted d-md-none">Subtotal:</div>
                                            <div class="fw-bold text-primary">$@item.SubTotal.ToString("N2")</div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.MensajeError))
                                    {
                                        <div class="alert alert-danger p-2 mt-2 mb-0 border-0" style="font-size: 0.7rem;">
                                            <i class="bi bi-exclamation-circle"></i> @item.MensajeError
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* RECOMENDACIONES *@
                <div class="mt-5">
                    <h5 class="fw-bold mb-3">Recomendados para ti</h5>
                    <div class="row row-cols-2 row-cols-md-4 g-3">
                        @foreach (var prod in ViewBag.Recomendaciones as List<RefaccionariaWeb.Models.Producto>)
                        {
                            <div class="col">
                                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-2">
                                    <a asp-controller="Productos" asp-action="Details" asp-route-id="@prod.Id">
                                        <img src="@prod.ImagenUrl" class="card-img-top rounded-4" style="height: 100px; object-fit: contain;">
                                    </a>
                                    <div class="card-body p-2">
                                        <div class="small fw-bold text-truncate mb-1">@prod.Nombre</div>
                                        <div class="text-success fw-bold">$@prod.PrecioVenta.ToString("N2")</div>
                                        <a asp-controller="Productos" asp-action="Details" asp-route-id="@prod.Id" class="btn btn-link btn-sm text-decoration-none p-0 mt-1">Ver más</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* RESUMEN PC *@
            <div class="col-lg-4 d-none d-md-block">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold mb-4">Resumen de Compra</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Productos (@Model.Sum(x => x.Cantidad))</span>
                            <span class="fw-bold">$@total.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-success fw-bold">
                            <span>Envío</span>
                            <span>Gratis</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">Total</span>
                            <span class="h4 fw-bold text-primary">$@total.ToString("N2")</span>
                        </div>
                        <div class="d-grid">
                            <a asp-controller="Pedidos" asp-action="Create" class="btn btn-success btn-lg rounded-pill fw-bold py-3 shadow @(hayErrores ? "disabled" : "")">
                                Continuar compra <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* STICKY SUMMARY MÓVIL *@
        <div class="sticky-summary-mobile d-md-none">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Total del carrito:</span>
                    <span class="h5 fw-bold mb-0 text-primary">$@total.ToString("N2")</span>
                </div>
                <div class="d-grid">
                    <a asp-controller="Pedidos" asp-action="Create" class="btn btn-success btn-lg rounded-pill fw-bold py-2 shadow @(hayErrores ? "disabled" : "")">
                        Continuar compra
                    </a>
                </div>
            </div>
        </div>
    }
</div>