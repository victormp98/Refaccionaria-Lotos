@model IEnumerable<RefaccionariaWeb.Models.Vehiculo>
@{
    ViewData["Title"] = "Papelera de Autos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold mb-0"><i class="bi bi-trash3-fill"></i> Autos Eliminados</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center shadow-sm rounded-4 py-5 border-0">
            <h4 class="fw-bold mb-0 text-success">No hay autos eliminados</h4>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-4 overflow-hidden border bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Vehículo</th>
                        <th>Motorización</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="text-decoration-line-through text-muted fw-bold">@item.Marca @item.Modelo</div>
                                <small class="text-muted">(@item.AnioInicio - @item.AnioFin)</small>
                            </td>
                            <td class="text-muted small">@item.Motor</td>
                            <td class="text-end pe-4">
                                <a asp-action="Restaurar" asp-route-id="@item.Id" class="btn btn-success btn-sm rounded-pill px-4 fw-bold">
                                    <i class="bi bi-arrow-counterclockwise"></i> Restaurar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>