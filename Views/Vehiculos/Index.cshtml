@model IEnumerable<RefaccionariaWeb.Models.Vehiculo>
@{
    ViewData["Title"] = "Autos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-2">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-car-front-fill text-primary me-2"></i> Autos</h2>
        <div class="d-flex gap-2">
            <a asp-action="Papelera" class="btn btn-outline-danger rounded-pill px-3 fw-bold"><i class="bi bi-trash3"></i> Papelera</a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow fw-bold"><i class="bi bi-plus-lg"></i> Nuevo</a>
        </div>
    </div>

    @* PC *@
    <div class="table-responsive d-none d-md-block shadow-sm rounded-4 overflow-hidden border">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Marca</th>
                    <th>Modelo</th>
                    <th>Años</th>
                    <th>Motor</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@item.Marca</td>
                        <td>@item.Modelo</td>
                        <td><span class="badge bg-light text-primary border px-3">@item.AnioInicio - @item.AnioFin</span></td>
                        <td>@item.Motor</td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit" style="background:#e3f2fd; color:#0d6efd; padding:6px 12px; border-radius:8px; text-decoration:none;"><i class="bi bi-pencil-square"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-del" style="background:#ffebee; color:#dc3545; padding:6px 12px; border-radius:8px; text-decoration:none;"><i class="bi bi-trash"></i> Quitar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* MÓVIL *@
    <div class="d-block d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 border-start border-5 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div><h6 class="fw-bold mb-0">@item.Marca @item.Modelo</h6><small class="text-muted">Motor: @item.Motor</small></div>
                        <span class="badge bg-light text-dark border rounded-pill">@item.AnioInicio-@item.AnioFin</span>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top mt-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">Papelera</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>