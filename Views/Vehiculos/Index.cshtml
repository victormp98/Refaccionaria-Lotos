@model IEnumerable<RefaccionariaWeb.Models.Vehiculo>

@{
    ViewData["Title"] = "Catálogo de Autos";
}

<style>
    :root {
        --primary-soft: #e3f2fd;
        --secondary-soft: #f5f5f5;
        --danger-soft: #ffebee;
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
        border: none;
        text-decoration: none;
    }

    .btn-edit {
        background: var(--primary-soft);
        color: #0d6efd;
    }

        .btn-edit:hover {
            background: #0d6efd;
            color: white;
        }

    .btn-view {
        background: var(--secondary-soft);
        color: #6c757d;
    }

        .btn-view:hover {
            background: #6c757d;
            color: white;
        }

    .btn-del {
        background: var(--danger-soft);
        color: #dc3545;
    }

        .btn-del:hover {
            background: #dc3545;
            color: white;
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-car-front-fill text-primary me-2"></i>Catálogo de Autos</h2>
            <p class="text-muted small mb-0">Modelos base para compatibilidad de refacciones.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Papelera" class="btn btn-outline-danger rounded-pill px-3 shadow-sm"><i class="bi bi-trash"></i> <span class="d-none d-md-inline">Papelera</span></a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow fw-bold"><i class="bi bi-plus-lg me-1"></i> Nuevo Auto</a>
        </div>
    </div>

    @* VISTA PC *@
    <div class="table-responsive d-none d-md-block shadow-sm rounded-4 overflow-hidden border">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Marca y Modelo</th>
                    <th>Generación / Años</th>
                    <th>Motorización</th>
                    <th class="text-center">Operaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark">@item.Marca</div>
                            <div class="text-muted small">@item.Modelo</div>
                        </td>
                        <td><span class="badge bg-light text-primary border px-3 py-2">@item.AnioInicio - @item.AnioFin</span></td>
                        <td><div class="d-flex align-items-center"><i class="bi bi-cpu me-2 text-muted"></i>@item.Motor</div></td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit"><i class="bi bi-pencil-square"></i> Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view"><i class="bi bi-eye"></i> Ver</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-del"><i class="bi bi-trash"></i> Borrar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* VISTA MÓVIL *@
    <div class="d-block d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 border-start border-primary border-5">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="fw-bold mb-0">@item.Marca @item.Modelo</h6>
                            <small class="text-muted">Motor: @item.Motor</small>
                        </div>
                        <span class="badge bg-primary-soft text-primary border border-primary border-opacity-25 rounded-pill">@item.AnioInicio-@item.AnioFin</span>
                    </div>
                    <div class="row g-2 pt-2 border-top mt-2">
                        <div class="col-6"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 rounded-pill btn-sm fw-bold">Editar</a></div>
                        <div class="col-6"><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger w-100 rounded-pill btn-sm fw-bold">Borrar</a></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>