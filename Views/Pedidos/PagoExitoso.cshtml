@model RefaccionariaWeb.Models.Pedido
@{
    ViewData["Title"] = "¡Pago Exitoso!";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            
            <div class="card shadow-lg border-0 rounded-4 p-4 py-5 mb-4" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                
                <h1 class="display-6 fw-bold text-dark mb-3">¡Pago Confirmado!</h1>
                <p class="lead text-muted mb-4">
                    Tu pago ha sido procesado exitosamente mediante Stripe. Estamos preparando tus refacciones para el envío.
                </p>

                <div class="bg-light rounded-3 p-3 mb-4 mx-auto" style="max-width: 300px;">
                    <span class="d-block text-secondary small text-uppercase fw-bold mb-1">Número de Pedido</span>
                    <span class="fs-4 fw-bold text-dark">#@Model.Id</span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-3">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                        Ver Detalles del Pedido
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold mt-2 mt-md-0">
                        Volver al Catálogo
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
