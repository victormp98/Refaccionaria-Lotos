@model RefaccionariaWeb.Models.Pedido

@{
    ViewData["Title"] = $"Detalle Pedido #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
    <h1 class="mb-0 fs-2 fs-md-1"><i class="bi bi-box-seam"></i> Detalle Pedido #@Model.Id</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Volver a Mis Pedidos
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Información General del Pedido</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Fecha del Pedido:</dt>
            <dd class="col-sm-9">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Estado:</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == RefaccionariaWeb.Models.Enums.PedidoStatus.Cancelado ? "bg-danger" : Model.Status == RefaccionariaWeb.Models.Enums.PedidoStatus.Entregado ? "bg-success" : "bg-info")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Total del Pedido:</dt>
            <dd class="col-sm-9 fw-bold text-success fs-5">$@Model.TotalPedido.ToString("N2")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Dirección de Envío</h5>
    </div>
    <div class="card-body">
        <p class="card-text mb-0">**@Model.NombreReceptor**</p>
        <p class="card-text mb-0">@Model.DireccionEnvio</p>
        <p class="card-text mb-0">@Model.CiudadEnvio, @Model.EstadoEnvio, @Model.CodigoPostalEnvio</p>
        <p class="card-text mb-0">@Model.PaisEnvio</p>
    </div>
</div>

@if (Model.RequiereFactura)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Información de Facturación</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">RFC:</dt>
                <dd class="col-sm-9">@Model.Rfc</dd>
                <dt class="col-sm-3">Razón Social:</dt>
                <dd class="col-sm-9">@Model.RazonSocial</dd>
            </dl>
        </div>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Productos del Pedido</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Detalles != null && Model.Detalles.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in Model.Detalles)
                        {
                            <tr>
                                <td>
                                    @if (detalle.Producto != null)
                                    {
                                        <div class="fw-bold">@detalle.Producto.Nombre</div>
                                        <div class="text-muted small">SKU: @detalle.Producto.SKU</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Producto no disponible</div>
                                    }
                                </td>
                                <td>@detalle.Cantidad</td>
                                <td>$@detalle.PrecioUnitario.ToString("N2")</td>
                                <td>$@( (detalle.Cantidad * detalle.PrecioUnitario).ToString("N2") )</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="card-text text-center p-3 text-muted">No hay productos en este pedido.</p>
        }
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
{
    <div class="card border-primary mt-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-gear-fill"></i> Administración del Pedido
        </div>
        <div class="card-body">
            <p class="card-text">Cambiar estado del pedido actual:</p>
            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" name="nuevoStatus" value="Pagado" class="btn btn-success">
                    <i class="bi bi-cash-coin"></i> Marcar como Pagado
                </button>

                <button type="submit" name="nuevoStatus" value="Enviado" class="btn btn-info text-white">
                    <i class="bi bi-truck"></i> Marcar como Enviado
                </button>

                <button type="submit" name="nuevoStatus" value="Entregado" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Finalizar (Entregado)
                </button>

                <div class="vr mx-2"></div>

                <button type="submit" name="nuevoStatus" value="Cancelado" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i> Cancelar Pedido
                </button>
            </form>
        </div>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var requiereFacturaCheckbox = document.getElementById('@Html.IdFor(model => model.RequiereFactura)');
            var billingInfoDiv = document.getElementById('billingInfo');

            function toggleBillingInfo() {
                if (requiereFacturaCheckbox.checked) {
                    billingInfoDiv.style.display = 'block';
                } else {
                    billingInfoDiv.style.display = 'none';
                }
            }

            requiereFacturaCheckbox.addEventListener('change', toggleBillingInfo);
            toggleBillingInfo(); // Set initial state
        });
    </script>
}