@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    bool esAdmin = User.IsInRole("Admin");
    bool esMostrador = User.IsInRole("Mostrador");
    bool esAlmacen = User.IsInRole("Almacen");
    bool esCliente = User.IsInRole("Cliente");

    ViewData["Title"] = !esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra";

    bool esRetiroLocal = Model.TipoEntrega == 1;

    // --- LÓGICA DE LA BANDERA ---
    var origen = Context.Request.Query["origen"].ToString();
    var accionVolver = (origen == "almacen") ? "Almacen" : "Index";

    // --- LÓGICA DE PASOS (STEPPER) ---
    int pasoActual = (int)Model.Status;
}

<style>
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
    }

    .stepper-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        z-index: 2;
    }

        .stepper-item::before {
            position: absolute;
            content: "";
            border-bottom: 3px solid #e0e0e0;
            width: 100%;
            top: 20px;
            left: -50%;
            z-index: -1;
        }

        .stepper-item:first-child::before {
            content: none;
        }

    .step-counter {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 6px;
        color: white;
        font-weight: bold;
        transition: 0.3s;
    }

    .step-name {
        font-size: 0.75rem;
        color: #888;
        text-align: center;
        font-weight: 600;
    }

    .stepper-item.completed .step-counter {
        background-color: #198754;
    }

    .stepper-item.completed .step-name {
        color: #198754;
    }

    .stepper-item.active .step-counter {
        background-color: #0d6efd;
        box-shadow: 0 0 10px rgba(13,110,253,0.5);
    }

    .stepper-item.active .step-name {
        color: #0d6efd;
        font-weight: bold;
    }

    .stepper-item.completed::before {
        border-color: #198754;
    }

    @@media (max-width: 576px) {
        .step-name {
            display: none;
        }

        .step-counter {
            width: 30px;
            height: 30px;
            font-size: 0.8rem;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
    <h1 class="mb-0 fs-2 fs-md-1">
        <i class="bi bi-box-seam text-primary"></i>
        @(!esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra")
    </h1>
    <a asp-action="@accionVolver" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

@if (Model.Status != PedidoStatus.Cancelado)
{
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body py-4">
            <div class="stepper-wrapper">
                <div class="stepper-item @(pasoActual > 0 ? "completed" : (pasoActual == 0 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-wallet2"></i></div>
                    <div class="step-name">Pendiente</div>
                </div>
                <div class="stepper-item @(pasoActual > 1 ? "completed" : (pasoActual == 1 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-check-circle"></i></div>
                    <div class="step-name">Pagado</div>
                </div>
                <div class="stepper-item @(pasoActual > 2 ? "completed" : (pasoActual == 2 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-box-seam"></i></div>
                    <div class="step-name">Surtido</div>
                </div>
                <div class="stepper-item @(pasoActual > 3 ? "completed" : (pasoActual == 3 ? "active" : ""))">
                    <div class="step-counter"><i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck")"></i></div>
                    <div class="step-name">@(esRetiroLocal ? "En Sucursal" : "Enviado")</div>
                </div>
                <div class="stepper-item @(pasoActual == 4 ? "active completed" : "")">
                    <div class="step-counter"><i class="bi bi-house-check"></i></div>
                    <div class="step-name">Entregado</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Resumen General</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Fecha:</dt>
                    <dd class="col-sm-7 small">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5 text-muted small">Estado:</dt>
                    <dd class="col-sm-7">
                        @{
                            var color = Model.Status == PedidoStatus.Pagado ? "bg-success" :
                            Model.Status == PedidoStatus.PendienteDePago ? "bg-warning text-dark" :
                            Model.Status == PedidoStatus.EnProceso ? "bg-primary" :
                            Model.Status == PedidoStatus.Cancelado ? "bg-danger" : "bg-info";
                        }
                        <span class="badge @color px-3 py-2 rounded-pill small">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-5 text-muted small">Total:</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-5">$@Model.TotalPedido.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 @(esRetiroLocal ? "border-start border-4 border-warning" : "")">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold">
                    <i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck") me-2 text-primary"></i>
                    @(esRetiroLocal ? "Recoger en Sucursal" : "Entrega a Domicilio")
                </h5>
            </div>
            <div class="card-body">
                @if (esRetiroLocal)
                {
                    <div class="alert alert-warning border-0 py-2 small mb-3">
                        <i class="bi bi-info-square-fill me-2"></i> Puedes pasar por tu paquete una vez que el estado cambie a "Listo para Retiro".
                    </div>
                }

                <p class="mb-1 fw-bold text-dark">@Model.NombreReceptor</p>
                <p class="mb-1 text-muted small"><i class="bi bi-geo-alt me-1"></i> @Model.DireccionEnvio</p>
                <p class="mb-0 text-muted small">@Model.CiudadEnvio, @Model.EstadoEnvio, CP @Model.CodigoPostalEnvio</p>

                @if (!string.IsNullOrEmpty(Model.NumeroGuia))
                {
                    <div class="mt-3 p-3 bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-25 shadow-sm">
                        <small class="d-block text-primary fw-bold mb-1"><i class="bi bi-truck me-1"></i> RASTREO DE ENVÍO:</small>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="d-block small"><strong>Paquetería:</strong> @Model.Paqueteria</span>
                                <span class="d-block small"><strong>Guía:</strong> @Model.NumeroGuia</span>
                            </div>
                            <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="navigator.clipboard.writeText('@Model.NumeroGuia')">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* --- ACCIÓN PARA EL CLIENTE: Confirmar Recepción --- *@
        @if (esCliente && Model.Status == PedidoStatus.Enviado)
        {
            <div class="card shadow-sm border-0 rounded-4 mt-3 bg-primary text-white">
                <div class="card-body text-center p-4">
                    <h6>¿Ya recibiste tu producto?</h6>
                    <form asp-action="ConfirmarEntrega" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-light rounded-pill px-4 fw-bold mt-2">Sí, ya lo recibí</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-cart me-2 text-primary"></i>Productos Comprados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 small">Producto</th>
                                <th class="text-center small">Cant.</th>
                                <th class="text-end pe-4 small">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold small">@d.Producto?.Nombre</div>
                                        <small class="text-muted" style="font-size: 0.7rem;">SKU: @d.Producto?.SKU</small>
                                    </td>
                                    <td class="text-center small">@d.Cantidad</td>
                                    <td class="text-end pe-4 fw-bold small">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (esAdmin || esMostrador || esAlmacen)
{
    <div class="card border-primary mt-4 shadow-sm rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
            <h6 class="mb-0"><i class="bi bi-gear-fill me-2"></i> Panel de Gestión de Orden</h6>
        </div>
        <div class="card-body bg-light rounded-bottom-4">
            <form asp-action="UpdateStatus" method="post" id="formStatus" class="row g-3 justify-content-center text-center">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@(origen == "almacen" ? Url.Action("Details", new { id = Model.Id, origen = "almacen" }) : "")" />

                @if (!esRetiroLocal && Model.Status != PedidoStatus.Entregado && Model.Status != PedidoStatus.Cancelado)
                {
                    <div class="col-md-10 border-bottom pb-3 mb-2">
                        <div class="row g-2 text-start">
                            <div class="col-md-6">
                                <label class="small fw-bold">Paquetería</label>
                                <input type="text" name="paqueteria" id="inputPaq" class="form-control" placeholder="DHL, FedEx, etc." value="@Model.Paqueteria" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold">Número de Guía</label>
                                <input type="text" name="guia" id="inputGuia" class="form-control" placeholder="Código de rastreo" value="@Model.NumeroGuia" />
                            </div>
                        </div>
                    </div>
                }

                <div class="col-12 d-flex gap-2 flex-wrap justify-content-center">
                    @if (esAdmin || esMostrador)
                    {
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Pagado" class="btn btn-success rounded-pill px-4">Pagado</button>
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.EnProceso" class="btn btn-primary rounded-pill px-4">En Proceso</button>
                    }

                    @if (Model.Status != PedidoStatus.Enviado && Model.Status != PedidoStatus.Entregado)
                    {
                        <button type="button" onclick="confirmarEnvio()" id="btnEnviado" class="btn btn-info text-white rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-send-check me-1"></i>
                            @(esRetiroLocal ? "Listo para Retiro" : "Marcar como Enviado")
                        </button>
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Enviado" id="submitEnviado" style="display:none;"></button>
                    }

                    @if (esAdmin || esMostrador)
                    {
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Entregado" class="btn btn-primary rounded-pill px-4">Entregado</button>
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Cancelado" class="btn btn-outline-danger rounded-pill px-4">Cancelar</button>
                    }

                    @* BOTÓN DE SCRAP *@
                    @if (esAlmacen || esAdmin)
                    {
                        <button type="button" onclick="reportarScrap()" class="btn btn-danger rounded-pill px-4 shadow-sm">
                            <i class="bi bi-trash3 me-1"></i> Scrap
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
}

@* Formulario Oculto para Scrap *@
<form id="formScrap" asp-action="ReportarScrap" method="post" style="display:none;">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="motivo" id="motivoScrap" />
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmarEnvio() {
            const inputPaq = document.getElementById("inputPaq");
            const inputGuia = document.getElementById("inputGuia");
            const esRetiro = @esRetiroLocal.ToString().ToLower();

            if (!esRetiro) {
                if (!inputPaq.value.trim() || !inputGuia.value.trim()) {
                    Swal.fire({ icon: 'warning', title: 'Atención', text: 'Debes ingresar la Paquetería y el Número de Guía.' });
                    return;
                }
            }

            Swal.fire({
                title: '¿Confirmar despacho?',
                text: esRetiro ? "El cliente recibirá una notificación." : "Se registrará el envío con la guía proporcionada.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, confirmar'
            }).then((result) => { if (result.isConfirmed) document.getElementById("submitEnviado").click(); });
        }

        function reportarScrap() {
            Swal.fire({
                title: 'Reportar pieza dañada (Scrap)',
                text: "Escribe el motivo del daño. Esto cancelará el pedido y NO devolverá el stock.",
                input: 'text',
                inputPlaceholder: 'Ej: Faro con mica rota',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Confirmar Scrap'
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    document.getElementById("motivoScrap").value = result.value;
                    document.getElementById("formScrap").submit();
                }
            });
        }
    </script>
}