@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    bool esAdmin = User.IsInRole("Admin");
    bool esMostrador = User.IsInRole("Mostrador");
    bool esAlmacen = User.IsInRole("Almacen");
    bool esCliente = User.IsInRole("Cliente");

    ViewData["Title"] = !esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra";
    bool esRetiroLocal = Model.TipoEntrega == 2; // Aseguramos que 2 sea Mostrador/Retiro según tu lógica anterior

    // CAPTURAMOS EL ORIGEN (Tu lógica original)
    var origen = Context.Request.Query["origen"].ToString();
    var accionVolver = (origen == "surtir" || origen == "almacen") ? "Almacen" : "Index";

    int pasoActual = (int)Model.Status;
    bool requiereFactura = !string.IsNullOrEmpty(Model.Rfc) || !string.IsNullOrEmpty(Model.RazonSocial);
    string inicial = !string.IsNullOrEmpty(Model.Cliente?.Email) ? Model.Cliente.Email.Substring(0, 1).ToUpper() : "U";

    // LÓGICA MAESTRA DE PERMISOS (Tu lógica original)
    bool almacenPuedeOperar = esAlmacen && origen == "surtir";
    bool mostrarControles = esAdmin || esMostrador || almacenPuedeOperar;

    // --- 🟢 NUEVA LÓGICA: DETECCIÓN Y DESGLOSE DE IVA ---
    // Buscamos la "marca de agua" que dejamos al cobrar en mostrador
    bool tieneIva = !string.IsNullOrEmpty(Model.DireccionEnvio) && Model.DireccionEnvio.Contains("Con IVA");

    decimal totalCobrado = Model.TotalPedido;
    decimal subtotalCalculado = totalCobrado; // Por defecto es igual al total (si no hay IVA)
    decimal ivaCalculado = 0;

    if (tieneIva)
    {
        // Si detectamos la marca, hacemos ingeniería inversa
        subtotalCalculado = totalCobrado / 1.16m;
        ivaCalculado = totalCobrado - subtotalCalculado;
    }
}

<style>
    .ticket-header {
        background: #f8f9fa;
        border-radius: 15px 15px 0 0;
        border-bottom: 2px dashed #dee2e6;
    }

    .avatar-circle {
        width: 45px;
        height: 45px;
        background: #2E86C1;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
    }
    /* Stepper Styles... (Los mismos de siempre, respetados) */
    .stepper-horizontal {
        display: flex;
        justify-content: space-between;
        margin: 20px 0;
        position: relative;
    }

    .step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .step-icon {
        width: 35px;
        height: 35px;
        background: #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 5px;
        color: #adb5bd;
        transition: 0.3s;
        font-size: 0.9rem;
    }

    .step.active .step-icon {
        background: #0d6efd;
        color: white;
        box-shadow: 0 0 0 5px rgba(13,110,253,0.1);
    }

    .step.completed .step-icon {
        background: #198754;
        color: white;
    }

    .step::after {
        content: "";
        position: absolute;
        width: 100%;
        height: 2px;
        background: #e9ecef;
        top: 17px;
        left: 50%;
        z-index: -1;
    }

    .step:last-child::after {
        display: none;
    }

    .step.completed::after {
        background: #198754;
    }

    .step-text {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #adb5bd;
    }

    .step.active .step-text {
        color: #0d6efd;
    }
</style>

<div class="container-fluid py-3">
    @* ENCABEZADO *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-receipt text-primary"></i> @(!esCliente ? $"Pedido #{Model.Id}" : "Mi Compra")
            </h2>
            <span class="badge bg-light text-muted border">@Model.FechaPedido.ToString("dd MMM yyyy, HH:mm")</span>
            @* Indicador visual extra si es factura *@
            @if (tieneIva)
            {
                <span class="badge bg-info text-dark border ms-2">IVA Desglosado</span>
            }
        </div>
        <a asp-action="@accionVolver" class="btn btn-light rounded-pill border fw-bold px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    @* TRAZABILIDAD (STEPPER) *@
    @if (Model.Status != PedidoStatus.Cancelado)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body py-3">
                <div class="stepper-horizontal">
                    <div class="step @(pasoActual >= 0 ? "completed" : "") @(pasoActual == 0 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-wallet2"></i></div><div class="step-text">Pendiente</div>
                    </div>
                    <div class="step @(pasoActual >= 1 ? "completed" : "") @(pasoActual == 1 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-check-lg"></i></div><div class="step-text">Pagado</div>
                    </div>
                    <div class="step @(pasoActual >= 2 ? "completed" : "") @(pasoActual == 2 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-box-seam"></i></div><div class="step-text">Surtido</div>
                    </div>
                    <div class="step @(pasoActual >= 3 ? "completed" : "") @(pasoActual == 3 ? "active" : "")">
                        <div class="step-icon"><i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck")"></i></div><div class="step-text">@(esRetiroLocal ? "Listo" : "Enviado")</div>
                    </div>
                    <div class="step @(pasoActual >= 4 ? "completed" : "") @(pasoActual == 4 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-house-check"></i></div><div class="step-text">Entregado</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        @* COLUMNA IZQUIERDA: LISTA DE PRODUCTOS *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="ticket-header p-4">
                    <div class="d-flex align-items-center">
                        <div class="avatar-circle me-3 shadow-sm">@inicial</div>
                        <div><h5 class="mb-0 fw-bold">Cliente</h5><small class="text-muted">@Model.NombreReceptor</small></div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light text-muted small fw-bold">
                                <tr>
                                    <th class="ps-4 border-0 py-3">REFACCIÓN</th>
                                    <th class="text-center border-0 py-3">CANT.</th>
                                    @* RESPETAMOS TU LÓGICA DE ALMACENISTA (OCULTAR PRECIOS) *@
                                    @if (!esAlmacen)
                                    {
                                        <th class="text-end border-0 py-3">UNITARIO</th>
                                        <th class="text-end pe-4 border-0 py-3">SUBTOTAL</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Detalles)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@d.Producto?.Nombre</div>
                                            <small class="text-muted">SKU: @d.Producto?.SKU | Marca: @d.Producto?.MarcaPieza</small>
                                        </td>
                                        <td class="text-center fw-bold">@d.Cantidad</td>
                                        @if (!esAlmacen)
                                        {
                                            <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                                            <td class="text-end pe-4 fw-bold">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* AQUÍ ESTÁ EL CAMBIO IMPORTANTE: RESUMEN FINANCIERO INTELIGENTE *@
                @if (!esAlmacen)
                {
                    <div class="card-footer bg-light p-4 border-0">
                        <div class="row justify-content-end">
                            <div class="col-md-6 col-lg-5 text-end">
                                <h6 class="text-muted small fw-bold">RESUMEN DE PAGO</h6>

                                @* 1. Subtotal Real *@
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <span class="fw-bold">$@subtotalCalculado.ToString("N2")</span>
                                </div>

                                @* 2. IVA condicional (Solo si se detecta) *@
                                @if (tieneIva)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">IVA (16%):</span>
                                        <span class="text-danger fw-bold">+ $@ivaCalculado.ToString("N2")</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Impuestos:</span>
                                        <span class="text-muted">$0.00</span>
                                    </div>
                                }

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Entrega:</span>
                                    <span class="text-success fw-bold">GRATIS</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h5 fw-bold text-dark mb-0">TOTAL:</span>
                                    <span class="h4 fw-bold text-success mb-0">$@totalCobrado.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-footer bg-white p-4 border-0 text-center"><span class="text-muted small fw-bold text-uppercase"><i class="bi bi-info-circle me-1"></i> Información de precios restringida para Almacén</span></div>
                }
            </div>
        </div>

        @* COLUMNA DERECHA: LOGÍSTICA *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3"><div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary"><i class="bi bi-geo-alt-fill"></i></div><h5 class="fw-bold mb-0">Envío / Entrega</h5></div>
                    <div class="mb-3"><p class="mb-1 small text-muted text-uppercase fw-bold">Receptor:</p><p class="mb-0 fw-bold text-dark">@Model.NombreReceptor</p></div>
                    <hr>
                    <div class="mb-2">
                        <p class="text-muted small mb-1 fw-bold text-uppercase">Dirección / Método:</p>
                        @* Mostramos el método de pago/dirección *@
                        <p class="small fw-bold mb-0">@Model.DireccionEnvio</p>
                        <p class="small text-muted">@Model.CiudadEnvio, @Model.EstadoEnvio, @Model.CodigoPostalEnvio</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.NumeroGuia))
                    {
                        <div class="mt-3 p-3 bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-25 text-center"><small class="d-block text-primary fw-bold mb-1">RASTREO @Model.Paqueteria?.ToUpper():</small><code class="text-primary fw-bold fs-5">@Model.NumeroGuia</code></div>
                    }
                </div>
            </div>

            @if (requiereFactura)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                    <div class="card-body"><h6 class="fw-bold mb-3 text-primary"><i class="bi bi-file-earmark-text me-2"></i>Facturación</h6><div class="small"><div class="text-muted small fw-bold">RAZÓN SOCIAL:</div><div class="fw-bold mb-2">@Model.RazonSocial</div><div class="text-muted small fw-bold">RFC:</div><div class="fw-bold">@Model.Rfc</div></div></div>
                </div>
            }

            @* 🚀 AQUI APLICAMOS EL FILTRO MAESTRO (Tu lógica original) *@
            @if (mostrarControles)
            {
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white py-3"><h6 class="mb-0 fw-bold"><i class="bi bi-gear-fill me-2"></i>Gestión Operativa</h6></div>
                    <div class="card-body bg-light p-4">
                        <form asp-action="UpdateStatus" method="post" id="formStatus">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@(origen == "surtir" || origen == "almacen" ? Url.Action("Almacen") : "")" />

                            @if (!esRetiroLocal && Model.Status != PedidoStatus.Entregado && Model.Status != PedidoStatus.Cancelado)
                            {
                                <div class="mb-3">
                                    <input type="text" name="paqueteria" id="inputPaq" class="form-control mb-2 rounded-pill" placeholder="Paquetería" value="@Model.Paqueteria" />
                                    <input type="text" name="guia" id="inputGuia" class="form-control rounded-pill" placeholder="No. de Guía" value="@Model.NumeroGuia" />
                                </div>
                            }

                            <div class="d-grid gap-2">
                                @if (esAdmin || esMostrador)
                                {
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Pagado" class="btn btn-outline-success btn-sm rounded-pill fw-bold">Pagado</button>
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.EnProceso" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">Surtido</button>
                                }

                                <button type="button" onclick="validarEnvio()" class="btn btn-primary rounded-pill fw-bold shadow">
                                    @(esRetiroLocal ? "Listo para Entrega" : "Registrar Envío")
                                </button>
                                <button type="submit" name="nuevoStatus" value="@PedidoStatus.Enviado" id="submitEnviado" style="display:none;"></button>

                                @if (esAdmin)
                                {
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Entregado" class="btn btn-dark btn-sm rounded-pill fw-bold mt-2">Cerrar Entregado</button>
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Cancelado" class="btn btn-link text-danger btn-sm text-decoration-none fw-bold">Cancelar Pedido</button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validarEnvio() {
            const esRetiro = @esRetiroLocal.ToString().ToLower();
            if (!esRetiro) {
                const paq = document.getElementById("inputPaq").value;
                const guia = document.getElementById("inputGuia").value;
                if (!paq || !guia) {
                    Swal.fire({ icon: 'warning', title: 'Faltan datos', text: 'Captura paquetería y guía antes de marcar como enviado.' });
                    return;
                }
            }
            document.getElementById("submitEnviado").click();
        }
    </script>
}