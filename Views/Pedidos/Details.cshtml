@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    bool esAdmin = User.IsInRole("Admin");
    bool esMostrador = User.IsInRole("Mostrador");
    bool esAlmacen = User.IsInRole("Almacen");
    bool esCliente = User.IsInRole("Cliente");

    ViewData["Title"] = !esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra";
    bool esRetiroLocal = Model.TipoEntrega == 1;
    var origen = Context.Request.Query["origen"].ToString();
    var accionVolver = (origen == "almacen") ? "Almacen" : "Index";
    int pasoActual = (int)Model.Status;
}

<style>
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
    }

    .stepper-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        z-index: 2;
    }

        .stepper-item::before {
            position: absolute;
            content: "";
            border-bottom: 3px solid #e0e0e0;
            width: 100%;
            top: 20px;
            left: -50%;
            z-index: -1;
        }

        .stepper-item:first-child::before {
            content: none;
        }

    .step-counter {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 6px;
        color: white;
        font-weight: bold;
        transition: 0.3s;
    }

    .step-name {
        font-size: 0.75rem;
        color: #888;
        text-align: center;
        font-weight: 600;
    }

    .stepper-item.completed .step-counter {
        background-color: #198754;
    }

    .stepper-item.completed .step-name {
        color: #198754;
    }

    .stepper-item.active .step-counter {
        background-color: #0d6efd;
        box-shadow: 0 0 10px rgba(13,110,253,0.5);
    }

    .stepper-item.active .step-name {
        color: #0d6efd;
        font-weight: bold;
    }

    .stepper-item.completed::before {
        border-color: #198754;
    }

    @@media (max-width: 576px) {
        .step-name {
            display: none;
        }

        .step-counter {
            width: 30px;
            height: 30px;
            font-size: 0.8rem;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
    <h1 class="mb-0 fs-2 fs-md-1">
        <i class="bi bi-box-seam text-primary"></i>
        @(!esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra")
    </h1>
    <a asp-action="@accionVolver" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

@if (Model.Status != PedidoStatus.Cancelado)
{
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body py-4">
            <div class="stepper-wrapper">
                <div class="stepper-item @(pasoActual > 0 ? "completed" : (pasoActual == 0 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-wallet2"></i></div>
                    <div class="step-name">Pendiente</div>
                </div>
                <div class="stepper-item @(pasoActual > 1 ? "completed" : (pasoActual == 1 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-check-circle"></i></div>
                    <div class="step-name">Pagado</div>
                </div>
                <div class="stepper-item @(pasoActual > 2 ? "completed" : (pasoActual == 2 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-box-seam"></i></div>
                    <div class="step-name">Surtido</div>
                </div>
                <div class="stepper-item @(pasoActual > 3 ? "completed" : (pasoActual == 3 ? "active" : ""))">
                    <div class="step-counter"><i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck")"></i></div>
                    <div class="step-name">@(esRetiroLocal ? "En Sucursal" : "Enviado")</div>
                </div>
                <div class="stepper-item @(pasoActual == 4 ? "active completed" : "")">
                    <div class="step-counter"><i class="bi bi-house-check"></i></div>
                    <div class="step-name">Entregado</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Resumen General</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Fecha:</dt>
                    <dd class="col-sm-7 small">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-5 text-muted small">Total:</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-5">$@Model.TotalPedido.ToString("N2")</dd>
                </dl>

                @if (esCliente && Model.Status == PedidoStatus.Enviado)
                {
                    <div class="mt-3 p-3 bg-primary text-white rounded-4 text-center">
                        <h6 class="mb-2">¿Recibiste tu pedido?</h6>
                        <form asp-action="ConfirmarEntrega" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-light btn-sm rounded-pill px-4 fw-bold shadow-sm">Sí, ya lo recibí</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-geo-alt me-2 text-primary"></i>Datos de Entrega</h5>
            </div>
            <div class="card-body">
                <p class="mb-1 fw-bold">@Model.NombreReceptor</p>
                <p class="mb-0 text-muted small">@Model.DireccionEnvio, @Model.CiudadEnvio</p>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-cart me-2 text-primary"></i>Productos</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Producto</th><th class="text-center">Cant.</th><th class="text-end pe-4">Subtotal</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                <tr>
                                    <td class="ps-4">@d.Producto?.Nombre</td>
                                    <td class="text-center">@d.Cantidad</td>
                                    <td class="text-end pe-4 fw-bold">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (esAdmin || esMostrador || esAlmacen)
{
    <div class="card border-primary mt-4 shadow-sm rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
            <h6 class="mb-0"><i class="bi bi-gear-fill me-2"></i> Gestión Administrativa</h6>
        </div>
        <div class="card-body bg-light rounded-bottom-4 text-center">
            <div class="d-flex gap-3 flex-wrap justify-content-center">

                @* EL BOTÓN QUE TE FALTABA (VISIBLE SI ESTÁ EN PROCESO) *@
                @if (Model.Status == PedidoStatus.EnProceso)
                {
                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="nuevoStatus" value="@PedidoStatus.Enviado" />
                        <input type="hidden" name="returnUrl" value="@(origen == "almacen" ? Url.Action("Almacen") : "")" />

                        <button type="submit" class="btn btn-info text-white rounded-pill px-5 fw-bold shadow-sm py-2">
                            <i class="bi bi-check-all me-1"></i>
                            @(esRetiroLocal ? "Listo para Entrega" : "Marcar como Enviado")
                        </button>
                    </form>
                }

                @* BOTÓN SCRAP - PRÓXIMAMENTE *@
                <button type="button" class="btn btn-danger rounded-pill px-4 shadow-sm py-2" disabled title="Falta configurar base de datos">
                    <i class="bi bi-trash3 me-1"></i> Scrap (Próximamente)
                </button>

                @* BOTÓN CANCELAR - PRÓXIMAMENTE *@
                <button type="button" class="btn btn-outline-danger rounded-pill px-4 py-2" disabled>
                    Cancelar Pedido (Próximamente)
                </button>

            </div>
        </div>
    </div>
}