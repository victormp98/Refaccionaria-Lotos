@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    bool esAdmin = User.IsInRole("Admin");
    bool esMostrador = User.IsInRole("Mostrador");
    bool esAlmacen = User.IsInRole("Almacen");
    bool esCliente = User.IsInRole("Cliente");

    ViewData["Title"] = !esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra";
    bool esRetiroLocal = Model.TipoEntrega == 1;
    var origen = Context.Request.Query["origen"].ToString();
    var accionVolver = (origen == "almacen") ? "Almacen" : "Index";
    int pasoActual = (int)Model.Status;

    // Lógica para detectar si hay datos de facturación (Ajusta los nombres de propiedad según tu modelo)
    bool requiereFactura = !string.IsNullOrEmpty(Model.RFC) || !string.IsNullOrEmpty(Model.RazonSocial);
}

<style>
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
    }

    .stepper-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        z-index: 2;
    }

        .stepper-item::before {
            position: absolute;
            content: "";
            border-bottom: 3px solid #e0e0e0;
            width: 100%;
            top: 20px;
            left: -50%;
            z-index: -1;
        }

        .stepper-item:first-child::before {
            content: none;
        }

    .step-counter {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 6px;
        color: white;
        font-weight: bold;
        transition: 0.3s;
    }

    .step-name {
        font-size: 0.75rem;
        color: #888;
        text-align: center;
        font-weight: 600;
    }

    .stepper-item.completed .step-counter {
        background-color: #198754;
    }

    .stepper-item.completed::before {
        border-color: #198754;
    }

    .stepper-item.active .step-counter {
        background-color: #0d6efd;
        box-shadow: 0 0 10px rgba(13,110,253,0.5);
    }

    @@media (max-width: 576px) {
        .step-name {
            display: none;
        }

        .step-counter {
            width: 30px;
            height: 30px;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
    <h1 class="mb-0 fs-2 fw-bold">
        <i class="bi bi-box-seam text-primary"></i>
        @(!esCliente ? $"Pedido #{Model.Id}" : "Detalle de mi Compra")
    </h1>
    <a asp-action="@accionVolver" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

@* STEPPER *@
@if (Model.Status != PedidoStatus.Cancelado)
{
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body py-4">
            <div class="stepper-wrapper">
                <div class="stepper-item @(pasoActual > 0 ? "completed" : (pasoActual == 0 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-wallet2"></i></div>
                    <div class="step-name">Pendiente</div>
                </div>
                <div class="stepper-item @(pasoActual > 1 ? "completed" : (pasoActual == 1 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-check-circle"></i></div>
                    <div class="step-name">Pagado</div>
                </div>
                <div class="stepper-item @(pasoActual > 2 ? "completed" : (pasoActual == 2 ? "active" : ""))">
                    <div class="step-counter"><i class="bi bi-box-seam"></i></div>
                    <div class="step-name">Surtido</div>
                </div>
                <div class="stepper-item @(pasoActual > 3 ? "completed" : (pasoActual == 3 ? "active" : ""))">
                    <div class="step-counter"><i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck")"></i></div>
                    <div class="step-name">@(esRetiroLocal ? "Listo" : "Enviado")</div>
                </div>
                <div class="stepper-item @(pasoActual == 4 ? "active completed" : "")">
                    <div class="step-counter"><i class="bi bi-house-check"></i></div>
                    <div class="step-name">Entregado</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        @* INFO GENERAL *@
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Resumen</h5>
                <p class="mb-1 small text-muted">Fecha: @Model.FechaPedido.ToString("g")</p>
                <p class="mb-0 fw-bold text-success fs-4">$@Model.TotalPedido.ToString("N2")</p>

                @if (esCliente && Model.Status == PedidoStatus.Enviado)
                {
                    <form asp-action="ConfirmarEntrega" method="post" class="mt-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Sí, ya recibí mi paquete</button>
                    </form>
                }
            </div>
        </div>

        @* DATOS DE ENVÍO *@
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt me-2 text-primary"></i>Entrega</h5>
                <p class="mb-1 fw-bold">@Model.NombreReceptor</p>
                <p class="mb-2 small text-muted">@Model.DireccionEnvio, @Model.CiudadEnvio</p>

                @if (!string.IsNullOrEmpty(Model.NumeroGuia))
                {
                    <div class="p-3 bg-light rounded-4 border shadow-sm mt-2">
                        <small class="d-block text-primary fw-bold mb-1">GUÍA DE RASTREO:</small>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">@Model.Paqueteria: @Model.NumeroGuia</span>
                            <button class="btn btn-sm btn-primary rounded-circle" onclick="navigator.clipboard.writeText('@Model.NumeroGuia')">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* SECCIÓN DE FACTURACIÓN CONDICIONAL *@
        @if (requiereFactura)
        {
            <div class="card shadow-sm border-0 rounded-4 mb-4 border-start border-4 border-primary">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-file-earmark-text me-2"></i>Datos Fiscales</h5>
                    <div class="bg-light p-3 rounded-3">
                        <p class="mb-1 small"><strong>Razón Social:</strong><br /> @Model.RazonSocial</p>
                        <p class="mb-0 small"><strong>RFC:</strong><br /> @Model.RFC</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-md-7">
        @* PRODUCTOS *@
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Productos</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Item</th><th class="text-center">Cant.</th><th class="text-end pe-4">Subtotal</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                <tr>
                                    <td class="ps-4">@d.Producto?.Nombre <br /><small class="text-muted">SKU: @d.Producto?.SKU</small></td>
                                    <td class="text-center">@d.Cantidad</td>
                                    <td class="text-end pe-4 fw-bold">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- PANEL DE GESTIÓN --- *@
@if (esAdmin || esMostrador || esAlmacen)
{
    <div class="card border-primary mt-4 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="mb-0"><i class="bi bi-gear-fill me-2"></i> Gestión de Estatus</h6>
        </div>
        <div class="card-body bg-light">
            <form asp-action="UpdateStatus" method="post" id="formStatus" class="row g-3">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@(origen == "almacen" ? Url.Action("Almacen") : "")" />

                @if (!esRetiroLocal && Model.Status != PedidoStatus.Entregado && Model.Status != PedidoStatus.Cancelado)
                {
                    <div class="col-12 border-bottom pb-3 mb-2">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted">Paquetería</label>
                                <input type="text" name="paqueteria" id="inputPaq" class="form-control rounded-pill" placeholder="Ej. DHL" value="@Model.Paqueteria" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted">Número de Guía</label>
                                <input type="text" name="guia" id="inputGuia" class="form-control rounded-pill" placeholder="Número de rastreo" value="@Model.NumeroGuia" />
                            </div>
                        </div>
                    </div>
                }

                <div class="col-12 d-flex gap-2 flex-wrap justify-content-center">
                    @if (esAdmin || esMostrador)
                    {
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Pagado" class="btn btn-success rounded-pill px-4">Pagado</button>
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.EnProceso" class="btn btn-primary rounded-pill px-4">En Proceso</button>
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Entregado" class="btn btn-dark rounded-pill px-4">Entregado</button>
                    }

                    @if (Model.Status == PedidoStatus.EnProceso || esAdmin)
                    {
                        <button type="button" onclick="validarEnvio()" class="btn btn-info text-white rounded-pill px-4 fw-bold">
                            <i class="bi bi-send-check me-1"></i>
                            @(esRetiroLocal ? "Listo para Entrega" : "Marcar como Enviado")
                        </button>
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Enviado" id="submitEnviado" style="display:none;"></button>
                    }

                    <button type="button" class="btn btn-danger rounded-pill px-4" disabled>Scrap (Próximamente)</button>

                    @if (esAdmin)
                    {
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Cancelado" class="btn btn-outline-danger rounded-pill px-4">Cancelar</button>
                    }
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function validarEnvio() {
            const esRetiro = @esRetiroLocal.ToString().ToLower();
            if (!esRetiro) {
                const paq = document.getElementById("inputPaq").value;
                const guia = document.getElementById("inputGuia").value;
                if (!paq || !guia) {
                    Swal.fire({ icon: 'warning', title: 'Faltan datos', text: 'Por favor ingresa paquetería y número de guía.' });
                    return;
                }
            }
            document.getElementById("submitEnviado").click();
        }
    </script>
}