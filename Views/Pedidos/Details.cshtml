@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    bool esAdmin = User.IsInRole("Admin");
    bool esMostrador = User.IsInRole("Mostrador");
    bool esAlmacen = User.IsInRole("Almacen");
    bool esCliente = User.IsInRole("Cliente");

    ViewData["Title"] = !esCliente ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra";
    bool esRetiroLocal = Model.TipoEntrega == 1;
    var origen = Context.Request.Query["origen"].ToString();
    var accionVolver = (origen == "almacen") ? "Almacen" : "Index";
    int pasoActual = (int)Model.Status;

    bool requiereFactura = !string.IsNullOrEmpty(Model.Rfc) || !string.IsNullOrEmpty(Model.RazonSocial);
}

<style>
    .ticket-header {
        background: #f8f9fa;
        border-radius: 15px 15px 0 0;
        border-bottom: 2px dashed #dee2e6;
    }

    .status-badge {
        font-size: 0.9rem;
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 700;
    }

    /* Stepper Minimalista */
    .stepper-horizontal {
        display: flex;
        justify-content: space-between;
        margin: 20px 0;
        position: relative;
    }

    .step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .step-icon {
        width: 35px;
        height: 35px;
        background: #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 5px;
        color: #adb5bd;
        transition: 0.3s;
        font-size: 0.9rem;
    }

    .step.active .step-icon {
        background: #0d6efd;
        color: white;
        box-shadow: 0 0 0 5px rgba(13,110,253,0.1);
    }

    .step.completed .step-icon {
        background: #198754;
        color: white;
    }

    .step::after {
        content: "";
        position: absolute;
        width: 100%;
        height: 2px;
        background: #e9ecef;
        top: 17px;
        left: 50%;
        z-index: -1;
    }

    .step:last-child::after {
        display: none;
    }

    .step.completed::after {
        background: #198754;
    }

    .step-text {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #adb5bd;
    }

    .step.active .step-text {
        color: #0d6efd;
    }
</style>

<div class="container-fluid py-3">
    @* ENCABEZADO Y VOLVER *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-receipt-cutoff text-primary"></i>
                @(!esCliente ? $"Pedido #{Model.Id}" : "Mi Compra")
            </h2>
            <span class="text-muted small">Folio Interno: @Model.Id</span>
        </div>
        <a asp-action="@accionVolver" class="btn btn-light rounded-pill border fw-bold px-4">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    @* STEPPER VISUAL *@
    @if (Model.Status != PedidoStatus.Cancelado)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body py-3">
                <div class="stepper-horizontal">
                    <div class="step @(pasoActual >= 0 ? "completed" : "") @(pasoActual == 0 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-wallet2"></i></div>
                        <div class="step-text">Pendiente</div>
                    </div>
                    <div class="step @(pasoActual >= 1 ? "completed" : "") @(pasoActual == 1 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-check-lg"></i></div>
                        <div class="step-text">Pagado</div>
                    </div>
                    <div class="step @(pasoActual >= 2 ? "completed" : "") @(pasoActual == 2 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-box-seam"></i></div>
                        <div class="step-text">Surtido</div>
                    </div>
                    <div class="step @(pasoActual >= 3 ? "completed" : "") @(pasoActual == 3 ? "active" : "")">
                        <div class="step-icon"><i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck")"></i></div>
                        <div class="step-text">@(esRetiroLocal ? "Listo" : "En Camino")</div>
                    </div>
                    <div class="step @(pasoActual >= 4 ? "completed" : "") @(pasoActual == 4 ? "active" : "")">
                        <div class="step-icon"><i class="bi bi-house-check"></i></div>
                        <div class="step-text">Entregado</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        @* COLUMNA IZQUIERDA: DETALLES DE PRODUCTOS *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="ticket-header p-4">
                    <div class="row">
                        <div class="col-sm-6">
                            <h6 class="text-muted small fw-bold mb-1">FECHA DE COMPRA</h6>
                            <p class="fw-bold mb-0 text-dark">@Model.FechaPedido.ToString("f")</p>
                        </div>
                        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                            <h6 class="text-muted small fw-bold mb-1">MÉTODO DE ENTREGA</h6>
                            <p class="fw-bold mb-0 text-primary text-uppercase">
                                <i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck")"></i>
                                @(esRetiroLocal ? "Retiro en Sucursal" : "Envío a Domicilio")
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light text-muted small fw-bold">
                                <tr>
                                    <th class="ps-4 border-0 py-3">PRODUCTO / DESCRIPCIÓN</th>
                                    <th class="text-center border-0 py-3">CANT.</th>
                                    <th class="text-end border-0 py-3">UNITARIO</th>
                                    <th class="text-end pe-4 border-0 py-3">SUBTOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Detalles)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@d.Producto?.Nombre</div>
                                            <small class="text-muted">SKU: @d.Producto?.SKU | Marca: @d.Producto?.MarcaPieza</small>
                                        </td>
                                        <td class="text-center fw-bold">@d.Cantidad</td>
                                        <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end pe-4 fw-bold">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light p-4 border-0">
                    <div class="row justify-content-end">
                        <div class="col-md-6 col-lg-5">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal Productos:</span>
                                <span class="fw-bold">$@Model.TotalPedido.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Gastos de Envío:</span>
                                <span class="text-success fw-bold">GRATIS</span>
                            </div>
                            <hr class="my-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="fw-bold text-dark mb-0">TOTAL FINAL:</h4>
                                <h3 class="fw-bold text-success mb-0">$@Model.TotalPedido.ToString("N2")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* COLUMNA DERECHA: CLIENTE Y LOGÍSTICA *@
        <div class="col-lg-4">

            @* DATOS DEL CLIENTE (QUIEN COMPRÓ) *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-dark bg-opacity-10 p-2 rounded-3 me-3 text-dark">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Datos del Cliente</h5>
                    </div>
                    <div class="p-3 bg-light rounded-4 border">
                        <p class="mb-1 small text-muted">CLIENTE REGISTRADO:</p>
                        <p class="mb-0 fw-bold text-dark fs-6">@Model.NombreUsuario</p>
                        <p class="mb-0 small text-muted">@Model.UsuarioId</p>
                    </div>
                </div>
            </div>

            @* DATOS DE ENTREGA (RECEPTOR) *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Destino de Entrega</h5>
                    </div>
                    <div class="mb-3">
                        <p class="mb-1 small text-muted">RECIBE:</p>
                        <p class="mb-1 fw-bold text-dark">@Model.NombreReceptor</p>
                        <p class="text-muted small mb-0"><i class="bi bi-telephone me-1"></i> @Model.TelefonoEnvio</p>
                    </div>
                    <hr>
                    <div class="mb-2">
                        <p class="text-muted small mb-1"><i class="bi bi-map me-1"></i> <strong>Dirección Completa:</strong></p>
                        <p class="small fw-bold mb-0">@Model.DireccionEnvio</p>
                        <p class="small text-muted">@Model.CiudadEnvio, @Model.EstadoEnvio</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.NumeroGuia))
                    {
                        <div class="mt-3 p-3 bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-25 text-center">
                            <small class="d-block text-primary fw-bold mb-1">RASTREO @Model.Paqueteria.ToUpper():</small>
                            <code class="text-primary fw-bold fs-5">@Model.NumeroGuia</code>
                        </div>
                    }
                </div>
            </div>

            @* DATOS FISCALES *@
            @if (requiereFactura)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>
                            <h6 class="fw-bold mb-0">Información Fiscal</h6>
                        </div>
                        <div class="small">
                            <div class="text-muted small mb-1">RAZÓN SOCIAL:</div>
                            <div class="fw-bold mb-2">@Model.RazonSocial</div>
                            <div class="text-muted small mb-1">RFC:</div>
                            <div class="fw-bold">@Model.Rfc</div>
                        </div>
                    </div>
                </div>
            }

            @* ACCIONES ADMINISTRATIVAS *@
            @if (esAdmin || esMostrador || esAlmacen)
            {
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white py-3">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-gear-fill me-2"></i>Gestión de Pedido</h6>
                    </div>
                    <div class="card-body bg-light p-4">
                        <form asp-action="UpdateStatus" method="post" id="formStatus">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@(origen == "almacen" ? Url.Action("Almacen") : "")" />

                            @if (!esRetiroLocal && Model.Status != PedidoStatus.Entregado && Model.Status != PedidoStatus.Cancelado)
                            {
                                <div class="mb-3 p-3 bg-white rounded-3 border shadow-sm">
                                    <label class="small fw-bold text-muted mb-2">DATOS DE LOGÍSTICA</label>
                                    <input type="text" name="paqueteria" id="inputPaq" class="form-control mb-2 rounded-pill" placeholder="Empresa (Ej. DHL)" value="@Model.Paqueteria" />
                                    <input type="text" name="guia" id="inputGuia" class="form-control rounded-pill" placeholder="Número de Guía" value="@Model.NumeroGuia" />
                                </div>
                            }

                            <div class="d-grid gap-2">
                                @if (esAdmin || esMostrador)
                                {
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Pagado" class="btn btn-outline-success btn-sm rounded-pill fw-bold">Validar Pago</button>
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.EnProceso" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">En Surtido</button>
                                }

                                <button type="button" onclick="validarEnvio()" class="btn btn-primary rounded-pill fw-bold shadow py-2">
                                    <i class="bi bi-send-check me-1"></i>
                                    @(esRetiroLocal ? "Listo para Sucursal" : "Marcar como Enviado")
                                </button>
                                <button type="submit" name="nuevoStatus" value="@PedidoStatus.Enviado" id="submitEnviado" style="display:none;"></button>

                                @if (esAdmin)
                                {
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Entregado" class="btn btn-dark btn-sm rounded-pill fw-bold mt-2">Cerrar como Entregado</button>
                                    <hr class="my-3">
                                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Cancelado" class="btn btn-link text-danger btn-sm text-decoration-none fw-bold">Cancelar Pedido</button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            }

            @* CONFIRMACIÓN CLIENTE *@
            @if (esCliente && Model.Status == PedidoStatus.Enviado)
            {
                <div class="card bg-primary text-white border-0 shadow-lg rounded-4 p-4 text-center">
                    <i class="bi bi-patch-question fs-1 mb-2"></i>
                    <h5 class="fw-bold mb-3">¿Ya recibiste tu pedido?</h5>
                    <form asp-action="ConfirmarEntrega" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-light text-primary rounded-pill fw-bold w-100 py-2 shadow">Confirmar Recepción</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validarEnvio() {
            const esRetiro = @esRetiroLocal.ToString().ToLower();
            if (!esRetiro) {
                const paq = document.getElementById("inputPaq").value;
                const guia = document.getElementById("inputGuia").value;
                if (!paq || !guia) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Logística Incompleta',
                        text: 'Necesitas capturar paquetería y número de guía para notificar al cliente.',
                        confirmButtonColor: '#0d6efd'
                    });
                    return;
                }
            }
            document.getElementById("submitEnviado").click();
        }
    </script>
}