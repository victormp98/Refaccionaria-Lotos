@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    bool esAdmin = !User.IsInRole("Cliente");
    ViewData["Title"] = esAdmin ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra";

    // Nueva lógica: usamos el campo TipoEntrega de la base de datos
    bool esRetiroLocal = Model.TipoEntrega == 1;

    // --- LÓGICA DE LA BANDERA ---
    var origen = Context.Request.Query["origen"].ToString();
    var accionVolver = (origen == "almacen") ? "Almacen" : "Index";
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
    <h1 class="mb-0 fs-2 fs-md-1">
        <i class="bi bi-box-seam text-primary"></i>
        @(esAdmin ? $"Detalle Pedido #{Model.Id}" : "Detalle de mi Compra")
    </h1>
    <a asp-action="@accionVolver" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="row g-4">
    @* COLUMNA IZQUIERDA: RESUMEN Y DATOS DE ENVÍO *@
    <div class="col-md-5">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Resumen General</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Fecha:</dt>
                    <dd class="col-sm-7 text-muted">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5">Estado:</dt>
                    <dd class="col-sm-7">
                        @{
                            var color = Model.Status == PedidoStatus.Pagado ? "bg-success" :
                            Model.Status == PedidoStatus.PendienteDePago ? "bg-warning text-dark" :
                            Model.Status == PedidoStatus.EnProceso ? "bg-primary" :
                            Model.Status == PedidoStatus.Cancelado ? "bg-danger" : "bg-info";
                        }
                        <span class="badge @color px-3 py-2 rounded-pill">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-5">Total:</dt>
                    <dd class="col-sm-7 fw-bold text-success fs-5">$@Model.TotalPedido.ToString("N2")</dd>
                </dl>
            </div>
        </div>

        @* SECCIÓN DE DATOS DE ENTREGA *@
        <div class="card shadow-sm border-0 rounded-4 @(esRetiroLocal ? "border-start border-4 border-warning" : "")">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold">
                    <i class="bi @(esRetiroLocal ? "bi-shop" : "bi-truck") me-2 text-primary"></i>
                    @(esRetiroLocal ? "Datos de Retiro en Sucursal" : "Datos de Entrega a Domicilio")
                </h5>
            </div>
            <div class="card-body">
                @if (esRetiroLocal)
                {
                    <div class="alert alert-warning border-0 py-2 small mb-3">
                        <i class="bi bi-info-square-fill me-2"></i> Cliente recogerá personalmente en tienda.
                    </div>
                }

                <p class="mb-1 fw-bold text-dark">@Model.NombreReceptor</p>
                <p class="mb-1 text-muted small"><i class="bi bi-geo-alt me-1"></i> @Model.DireccionEnvio</p>
                <p class="mb-0 text-muted small">
                    @Model.CiudadEnvio, @Model.EstadoEnvio, CP @Model.CodigoPostalEnvio
                </p>

                @if (!string.IsNullOrEmpty(Model.NumeroGuia))
                {
                    <div class="mt-3 p-2 bg-light rounded border">
                        <small class="d-block text-muted fw-bold">INFORMACIÓN DE RASTREO:</small>
                        <span class="d-block"><strong>Paquetería:</strong> @Model.Paqueteria</span>
                        <span class="d-block"><strong>Guía:</strong> @Model.NumeroGuia</span>
                    </div>
                }

                @if (Model.RequiereFactura)
                {
                    <hr />
                    <div class="badge bg-secondary mb-2">Requiere Factura</div>
                    <p class="mb-0 small"><strong>RFC:</strong> @Model.Rfc</p>
                    <p class="mb-0 small"><strong>Razón:</strong> @Model.RazonSocial</p>
                }
            </div>
        </div>
    </div>

    @* COLUMNA DERECHA: PRODUCTOS *@
    <div class="col-md-7">
        <div class="card shadow-sm mb-4 border-0 rounded-4">
            <div class="card-header bg-light border-0 py-3 rounded-top-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-cart me-2 text-primary"></i>Productos Comprados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end pe-4">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@d.Producto?.Nombre</div>
                                        <small class="text-muted">SKU: @d.Producto?.SKU</small>
                                    </td>
                                    <td class="text-center">@d.Cantidad</td>
                                    <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end pe-4 fw-bold">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
{
    <div class="card border-primary mt-4 shadow-sm rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
            <h6 class="mb-0"><i class="bi bi-gear-fill me-2"></i> Panel de Gestión de Orden</h6>
        </div>
        <div class="card-body bg-light rounded-bottom-4">
            <form asp-action="UpdateStatus" method="post" id="formStatus" class="row g-3 justify-content-center">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@(origen == "almacen" ? Url.Action("Details", new { id = Model.Id, origen = "almacen" }) : "")" />

                @* FORMULARIO DE GUÍA: Solo se muestra si es ENVÍO A DOMICILIO y para roles logísticos *@
                @if (Model.TipoEntrega == 0 && Model.Status != PedidoStatus.Entregado && Model.Status != PedidoStatus.Cancelado)
                {
                    <div class="col-md-10 border-bottom pb-3 mb-2">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="small fw-bold">Paquetería</label>
                                <input type="text" name="paqueteria" id="inputPaq" class="form-control form-control-sm" placeholder="Ej. DHL, FedEx..." value="@Model.Paqueteria" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold">Número de Guía</label>
                                <input type="text" name="guia" id="inputGuia" class="form-control form-control-sm" placeholder="Ingrese el código de rastreo" value="@Model.NumeroGuia" />
                            </div>
                        </div>
                    </div>
                }

                <div class="col-12 d-flex gap-2 flex-wrap justify-content-center">
                    @if (!User.IsInRole("Almacen"))
                    {
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Pagado" class="btn btn-success rounded-pill px-4">Pagado</button>
                    }

                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.EnProceso" class="btn btn-primary rounded-pill px-4">En Proceso</button>

                    @* El botón Enviado se valida con JS si es tipo envío *@
                    <button type="submit" name="nuevoStatus" id="btnEnviado" value="@PedidoStatus.Enviado" class="btn btn-info text-white rounded-pill px-4">Enviado</button>

                    <button type="submit" name="nuevoStatus" value="@PedidoStatus.Entregado" class="btn btn-primary rounded-pill px-4">Entregado</button>

                    @if (!User.IsInRole("Almacen"))
                    {
                        <button type="submit" name="nuevoStatus" value="@PedidoStatus.Cancelado" class="btn btn-outline-danger rounded-pill px-4">Cancelar</button>
                    }
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const btnEnviado = document.getElementById("btnEnviado");
            const inputPaq = document.getElementById("inputPaq");
            const inputGuia = document.getElementById("inputGuia");
            const tipoEntrega = @Model.TipoEntrega;

            function validarEnvio() {
                if (btnEnviado && inputPaq && inputGuia && tipoEntrega === 0) {
                    // Si es envío a domicilio, los campos deben tener texto para habilitar "Enviado"
                    const esValido = inputPaq.value.trim() !== "" && inputGuia.value.trim() !== "";
                    btnEnviado.disabled = !esValido;
                    btnEnviado.title = esValido ? "" : "Debe ingresar paquetería y guía para marcar como enviado";
                }
            }

            if (inputPaq) inputPaq.addEventListener("input", validarEnvio);
            if (inputGuia) inputGuia.addEventListener("input", validarEnvio);

            validarEnvio();
        });
    </script>
}