@model RefaccionariaWeb.Models.Pedido
@using RefaccionariaWeb.Models.Enums

@{
    ViewData["Title"] = $"Detalle Pedido #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
    <h1 class="mb-0 fs-2 fs-md-1"><i class="bi bi-box-seam"></i> Detalle Pedido #@Model.Id</h1>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light"><h5 class="mb-0">Resumen</h5></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Fecha:</dt>
            <dd class="col-sm-9">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Estado:</dt>
            <dd class="col-sm-9">
                @{
                    var color = Model.Status == PedidoStatus.Pagado ? "bg-success" :
                    Model.Status == PedidoStatus.PendienteDePago ? "bg-warning text-dark" :
                    Model.Status == PedidoStatus.Cancelado ? "bg-danger" : "bg-info";
                }
                <span class="badge @color">@Model.Status</span>
            </dd>
            <dt class="col-sm-3">Total:</dt>
            <dd class="col-sm-9 fw-bold text-success fs-5">$@Model.TotalPedido.ToString("N2")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light"><h5 class="mb-0">Productos</h5></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th></tr></thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@d.Producto?.Nombre <br /><small class="text-muted">@d.Producto?.SKU</small></td>
                        <td>@d.Cantidad</td>
                        <td>$@d.PrecioUnitario.ToString("N2")</td>
                        <td>$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
{
    <div class="card border-primary mt-4 shadow-sm">
        <div class="card-header bg-primary text-white"><i class="bi bi-gear-fill"></i> Panel de Administración</div>
        <div class="card-body">
            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" name="nuevoStatus" value="@PedidoStatus.Pagado" class="btn btn-success btn-sm">Marcar Pagado</button>
                <button type="submit" name="nuevoStatus" value="@PedidoStatus.Enviado" class="btn btn-info btn-sm text-white">Marcar Enviado</button>
                <button type="submit" name="nuevoStatus" value="@PedidoStatus.Entregado" class="btn btn-primary btn-sm">Entregado</button>
                <button type="submit" name="nuevoStatus" value="@PedidoStatus.Cancelado" class="btn btn-outline-danger btn-sm">Cancelar</button>
            </form>
        </div>
    </div>
}