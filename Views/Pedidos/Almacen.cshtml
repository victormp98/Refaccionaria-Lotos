@model IEnumerable<RefaccionariaWeb.Models.Pedido>
@using RefaccionariaWeb.Models.Enums

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam text-primary me-2"></i>Surtido de Pedidos</h2>
        <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count() Pendientes</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-check2-circle display-1 text-success"></i>
            <p class="fs-4 text-muted mt-3">¡Todo surtido! No hay pendientes.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 rounded-4 h-100 @(item.Status == PedidoStatus.EnProceso ? "border-start border-5 border-warning" : "border-start border-5 border-success")">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-3">
                                <div><h5 class="fw-bold mb-0">#@item.Id</h5><small class="text-muted">@item.NombreReceptor</small></div>
                                <span class="badge @(item.Status == PedidoStatus.EnProceso ? "bg-warning text-dark" : "bg-success") rounded-pill px-2 py-2">@item.Status</span>
                            </div>
                            <div class="bg-light rounded-3 p-3 mb-3" style="max-height: 200px; overflow-y: auto;">
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var det in item.Detalles)
                                    {
                                        <li class="mb-2 border-bottom pb-1">
                                            <div class="d-flex justify-content-between">
                                                <span class="fw-bold text-truncate me-2">@det.Producto?.Nombre</span>
                                                <span class="badge bg-secondary rounded-pill">x @det.Cantidad</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="d-flex justify-content-end">
                                @if (item.Status == PedidoStatus.Pagado)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="w-100">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="nuevoStatus" value="@PedidoStatus.EnProceso" />
                                        @* AQUÍ MARCAMOS EL ORIGEN COMO ALMACEN/SURTIR *@
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = item.Id, origen = "surtir" })" />
                                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Comenzar</button>
                                    </form>
                                }
                                else
                                {
                                    @* AQUÍ ESTÁ EL CAMBIO CLAVE: origen="surtir" *@
                                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-origen="surtir" class="btn btn-warning w-100 rounded-pill fw-bold text-dark">Finalizar</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>