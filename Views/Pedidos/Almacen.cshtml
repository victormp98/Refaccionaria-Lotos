@model IEnumerable<RefaccionariaWeb.Models.Pedido>
@using RefaccionariaWeb.Models.Enums

@{
    ViewData["Title"] = "Panel de Almacén";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-box-seam text-primary"></i> Pedidos por Surtir</h2>
        <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count() Pendientes</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check2-circle display-1 text-muted"></i>
            <p class="fs-4 text-muted mt-3">¡Todo al día! No hay pedidos pendientes.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    @* La tarjeta resalta en amarillo si ya está 'En Proceso' *@
                    <div class="card shadow-sm border-0 rounded-4 @(item.Status == PedidoStatus.EnProceso ? "border-start border-4 border-warning" : "")">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">#@item.Id</h5>
                                    <small class="text-muted">@item.FechaPedido.ToString("HH:mm") - @item.NombreReceptor</small>
                                </div>
                                @{
                                    var colorBadge = item.Status == PedidoStatus.EnProceso ? "bg-primary" : "bg-success";
                                }
                                @* Burbuja estandarizada para que no salte el diseño *@
                                <span class="badge @colorBadge px-3 py-2 rounded-pill" style="height: fit-content; min-width: 100px;">
                                    @item.Status
                                </span>
                            </div>

                            <div class="bg-light rounded-3 p-3 mb-3" style="max-height: 250px; overflow-y: auto;">
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var det in item.Detalles)
                                    {
                                        <li class="mb-3 border-bottom pb-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div style="flex: 1;">
                                                    @* Prioridad al nombre del producto *@
                                                    <div class="fw-bold text-dark" style="font-size: 0.95rem; line-height: 1.2;">
                                                        @det.Producto?.Nombre
                                                    </div>
                                                    @* SKU secundario *@
                                                    <div class="text-muted mt-1" style="font-size: 0.8rem;">
                                                        <i class="bi bi-upc-scan me-1"></i> SKU: @det.Producto?.SKU
                                                    </div>
                                                </div>
                                                <span class="badge bg-secondary rounded-pill ms-2">x @det.Cantidad</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="d-grid gap-2">
                                @if (item.Status == PedidoStatus.Pagado)
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="nuevoStatus" value="@PedidoStatus.EnProceso" />
                                        @* Enviamos returnUrl para que al procesar regrese aquí mismo *@
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Almacen")" />

                                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">
                                            <i class="bi bi-play-fill"></i> Comenzar Surtido
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    @* El botón de detalles ahora nos llevará a una vista que sabe cómo regresar al almacén *@
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning btn-lg w-100 rounded-pill fw-bold text-dark">
                                        <i class="bi bi-box-seam me-1"></i> Ver y Finalizar
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>