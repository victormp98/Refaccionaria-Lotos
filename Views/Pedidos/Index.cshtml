@model IEnumerable<RefaccionariaWeb.Models.Pedido>
@using RefaccionariaWeb.Models.Enums

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<h1 class="mb-4"><i class="bi bi-list-check"></i> @(User.IsInRole("Cliente") ? "Mis Pedidos" : "Panel de Ventas")</h1>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle bg-white">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Fecha</th>
                @if (!User.IsInRole("Cliente"))
                {
                    <th>Cliente</th>
                }
                <th>Estado</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FechaPedido.ToShortDateString()</td>
                    @if (!User.IsInRole("Cliente"))
                    {
                        <td>@item.Cliente?.UserName<br /><small class="text-muted">@item.Cliente?.Email</small></td>
                    }
                    <td>
                        @{
                            var c = item.Status == PedidoStatus.Pagado ? "bg-success" : item.Status == PedidoStatus.PendienteDePago ? "bg-warning text-dark" : "bg-secondary";
                        }
                        <span class="badge @c">@item.Status</span>
                    </td>
                    <td class="fw-bold">$@item.TotalPedido.ToString("N2")</td>
                    <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Ver Detalle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>