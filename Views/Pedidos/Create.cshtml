@model RefaccionariaWeb.Models.DTOs.CheckoutViewModel
@using RefaccionariaWeb.Models.DTOs
@using RefaccionariaWeb.Extensions

@{
    ViewData["Title"] = "Finalizar Compra";
    var carrito = Context.Session.GetObject<List<ItemCarrito>>("Carrito") ?? new List<ItemCarrito>();
    var total = carrito.Sum(x => x.SubTotal);

    // Obtenemos los datos de la sucursal desde la base de datos
    var db = Context.RequestServices.GetService<RefaccionariaWeb.Data.ApplicationDbContext>();
    var tienda = db.SucursalConfigs.FirstOrDefault(x => x.Id == 1);
}

<style>
    .step-card {
        cursor: pointer;
        transition: 0.3s;
        border: 2px solid #eee;
        border-radius: 15px;
    }

        .step-card:hover {
            border-color: #2E86C1;
            background-color: #f8fbff;
        }

    .step-active {
        border-color: #2E86C1 !important;
        background-color: #f8fbff;
        box-shadow: 0 4px 15px rgba(46,134,193,0.1);
    }

    .sticky-summary {
        position: sticky;
        top: 90px;
    }

    @@media (max-width: 767.98px) {
        .btn-confirmar-fix {
            position: fixed;
            bottom: 65px;
            left: 0;
            right: 0;
            z-index: 1020;
            border-radius: 0;
            padding: 12px;
            background-color: white;
            border-top: 1px solid #eee;
            box-shadow: 0 -5px 15px rgba(0,0,0,0.05);
        }

        body {
            padding-bottom: 150px;
        }
    }
</style>

<div class="container py-4">
    <form asp-action="Create" id="checkoutForm">
        <div class="row g-4">
            <div class="col-lg-8">
                <h2 class="fw-bold mb-4">¿Cómo quieres recibir tu compra?</h2>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* Campo oculto para el Tipo de Entrega *@
                <input type="hidden" name="TipoEntrega" id="inputTipoEntrega" value="0" />

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div id="cardDomicilio" class="card h-100 step-card p-3 step-active" onclick="toggleEnvio(true)">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                                    <i class="bi bi-truck text-primary fs-3"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">Envío a domicilio</h6>
                                    <small class="text-muted">Recibe en tu dirección</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="cardSucursal" class="card h-100 step-card p-3" onclick="toggleEnvio(false)">
                            <div class="d-flex align-items-center">
                                <div class="bg-secondary bg-opacity-10 p-3 rounded-circle me-3">
                                    <i class="bi bi-shop text-secondary fs-3"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">Retiro en sucursal</h6>
                                    <small class="text-muted">Recoge hoy mismo</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="sectionDireccion" class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4"><i class="bi bi-geo-alt text-primary"></i> Datos de entrega</h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold">Nombre de quién recibe</label>
                                <input asp-for="NombreReceptor" class="form-control rounded-3" placeholder="Ej. Víctor Pérez" />
                                <span asp-validation-for="NombreReceptor" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-bold">Calle y número</label>
                                <input asp-for="DireccionEnvio" class="form-control rounded-3" />
                                <span asp-validation-for="DireccionEnvio" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Código Postal</label>
                                <input asp-for="CodigoPostalEnvio" class="form-control rounded-3" />
                                <span asp-validation-for="CodigoPostalEnvio" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Ciudad</label>
                                <input asp-for="CiudadEnvio" class="form-control rounded-3" />
                                <span asp-validation-for="CiudadEnvio" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Estado</label>
                                <input asp-for="EstadoEnvio" class="form-control rounded-3" />
                                <span asp-validation-for="EstadoEnvio" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="RequiereFactura" id="chkFactura">
                            <label class="form-check-label fw-bold" for="chkFactura">¿Necesitas factura?</label>
                        </div>
                        <div id="billingInfo" class="mt-3 row g-3" style="display: none;">
                            <div class="col-md-6">
                                <label class="form-label small">RFC</label>
                                <input asp-for="Rfc" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Razón Social</label>
                                <input asp-for="RazonSocial" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
                <button type="submit" id="btnSubmitHidden" style="display:none;"></button>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm rounded-4 border-0 sticky-summary">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Resumen de compra</h5>
                        <div class="mb-3" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var item in carrito)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <img src="@item.ImagenUrl" width="45" height="45" class="rounded border me-2" style="object-fit: contain;">
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="small fw-bold text-truncate">@item.Nombre</div>
                                        <small class="text-muted">Cant: @item.Cantidad</small>
                                    </div>
                                    <div class="small fw-bold ms-2">$@item.SubTotal.ToString("N2")</div>
                                </div>
                            }
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-2"><span>Productos</span><span>$@total.ToString("N2")</span></div>
                        <div class="d-flex justify-content-between mb-2 text-success"><span>Envío</span><span id="txtEnvio">Gratis</span></div>
                        <div class="d-flex justify-content-between h4 fw-bold text-primary my-3"><span>Total</span><span>$@total.ToString("N2")</span></div>

                        <div class="btn-confirmar-fix">
                            <!-- CAMBIO: Ahora es type="submit" directamente -->
                            <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill py-3 fw-bold shadow">
                                Confirmar y Pagar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const datosTienda = {
            nombre: "@tienda?.NombreTienda",
            direccion: "@tienda?.Direccion",
            cp: "@tienda?.CP",
            ciudad: "@tienda?.Ciudad",
            estado: "@tienda?.Estado"
        };

        function toggleEnvio(esEnvio) {
            const section = document.getElementById('sectionDireccion');
            const txtEnvio = document.getElementById('txtEnvio');

            const inputNombre = document.querySelector('[name="NombreReceptor"]');
            const inputDireccion = document.querySelector('[name="DireccionEnvio"]');
            const inputCP = document.querySelector('[name="CodigoPostalEnvio"]');
            const inputCiudad = document.querySelector('[name="CiudadEnvio"]');
            const inputEstado = document.querySelector('[name="EstadoEnvio"]');

            document.getElementById('cardDomicilio').classList.toggle('step-active', esEnvio);
            document.getElementById('cardSucursal').classList.toggle('step-active', !esEnvio);

            // ACTUALIZAMOS EL INPUT OCULTO
            document.getElementById('inputTipoEntrega').value = esEnvio ? "0" : "1";

            if (esEnvio) {
                $(section).slideDown();
                txtEnvio.innerText = "Gratis";
                txtEnvio.className = "text-success";

                inputNombre.value = "";
                inputDireccion.value = "";
                inputCP.value = "";
                inputCiudad.value = "";
                inputEstado.value = "";
            } else {
                $(section).slideUp();
                txtEnvio.innerText = "N/A (Retiro)";
                txtEnvio.className = "text-muted";

                inputNombre.value = "RETIRO: " + datosTienda.nombre;
                inputDireccion.value = datosTienda.direccion;
                inputCP.value = datosTienda.cp;
                inputCiudad.value = datosTienda.ciudad;
                inputEstado.value = datosTienda.estado;
            }
        }

        document.getElementById('chkFactura').addEventListener('change', function() {
            $('#billingInfo').slideToggle(this.checked);
        });
    </script>
}