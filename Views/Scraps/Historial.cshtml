@model IEnumerable<RefaccionariaWeb.Models.Scrap>

@{
    ViewData["Title"] = "Historial de Bajas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-danger me-2"></i>Historial de Scrap</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
            <i class="bi bi-arrow-left"></i> Volver al Panel
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-info-circle display-1 text-muted"></i>
            <p class="fs-5 text-muted mt-3">No hay registros de scrap en la base de datos.</p>
        </div>
    }
    else
    {
        @* TABLA PARA PC *@
        <div class="table-responsive d-none d-md-block shadow-sm rounded-4 overflow-hidden border mb-4">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Motivo</th>
                        <th class="text-end pe-4">Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 small">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-bold">@item.Producto?.Nombre</div>
                                <small class="text-muted">SKU: @item.Producto?.SKU</small>
                            </td>
                            <td><span class="badge bg-danger rounded-pill px-3">-@item.Cantidad</span></td>
                            <td class="small italic text-muted">"@item.Motivo"</td>
                            <td class="text-end pe-4 small">@item.NombreUsuario</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* TARJETAS PARA MÓVIL *@
        <div class="row g-3 d-md-none">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4 h-100 border-start border-5 border-danger">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="overflow-hidden">
                                    <h5 class="fw-bold text-dark mb-0 text-truncate">@item.Producto?.Nombre</h5>
                                    <small class="text-muted">SKU: @item.Producto?.SKU</small>
                                </div>
                                <div class="text-end ms-2">
                                    <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">-@item.Cantidad</span>
                                </div>
                            </div>

                            <div class="bg-light p-3 rounded-3 my-3 border">
                                <small class="d-block text-danger fw-bold mb-1" style="font-size:0.7rem">MOTIVO REPORTADO:</small>
                                <p class="mb-0 text-dark small" style="font-style: italic;">"@item.Motivo"</p>
                            </div>

                            <div class="d-flex justify-content-end align-items-center mt-3 pt-2 border-top gap-3">
                                <div class="small text-muted">
                                    <i class="bi bi-person-badge me-1"></i> @item.NombreUsuario
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-calendar3 me-1"></i> @item.FechaRegistro.ToString("dd/MM/yy")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .italic {
        font-style: italic;
    }
</style>