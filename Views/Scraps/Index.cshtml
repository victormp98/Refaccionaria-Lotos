@model IEnumerable<RefaccionariaWeb.Models.Producto>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-danger"><i class="bi bi-search text-dark me-2"></i>Seleccionar para Scrap</h2>
        <a asp-action="Historial" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-clock-history me-1"></i> Ver Historial
        </a>
    </div>

    @* BUSCADOR *@
    <div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="txtBuscador" class="form-control border-0 fs-6 py-3" placeholder="Buscar producto...">
            </div>
        </div>
    </div>

    <div class="row g-3" id="contenedorTarjetas">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 tarjeta-producto" data-search="@item.Nombre.ToLower() @item.SKU.ToLower()">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark">@item.Nombre</h6>
                        <small class="text-muted d-block mb-3">SKU: @item.SKU</small>
                        <div class="p-2 bg-light rounded-3 d-flex justify-content-between mb-3">
                            <span class="small fw-bold">Stock:</span>
                            <span class="badge bg-success rounded-pill">@item.Stock pzas</span>
                        </div>
                        <button type="button" class="btn btn-danger w-100 rounded-pill fw-bold" onclick="prepararScrap(@item.Id, '@item.Nombre', @item.Stock)">
                            Reportar Scrap
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* MODAL *@
<div class="modal fade" id="modalConfirmarScrap" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <form asp-action="Reportar" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="productoId" id="scrapProductoId" />
                    <h5 class="fw-bold text-center" id="scrapNombreDisplay"></h5>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Cantidad</label>
                        <input type="number" name="cantidad" id="scrapCantidad" class="form-control rounded-pill" min="1" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Motivo</label>
                        <textarea name="motivo" class="form-control rounded-4" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('txtBuscador').addEventListener('input', function(e) {
            let valor = e.target.value.toLowerCase();
            document.querySelectorAll('.tarjeta-producto').forEach(t => {
                t.style.display = t.getAttribute('data-search').includes(valor) ? "block" : "none";
            });
        });
        function prepararScrap(id, nombre, stock) {
            document.getElementById('scrapProductoId').value = id;
            document.getElementById('scrapNombreDisplay').innerText = nombre;
            document.getElementById('scrapCantidad').max = stock;
            new bootstrap.Modal(document.getElementById('modalConfirmarScrap')).show();
        }
    </script>
}