@model IEnumerable<RefaccionariaWeb.Models.Scrap>

@{
    ViewData["Title"] = "Panel de Scrap";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-trash3 text-danger me-2"></i>Panel de Scrap</h2>
        <a asp-action="Historial" class="btn btn-outline-primary rounded-pill shadow-sm">
            <i class="bi bi-clock-history me-1"></i> Ver Historial
        </a>
    </div>

    <div class="mb-4">
        <div class="input-group rounded-pill border bg-white overflow-hidden shadow-sm">
            <span class="input-group-text border-0 bg-transparent ps-3">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" id="scrapSearch" class="form-control border-0 bg-transparent py-2" placeholder="Filtrar por nombre de producto o motivo...">
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="scrapCardsContainer">
        @foreach (var item in Model)
        {
            <div class="col scrap-card-item">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden border-start border-danger border-4">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0 me-3">
                                @if (item.Producto != null && !string.IsNullOrEmpty(item.Producto.ImagenUrl))
                                {
                                    <img src="@item.Producto.ImagenUrl" class="rounded-3 object-fit-cover shadow-sm" style="width: 60px; height: 60px;" alt="@item.Producto.Nombre">
                                }
                                else
                                {
                                    <div class="bg-light rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px;">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                }
                            </div>

                            <div class="flex-grow-1 min-width-0">
                                <h6 class="fw-bold text-dark mb-0 text-truncate">@(item.Producto?.Nombre ?? "Producto no encontrado")</h6>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">ID Producto: @item.ProductoId</small>
                            </div>
                        </div>

                        <div class="bg-light rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">Cantidad:</span>
                                <span class="badge bg-danger rounded-pill">@item.Cantidad pza(s)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Fecha:</span>
                                <span class="small fw-bold">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Motivo del Daño:</label>
                            <p class="small text-dark mb-0 border-start border-2 border-secondary ps-2 mt-1 fst-italic">
                                "@item.Motivo"
                            </p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                        <div class="d-flex align-items-center text-muted border-top pt-2" style="font-size: 0.8rem;">
                            <i class="bi bi-person-circle me-1 text-primary"></i>
                            <span>Registrado por: <strong>@item.NombreUsuario</strong></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check2-circle text-success" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">No hay registros de scrap pendientes</h4>
            <p>Todo el inventario parece estar en buen estado.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#scrapSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#scrapCardsContainer .scrap-card-item").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}

<style>
    .scrap-card-item {
        transition: transform 0.2s;
    }

        .scrap-card-item:hover {
            transform: translateY(-5px);
        }
</style>