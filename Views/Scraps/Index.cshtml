@model IEnumerable<RefaccionariaWeb.Models.Producto>

@{
    ViewData["Title"] = "Panel de Scrap";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-trash3 text-danger me-2"></i>Panel de Scrap</h2>
        <a asp-action="Historial" class="btn btn-outline-primary rounded-pill shadow-sm fw-bold">
            <i class="bi bi-clock-history me-1"></i> Ver Historial
        </a>
    </div>

    @* Buscador en tiempo real *@
    <div class="mb-4">
        <div class="input-group rounded-pill border bg-white overflow-hidden shadow-sm">
            <span class="input-group-text border-0 bg-transparent ps-3">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" id="scrapSearch" class="form-control border-0 bg-transparent py-2" placeholder="Filtrar por nombre de producto o marca...">
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="scrapCardsContainer">
        @foreach (var item in Model)
        {
            <div class="col scrap-card-item">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden border-start border-danger border-5">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0 me-3">
                                @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl" class="rounded-3 object-fit-cover shadow-sm" style="width: 60px; height: 60px;" alt="@item.Nombre">
                                }
                                else
                                {
                                    <div class="bg-light rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px;">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                }
                            </div>

                            <div class="flex-grow-1 min-width-0">
                                <h6 class="fw-bold text-dark mb-0 text-truncate">@item.Nombre</h6>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">@item.MarcaPieza</small>
                            </div>
                        </div>

                        <div class="bg-light rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">Stock Actual:</span>
                                <span class="badge bg-dark rounded-pill">@item.Stock pza(s)</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end pt-2 border-top">
                            <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalScrap-@item.Id">
                                <i class="bi bi-megaphone me-1"></i> Reportar Daño
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* MODAL PARA CADA PRODUCTO *@
            <div class="modal fade" id="modalScrap-@item.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow rounded-4">
                        <form asp-action="Reportar" method="post">
                            <div class="modal-header border-0 bg-danger text-white p-4">
                                <h5 class="modal-title fw-bold">Reportar Scrap: @item.Nombre</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                                <input type="hidden" name="productoId" value="@item.Id" />
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Cantidad de piezas dañadas</label>
                                    <input type="number" name="cantidad" class="form-control rounded-pill border-2" min="1" max="@item.Stock" required />
                                    <small class="text-muted ms-2">Máximo disponible: @item.Stock</small>
                                </div>
                                <div class="mb-0">
                                    <label class="form-label fw-bold">Motivo del daño</label>
                                    <textarea name="motivo" class="form-control rounded-4 border-2" rows="3" placeholder="Ej: Empaque roto, rayadura..." required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer border-0 p-4 pt-0">
                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow">Confirmar Baja</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#scrapSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#scrapCardsContainer .scrap-card-item").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}

<style>
    .scrap-card-item {
        transition: transform 0.2s;
    }

        .scrap-card-item:hover {
            transform: translateY(-5px);
        }
</style>