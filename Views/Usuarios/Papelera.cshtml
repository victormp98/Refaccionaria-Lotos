@model IEnumerable<RefaccionariaWeb.Models.ViewModels.EditarUsuarioViewModel>

@{
    ViewData["Title"] = "Usuarios Bloqueados";
    string tipoActual = ViewData["TipoActual"]?.ToString();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-2">
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-trash-fill text-danger"></i> Bloqueados
        </h2>
        @* BOTÓN VOLVER CON HILO DE NAVEGACIÓN *@
        <a asp-action="Index" asp-route-tipo="@tipoActual" class="btn btn-outline-primary rounded-pill px-3 fw-bold">
            <i class="bi bi-arrow-left"></i> Volver al Equipo
        </a>
    </div>

    @* VISTA PARA PC *@
    <div class="table-responsive d-none d-md-block shadow-sm rounded-4 overflow-hidden border mb-5">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Usuario / Email</th>
                    <th class="text-center">Rol que tenía</th>
                    <th class="text-end pe-5">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-muted">
                            <div>@item.Email</div>
                            <small class="text-muted fw-normal">ID: @item.Id.Substring(0, 8)...</small>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary rounded-pill px-3">@item.RolSeleccionado</span>
                        </td>
                        <td class="text-end pe-5">
                            <a asp-action="Desbloquear" asp-route-id="@item.Id" asp-route-tipo="@tipoActual" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm">
                                <i class="bi bi-unlock-fill"></i> Restaurar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* VISTA PARA MÓVIL (TARJETAS) *@
    <div class="d-block d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 border-start border-danger border-5">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="overflow-hidden">
                            <h6 class="mb-0 text-truncate fw-bold text-muted">@item.Email</h6>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 mt-1 rounded-pill">
                                @item.RolSeleccionado
                            </span>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-2 rounded-circle">
                            <i class="bi bi-person-x-fill text-danger"></i>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end pt-2 border-top">
                        <a asp-action="Desbloquear" asp-route-id="@item.Id" asp-route-tipo="@tipoActual" class="btn btn-success rounded-pill px-4 btn-sm fw-bold shadow-sm">
                            <i class="bi bi-unlock-fill"></i> Restaurar Acceso
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>