@model IEnumerable<RefaccionariaWeb.Models.CorteCaja>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reporte General</title>
    <style>
        /* ESTILO TIPO TICKET TÉRMICO */
        body {
            font-family: 'Courier New', Courier, monospace; /* Fuente monoespaciada para alinear */
            font-size: 12px;
            margin: 0;
            padding: 10px;
            background: #fff;
            color: #000;
        }

        .ticket-container {
            max-width: 300px; /* Ancho estándar impresora térmica 80mm */
            margin: 0 auto;
        }

        .header {
            text-align: center;
            margin-bottom: 10px;
        }

        .title {
            font-weight: bold;
            font-size: 14px;
        }

        .subtitle {
            font-size: 11px;
        }

        .divider {
            border-bottom: 1px dashed #000;
            margin: 5px 0;
        }

        .double-divider {
            border-bottom: 3px double #000;
            margin: 5px 0;
        }

        .row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }

        .col-left {
            text-align: left;
        }

        .col-right {
            text-align: right;
            font-weight: bold;
        }

        .corte-item {
            margin-bottom: 10px;
            padding-bottom: 5px;
        }

        .totals-section {
            margin-top: 20px;
            font-size: 13px;
        }

        /* --- BOTONES DE PANTALLA --- */
        .no-print {
            text-align: center;
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
            gap: 10px; /* Espacio entre botones */
        }

        .btn-base {
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            font-family: sans-serif; /* Fuente legible para botones */
        }

        .btn-print {
            background: #333;
            color: white;
            border: none;
        }

        .btn-close {
            background: white;
            color: #333;
            border: 1px solid #333;
        }

        .btn-print:hover {
            background: #000;
        }

        .btn-close:hover {
            background: #f0f0f0;
        }

        @@media print {
            .no-print {
                display: none;
            }

            .ticket-container {
                max-width: 100%;
                width: 100%;
            }

            body {
                padding: 0;
                margin: 0;
            }
        }
    </style>
</head>
<body>

    @* BOTONERA SUPERIOR *@
    <div class="no-print">
        <button onclick="window.print()" class="btn-base btn-print">🖨️ IMPRIMIR REPORTE</button>
        <button onclick="window.close()" class="btn-base btn-close">CERRAR</button>
    </div>

    <div class="ticket-container">
        <div class="header">
            <div class="title">REFACCIONARIA UT</div>
            <div class="subtitle">REPORTE HISTÓRICO DE CORTES</div>
            <div class="subtitle">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="double-divider"></div>

        @foreach (var item in Model)
        {
            bool abierta = item.FechaCierre == null;

            <div class="corte-item">
                <div class="row">
                    <span class="col-left">FOLIO: #@item.Id</span>
                    <span class="col-right">@item.Usuario?.UserName</span>
                </div>
                <div class="row">
                    <span class="col-left">@item.FechaApertura.ToString("dd/MM HH:mm")</span>
                    <span class="col-right">@(abierta ? "ABIERTA" : "CERRADA")</span>
                </div>

                <div class="divider"></div>

                <div class="row">
                    <span>Fondo Inicial:</span>
                    <span>$@item.MontoInicial.ToString("N0")</span>
                </div>
                <div class="row">
                    <span>(+) Vta. Efectivo:</span>
                    <span>$@item.TotalVentasEfectivo.ToString("N2")</span>
                </div>
                <div class="row">
                    <span>(+) Vta. Tarjeta:</span>
                    <span>$@item.TotalVentasTarjeta.ToString("N2")</span>
                </div>
                <div class="row" style="font-weight:bold;">
                    <span>(=) TOT. CAJÓN:</span>
                    <span>$@((item.MontoInicial + item.TotalVentasEfectivo).ToString("N2"))</span>
                </div>

                @if (!abierta)
                {
                    <div class="row">
                        <span>Declarado:</span>
                        <span>$@item.MontoDeclarado.ToString("N2")</span>
                    </div>
                    @if (item.Diferencia != 0)
                    {
                        <div class="row">
                            <span>DIFERENCIA:</span>
                            <span style="@(item.Diferencia < 0 ? "text-decoration:underline;" : "")">$@item.Diferencia.ToString("N2")</span>
                        </div>
                    }
                }
            </div>
            <div class="divider"></div>
        }

        <div class="totals-section">
            <div class="double-divider"></div>
            <div class="header" style="font-weight:bold; margin-top:5px;">RESUMEN DEL PERIODO</div>

            <div class="row">
                <span>TOTAL VTA. EFECTIVO:</span>
                <span>$@Model.Sum(x => x.TotalVentasEfectivo).ToString("N2")</span>
            </div>
            <div class="row">
                <span>TOTAL VTA. TARJETA:</span>
                <span>$@Model.Sum(x => x.TotalVentasTarjeta).ToString("N2")</span>
            </div>

            <div class="double-divider"></div>
            <div class="row" style="font-size:14px;">
                <span>GRAN TOTAL:</span>
                <span>$@Model.Sum(x => x.TotalVentasEfectivo + x.TotalVentasTarjeta).ToString("N2")</span>
            </div>
        </div>

        <br><br>
        <div style="text-align:center; border-top:1px solid #000; padding-top:5px; margin-top:20px; width:80%; margin-left:auto; margin-right:auto;">
            FIRMA SUPERVISOR
        </div>
        <br>
        <div style="text-align:center;">.</div>
    </div>

</body>
</html>