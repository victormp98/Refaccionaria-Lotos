@model RefaccionariaWeb.Models.CorteCaja
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte #@Model.Id</title>
    <style>
        /* ESTILO TICKET TÉRMICO (Igual que el General) */
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            margin: 0;
            padding: 10px;
            background: #eee; /* Gris en pantalla para diferenciar el papel */
            color: #000;
        }

        .ticket-wrapper {
            background: white;
            max-width: 300px; /* Ancho impresora 80mm */
            margin: 0 auto;
            padding: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .header {
            text-align: center;
            margin-bottom: 10px;
        }

        .title {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .subtitle {
            font-size: 12px;
            text-transform: uppercase;
        }

        .divider {
            border-bottom: 1px dashed #000;
            margin: 8px 0;
        }

        .double-divider {
            border-bottom: 3px double #000;
            margin: 10px 0;
        }

        .row-data {
            display: flex;
            justify-content: space-between;
            margin-bottom: 4px;
        }

        .col-label {
            text-align: left;
        }

        .col-val {
            text-align: right;
            font-weight: bold;
        }

        .section-title {
            font-weight: bold;
            text-align: center;
            margin: 10px 0 5px 0;
            font-size: 13px;
            text-decoration: underline;
        }

        .signature-box {
            margin-top: 40px;
            border-top: 1px solid #000;
            text-align: center;
            padding-top: 5px;
            font-size: 11px;
        }

        /* BOTONES PANTALLA */
        .no-print {
            text-align: center;
            margin-bottom: 20px;
        }

        .btn-print {
            background: #222;
            color: white;
            border: none;
            padding: 10px 20px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn-close {
            background: transparent;
            border: 1px solid #555;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-left: 10px;
        }

        /* REGLAS DE IMPRESIÓN */
        @@media print {
            body {
                background: white;
                padding: 0;
                margin: 0;
            }

            .ticket-wrapper {
                box-shadow: none;
                max-width: 100%;
                width: 100%;
                padding: 0;
                margin: 0;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="no-print">
        <button onclick="window.print()" class="btn-print">🖨️ IMPRIMIR</button>
        <button onclick="window.close()" class="btn-close">Cerrar</button>
    </div>

    <div class="ticket-wrapper">
        @* ENCABEZADO *@
        <div class="header">
            <div class="title">REFACCIONARIA UT</div>
            <div class="subtitle">COMPROBANTE DE CORTE</div>
            <div style="font-size: 11px; margin-top:5px;">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="double-divider"></div>

        @* DATOS GENERALES *@
        <div class="row-data">
            <span class="col-label">FOLIO:</span>
            <span class="col-val">#@Model.Id</span>
        </div>
        <div class="row-data">
            <span class="col-label">CAJERO:</span>
            <span class="col-val">@Model.Usuario?.UserName</span>
        </div>
        <div class="row-data">
            <span class="col-label">APERTURA:</span>
            <span class="col-val">@Model.FechaApertura.ToString("dd/MM HH:mm")</span>
        </div>
        <div class="row-data">
            <span class="col-label">CIERRE:</span>
            <span class="col-val">@(Model.FechaCierre?.ToString("dd/MM HH:mm") ?? "---")</span>
        </div>

        <div class="divider"></div>

        @* DINERO *@
        <div class="section-title">DETALLE DE EFECTIVO</div>

        <div class="row-data">
            <span class="col-label">FONDO INICIAL:</span>
            <span class="col-val">$@Model.MontoInicial.ToString("N2")</span>
        </div>
        <div class="row-data">
            <span class="col-label">(+) VENTAS EFECTIVO:</span>
            <span class="col-val">$@Model.TotalVentasEfectivo.ToString("N2")</span>
        </div>

        <div class="divider"></div>

        <div class="row-data" style="font-size: 14px;">
            <span class="col-label">(=) TOTAL CAJÓN:</span>
            <span class="col-val">$@((Model.MontoInicial + Model.TotalVentasEfectivo).ToString("N2"))</span>
        </div>

        <div class="divider"></div>

        <div class="row-data">
            <span class="col-label">(-) ENTREGADO:</span>
            <span class="col-val">$@Model.MontoDeclarado.ToString("N2")</span>
        </div>

        <div class="double-divider"></div>

        @* RESULTADO FINAL *@
        @if (Model.Diferencia == 0)
        {
            <div style="text-align: center; font-weight: bold; font-size: 14px;">
                *** CUADRE PERFECTO ***
            </div>
        }
        else
        {
            <div class="row-data" style="font-size: 14px;">
                <span class="col-label">DIFERENCIA:</span>
                <span class="col-val">
                    @if (Model.Diferencia > 0)
                    {
                        <span>SOBRA: </span>
                    }
                    else
                    {

                        <span>FALTA: </span>
                    }
                    $@Math.Abs(Model.Diferencia).ToString("N2")
                </span>
            </div>
        }

        <br>
        @* INFO EXTRA *@
        <div class="row-data" style="font-size: 11px;">
            <span class="col-label">VTA TARJETA (BANCO):</span>
            <span class="col-val">$@Model.TotalVentasTarjeta.ToString("N2")</span>
        </div>

        <br><br>

        @* FIRMAS *@
        <div class="signature-box">
            FIRMA CAJERO RESPONSABLE
        </div>

        <div class="signature-box">
            FIRMA SUPERVISOR / ADMIN
        </div>

        <br>
        <div style="text-align: center;">.</div>
    </div>

</body>
</html>