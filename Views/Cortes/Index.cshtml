@model IEnumerable<RefaccionariaWeb.Models.CorteCaja>

@{
    ViewData["Title"] = "Historial de Cortes";
}

<style>
    /* ESTILOS PANTALLA */
    .card-dashboard {
        border: none;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .table-header {
        background-color: #f8f9fa;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        font-weight: 700;
        color: #6c757d;
    }

    /* ESTILOS MÓVIL */
    .mobile-card {
        background: white;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-left: 5px solid #ccc;
        position: relative;
    }

        .mobile-card.status-ok {
            border-left-color: #198754;
        }

        .mobile-card.status-warn {
            border-left-color: #ffc107;
        }

        .mobile-card.status-danger {
            border-left-color: #dc3545;
        }

        .mobile-card.status-open {
            border-left-color: #0d6efd;
        }

    .mc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 0.9rem;
    }

    .mc-label {
        color: #6c757d;
        font-size: 0.8rem;
    }

    .mc-val {
        font-weight: 600;
        color: #333;
    }

    /* Botón flotante móvil */
    .btn-print-mob {
        position: absolute;
        top: 15px;
        right: 15px;
    }

    /* Control de Vistas */
    @@media (max-width: 768px) {
        .desktop-view {
            display: none;
        }

        .mobile-view {
            display: block;
        }
    }

    @@media (min-width: 769px) {
        .desktop-view {
            display: block;
        }

        .mobile-view {
            display: none;
        }
    }
</style>

<div class="container-fluid p-3 p-lg-4">

    @* ENCABEZADO *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
           
            <h4 class="fw-bold mb-0"><i class="bi bi-safe2 me-2"></i>Cortes de Caja</h4>
            <span class="text-muted small">Historial y Auditoría de efectivo</span>
        </div>

        @* CORRECCIÓN: Ahora abre la nueva vista limpia *@
        <a asp-action="ReporteGeneral" target="_blank" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-file-text me-1"></i> Imprimir Lista
        </a>
    </div>

    @* --- VISTA ESCRITORIO --- *@
    <div class="desktop-view">
        <div class="card card-dashboard">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-header">
                        <tr>
                            <th class="py-3 ps-4">Folio / Cajero</th>
                            <th class="text-end">Fondo</th>
                            <th class="text-end">Ventas (Efec)</th>
                            <th class="text-end">Ventas (Tarj)</th>
                            <th class="text-end bg-light border-start border-end text-dark">Total Cajón</th>
                            <th class="text-end text-primary">Declarado</th>
                            <th class="text-center">Diferencia</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool abierta = item.FechaCierre == null;
                            string colorDif = item.Diferencia < 0 ? "text-danger" : "text-success";
                            string badgeHtml = "";

                            if (abierta) { badgeHtml = "<span class='badge bg-primary rounded-pill'>ABIERTA</span>"; }
                            else if (item.Diferencia < -5) { badgeHtml = "<span class='badge bg-danger rounded-pill'>FALTANTE</span>"; }
                            else if (item.Diferencia > 5) { badgeHtml = "<span class='badge bg-warning text-dark rounded-pill'>SOBRANTE</span>"; }
                            else { badgeHtml = "<span class='badge bg-success rounded-pill'>OK</span>"; }

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">#@item.Id - @(item.Usuario?.UserName ?? "Usuario")</div>
                                    <div class="small text-muted">@item.FechaApertura.ToString("dd/MMM HH:mm")</div>
                                </td>
                                <td class="text-end text-secondary">$@item.MontoInicial.ToString("N0")</td>
                                <td class="text-end fw-bold">$@item.TotalVentasEfectivo.ToString("N2")</td>
                                <td class="text-end text-muted">$@item.TotalVentasTarjeta.ToString("N2")</td>
                                <td class="text-end fw-bold bg-light border-start border-end fs-6">
                                    $@((item.MontoInicial + item.TotalVentasEfectivo).ToString("N2"))
                                </td>
                                <td class="text-end fw-bold text-primary fs-6">
                                    @(abierta ? "---" : "$" + item.MontoDeclarado.ToString("N2"))
                                </td>
                                <td class="text-center fw-bold @colorDif">
                                    @(abierta ? "..." : "$" + item.Diferencia.ToString("N2"))
                                </td>
                                <td class="text-center">@Html.Raw(badgeHtml)</td>
                                <td class="text-center">
                                    @if (!abierta)
                                    {
                                        <a asp-action="Imprimir" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="Imprimir Ticket">
                                            <i class="bi bi-printer-fill"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* --- VISTA MÓVIL --- *@
    <div class="mobile-view">
        @foreach (var item in Model)
        {
            bool abierta = item.FechaCierre == null;
            string statusClass = "status-ok";
            if (abierta) { statusClass = "status-open"; }
            else if (item.Diferencia < -5) { statusClass = "status-danger"; }
            else if (item.Diferencia > 5) { statusClass = "status-warn"; }

            <div class="mobile-card @statusClass">
                @if (!abierta)
                {
                    <a asp-action="Imprimir" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-light border shadow-sm btn-print-mob text-primary">
                        <i class="bi bi-printer-fill"></i>
                    </a>
                }

                <div class="mb-2 pb-2 border-bottom pe-5">
                    <div class="fw-bold text-dark">#@item.Id - @(item.Usuario?.UserName ?? "Cajero")</div>
                    <div class="small text-muted">@item.FechaApertura.ToString("dd MMM - HH:mm")</div>
                </div>

                <div class="mc-row"><span class="mc-label">Fondo:</span><span class="mc-val text-muted">$@item.MontoInicial.ToString("N0")</span></div>
                <div class="mc-row"><span class="mc-label">Venta Efec:</span><span class="mc-val text-success">+$@item.TotalVentasEfectivo.ToString("N2")</span></div>
                <div class="mc-row"><span class="mc-label">Venta Tarj:</span><span class="mc-val text-primary">+$@item.TotalVentasTarjeta.ToString("N2")</span></div>

                <hr class="my-1 border-secondary opacity-25">

                <div class="mc-row align-items-center">
                    <span class="mc-label fw-bold text-dark">TOTAL CAJÓN:</span>
                    <span class="mc-val fs-6">$@((item.MontoInicial + item.TotalVentasEfectivo).ToString("N2"))</span>
                </div>
                <div class="mc-row align-items-center">
                    <span class="mc-label text-primary">Declarado:</span>
                    <span class="mc-val text-primary">@(abierta ? "---" : "$" + item.MontoDeclarado.ToString("N2"))</span>
                </div>

                @if (!abierta && Math.Abs(item.Diferencia) > 0.5m)
                {
                    <div class="mt-2 text-center p-1 rounded bg-light fw-bold @(item.Diferencia < 0 ? "text-danger" : "text-success")">
                        DIFERENCIA: $@item.Diferencia.ToString("N2")
                    </div>
                }
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">No hay cortes registrados.</div>
        }
    </div>
</div>