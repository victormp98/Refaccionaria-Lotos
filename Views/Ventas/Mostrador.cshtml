@{
    ViewData["Title"] = "Terminal Punto de Venta";
}

<style>
    /* --- ESTRUCTURA GENERAL (GRID) --- */
    :root {
        --pos-bg: #e2e8f0;
        --pos-sidebar: #ffffff;
        --pos-footer: #1e293b; /* Barra negra abajo */
        --pos-accent: #3b82f6;
    }

    body {
        background-color: var(--pos-bg);
        overflow: hidden; /* Sin scroll en la ventana principal */
    }

    .pos-layout {
        display: grid;
        grid-template-rows: 1fr 90px; /* El contenido ocupa todo, menos 90px para la barra de abajo */
        height: calc(100vh - 70px); /* Ajuste por el navbar superior de tu layout base */
        width: 100%;
    }

    /* --- ZONA SUPERIOR (CONTENIDO) --- */
    .pos-workspace {
        display: grid;
        grid-template-columns: 65% 35%; /* 65% Catálogo, 35% Ticket */
        overflow: hidden;
    }

    /* IZQUIERDA: CATÁLOGO */
    .catalog-area {
        padding: 20px;
        display: flex;
        flex-direction: column;
        overflow-y: hidden;
    }

    .search-header {
        margin-bottom: 15px;
    }

    .product-list-container {
        flex-grow: 1;
        overflow-y: auto;
        padding-right: 5px;
        /* Scrollbar discreto */
        scrollbar-width: thin;
    }

    /* Tarjeta de Producto (Estilo Renglón Tecnológico) */
    .prod-card {
        background: white;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        border-left: 5px solid transparent;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        cursor: pointer;
        transition: 0.1s;
    }

        .prod-card:active {
            transform: scale(0.98);
        }

        .prod-card:hover {
            border-left-color: var(--pos-accent);
            background: #f8fafc;
        }

    .pc-img {
        width: 50px;
        height: 50px;
        border-radius: 5px;
        object-fit: cover;
        background: #eee;
        margin-right: 15px;
    }

    .pc-info {
        flex-grow: 1;
    }

    .pc-title {
        font-weight: 700;
        color: #334155;
        font-size: 0.95rem;
        margin: 0;
    }

    .pc-sku {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 600;
        text-transform: uppercase;
    }

    .pc-price {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
    }

    .pc-stock {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .stock-high {
        background: #dcfce7;
        color: #166534;
    }

    .stock-low {
        background: #fee2e2;
        color: #991b1b;
    }

    /* DERECHA: TICKET (VISUALIZACIÓN TIPO PAPEL) */
    .ticket-area {
        background: #cbd5e1; /* Fondo gris oscuro para resaltar el papel */
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow-y: hidden;
    }

    .paper-receipt {
        background: white;
        width: 100%;
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        border-radius: 5px; /* Solo un poco redondeado arriba */
        display: flex;
        flex-direction: column;
        position: relative;
    }

        /* Efecto de dientes de sierra abajo del ticket */
        .paper-receipt::after {
            content: "";
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 100%;
            height: 10px;
            background: linear-gradient(135deg, transparent 50%, white 50%), linear-gradient(45deg, white 50%, transparent 50%);
            background-size: 20px 20px;
        }

    .receipt-header {
        background: #f1f5f9;
        padding: 15px;
        text-align: center;
        border-bottom: 2px dashed #cbd5e1;
    }

    .receipt-body {
        flex-grow: 1;
        overflow-y: auto;
        padding: 0;
    }

    .receipt-item {
        padding: 10px 15px;
        border-bottom: 1px dashed #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .receipt-item:hover {
            background-color: #fff1f2;
        }
    /* Rojo suave al pasar mouse para indicar borrar */

    .ri-qty {
        font-weight: bold;
        width: 30px;
    }

    .ri-desc {
        flex-grow: 1;
        font-size: 0.9rem;
    }

    .ri-total {
        font-weight: bold;
    }

    .ri-del {
        color: red;
        cursor: pointer;
        visibility: hidden;
    }

    .receipt-item:hover .ri-del {
        visibility: visible;
    }

    .receipt-summary {
        padding: 15px;
        background: #f8fafc;
        border-top: 2px dashed #cbd5e1;
    }

    /* --- ZONA INFERIOR (BARRA DE COMANDOS) --- */
    .command-bar {
        background: var(--pos-footer);
        color: white;
        display: flex;
        align-items: center;
        padding: 0 20px;
        justify-content: space-between;
        box-shadow: 0 -5px 15px rgba(0,0,0,0.2);
        z-index: 100;
    }

    .cmd-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .cmd-actions {
        display: flex;
        gap: 10px;
        height: 70%;
    }

    /* BOTONES CUADRADOS/RECTANGULARES */
    .btn-cmd {
        border: none;
        border-radius: 6px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.1s;
        height: 100%;
        font-size: 0.9rem;
    }

        .btn-cmd:active {
            transform: translateY(2px);
        }

    .btn-cancel {
        background: #ef4444;
        color: white;
    }

    .btn-client {
        background: #3b82f6;
        color: white;
    }

    .btn-pay {
        background: #22c55e;
        color: white;
        font-size: 1.4rem;
        padding: 0 40px;
        box-shadow: 0 0 15px rgba(34, 197, 94, 0.4);
    }

        .btn-pay:hover {
            background: #16a34a;
        }

    /* RESPONSIVE MÓVIL */
    @@media (max-width: 991.98px) {
        .pos-layout {
            height: auto;
            display: block;
            padding-bottom: 100px;
        }

        .pos-workspace {
            display: block;
        }

        .ticket-area {
            display: none;
        }
        /* Ocultamos el ticket visual en móvil */
        /* En móvil, la barra de abajo cambia */
        .command-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 80px;
            padding: 10px;
        }

        .btn-pay {
            flex-grow: 1;
            font-size: 1.2rem;
        }

        .cmd-info {
            display: none;
        }
        /* Ocultamos info extra en móvil */
    }
</style>

<div class="pos-layout">

    @* --- ZONA DE TRABAJO --- *@
    <div class="pos-workspace">

        @* 1. CATÁLOGO *@
        <div class="catalog-area">
            <div class="search-header">
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" id="inputBusqueda" class="form-control border-0" placeholder="Buscar producto o escanear (F2)..." autocomplete="off" autofocus>
                    <button class="btn btn-white border-0" onclick="$('#inputBusqueda').val('').focus()"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>

            <div id="contenedorResultados" class="product-list-container">
                @* Estado inicial *@
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50">
                    <i class="bi bi-upc-scan display-1"></i>
                    <p class="mt-3 fw-bold">Listo para vender</p>
                </div>
            </div>
        </div>

        @* 2. TICKET VISUAL (Papel) *@
        <div class="ticket-area">
            <div class="paper-receipt">
                <div class="receipt-header">
                    <h5 class="fw-bold mb-0">TICKET DE VENTA</h5>
                    <small class="text-muted">@(DateTime.Now.ToString("dd/MM/yyyy"))</small>
                </div>

                <div id="listaTicket" class="receipt-body">
                    @* Items van aquí *@
                </div>

                <div class="receipt-summary">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Subtotal:</span>
                        <span id="lblSubtotal">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>IVA:</span>
                        <span>$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                        <span class="fs-5 fw-bold">TOTAL:</span>
                        <span class="fs-3 fw-bold text-dark" id="lblTotal">$0.00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- BARRA DE COMANDOS (SIEMPRE ABAJO) --- *@
    <div class="command-bar">
        <div class="cmd-info">
            <div class="d-flex align-items-center text-white-50">
                <i class="bi bi-person-circle fs-4 me-2"></i>
                <div>
                    <div class="small fw-bold text-white">@User.Identity.Name</div>
                    <div style="font-size: 0.7rem;">Caja Principal</div>
                </div>
            </div>

            @* Input Cliente Integrado en la barra *@
            <div class="input-group input-group-sm" style="width: 250px;">
                <span class="input-group-text bg-dark border-0 text-white"><i class="bi bi-people"></i></span>
                <input type="text" id="nombreCliente" class="form-control bg-dark border-0 text-white" placeholder="Cliente (Público General)">
            </div>
        </div>

        <div class="cmd-actions">
            <button class="btn-cmd btn-cancel" onclick="limpiarTicket()" title="Borrar Todo">
                <i class="bi bi-trash3-fill me-2"></i> <span class="d-none d-md-inline">Borrar</span>
            </button>

            <button class="btn-cmd btn-client d-md-none" onclick="$('#nombreCliente').focus()">
                <i class="bi bi-person-plus-fill"></i>
            </button>

            <button class="btn-cmd btn-pay" onclick="finalizarVenta()">
                <span class="me-2">COBRAR</span> <span id="btnTotal">$0.00</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let debounceTimer;

        $(document).ready(function() {
            cargarTicket();

            // Atajos de teclado
            $(document).keydown(function(e) {
                if(e.key === "F12") { e.preventDefault(); finalizarVenta(); }
                if(e.key === "F2") { e.preventDefault(); $('#inputBusqueda').focus(); }
                if(e.key === "Escape") { limpiarTicket(); }
            });
        });

        // --- BUSCADOR ---
        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer);
            const term = $(this).val();

            if (term.length < 2) {
                if(term.length === 0) $('#contenedorResultados').html('<div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50"><i class="bi bi-upc-scan display-1"></i><p class="mt-3 fw-bold">Listo para vender</p></div>');
                return;
            }

            debounceTimer = setTimeout(() => {
                $.get('/Ventas/BuscarProductos', { term: term }, function(data) {
                    renderizarResultados(data);
                });
            }, 300);
        });

        function renderizarResultados(productos) {
            const container = $('#contenedorResultados');
            container.empty();

            if (productos.length === 0) {
                container.append('<div class="text-center py-5 text-muted"><h5><i class="bi bi-emoji-frown me-2"></i>No encontrado</h5></div>');
                return;
            }

            productos.forEach(p => {
                const stockStyle = p.stock < 5 ? 'stock-low' : 'stock-high';

                container.append(`
                    <div class="prod-card" onclick="agregarAlTicket(${p.id})">
                        <img src="${p.imagenUrl || '/images/no-image.png'}" class="pc-img">
                        <div class="pc-info">
                            <div class="d-flex justify-content-between">
                                <span class="pc-title">${p.nombre}</span>
                                <span class="pc-price">$${p.precioVenta.toFixed(2)}</span>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span class="pc-sku">${p.sku} | ${p.marcaPieza}</span>
                                <span class="pc-stock ${stockStyle}">${p.stock} pzas</span>
                            </div>
                        </div>
                    </div>
                `);
            });
        }

        // --- TICKET ---
        function agregarAlTicket(id) {
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) {
                if (res.success) {
                    cargarTicket();
                    // Feedback sutil
                    const Toast = Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1000 });
                    Toast.fire({ icon: 'success', title: 'Agregado' });
                } else {
                    Swal.fire({ icon: 'warning', title: 'Stock', text: res.message, toast: true, position: 'top', timer: 2000 });
                }
            });
        }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                const lista = $('#listaTicket');
                lista.empty();

                // Actualizar Textos
                $('#lblTotal').text('$' + data.total);
                $('#btnTotal').text('$' + data.total);
                $('#lblSubtotal').text('$' + data.total); // Simplificado sin IVA por ahora

                if (data.items.length === 0) {
                    lista.html('<div class="text-center py-5 text-muted opacity-50"><p>Ticket vacío</p></div>');
                    return;
                }

                data.items.forEach(item => {
                    lista.append(`
                        <div class="receipt-item" onclick="eliminarDelTicket(${item.productoId})">
                            <div class="ri-qty">${item.cantidad}</div>
                            <div class="ri-desc">
                                <div>${item.nombre}</div>
                                <small class="text-muted">$${item.precio.toFixed(2)} c/u</small>
                            </div>
                            <div class="ri-total">$${(item.precio * item.cantidad).toFixed(2)}</div>
                            <div class="ri-del"><i class="bi bi-x-circle-fill"></i></div>
                        </div>
                    `);
                });
            });
        }

        function eliminarDelTicket(id) {
            $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); });
        }

        function limpiarTicket() {
            $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); });
        }

        // --- FINALIZAR VENTA (EL NUEVO FLUJO) ---
        function finalizarVenta() {
            const cliente = $('#nombreCliente').val();
            const total = $('#lblTotal').text();

            if (total === "$0.00") {
                Swal.fire('Ticket Vacío', 'Agrega productos primero.', 'info');
                return;
            }

            // 1. Confirmar Cobro
            Swal.fire({
                title: 'Cobrar ' + total,
                text: "¿Confirmar la venta?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#22c55e',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, Cobrar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // 2. Procesar en Backend
                    $.post('/Ventas/FinalizarVenta', { nombreCliente: cliente }, function(res) {
                        if (res.success) {
                            // 3. MOSTRAR OPCIONES DE POST-VENTA (Imprimir, Correo, Nuevo)
                            Swal.fire({
                                title: '¡Venta Exitosa!',
                                html: `
                                    <h3 class="text-success mb-3">Folio #${res.pedidoId}</h3>
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-lg btn-outline-dark" onclick="imprimirTicket(${res.pedidoId})">
                                            <i class="bi bi-printer-fill me-2"></i> Imprimir Ticket
                                        </button>
                                        <button class="btn btn-lg btn-outline-primary" onclick="enviarCorreo(${res.pedidoId})">
                                            <i class="bi bi-envelope-fill me-2"></i> Enviar por Correo
                                        </button>
                                        <hr>
                                        <button class="btn btn-lg btn-success" onclick="Swal.close()">
                                            <i class="bi bi-cart-plus-fill me-2"></i> Nueva Venta
                                        </button>
                                    </div>
                                `,
                                showConfirmButton: false,
                                allowOutsideClick: false
                            }).then(() => {
                                // Al cerrar el modal, limpiamos todo
                                limpiarTicket();
                                $('#inputBusqueda').val('').focus();
                                $('#contenedorResultados').empty();
                                $('#nombreCliente').val('');
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }

        // --- FUNCIONES DUMMY PARA IMPRIMIR (POR AHORA) ---
        function imprimirTicket(id) {
            // Aquí luego pondremos la lógica real para abrir una ventana nueva con el ticket
            window.open('/Pedidos/Details/' + id, '_blank');
        }

        function enviarCorreo(id) {
            Swal.fire('Enviado', 'El ticket se envió al correo del cliente (Simulado)', 'success');
        }
    </script>
}