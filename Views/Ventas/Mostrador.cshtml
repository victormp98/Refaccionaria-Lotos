@{
    ViewData["Title"] = "Punto de Venta";
}

@* --- ESTILOS CSS PERSONALIZADOS --- *@
<style>
    :root {
        --pos-dark-bg: #1e293b; /* Azul noche profundo */
        --pos-dark-accent: #334155; /* Azul grisáceo para items */
        --pos-highlight: #4ade80; /* Verde neón para precios */
        --pos-delete: #ef4444; /* Rojo alerta */
    }

    body {
        background-color: #f1f5f9;
    }

    /* LAYOUT PC: Ocultamos scroll del body para tener "App Feel" */
    /* CORRECCIÓN AQUÍ: Usamos @@media para escapar el arroba */
    @@media (min-width: 992px) {
        body {
            overflow: hidden;
        }

        .pos-container {
            height: calc(100vh - 70px);
            display: flex;
            gap: 0;
            padding: 0;
        }

        .catalog-section {
            flex: 65%;
            height: 100%;
            overflow-y: hidden;
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .ticket-section {
            flex: 35%;
            height: 100%;
            background-color: var(--pos-dark-bg);
            color: white;
            display: flex;
            flex-direction: column;
            box-shadow: -5px 0 20px rgba(0,0,0,0.1);
        }
    }

    /* CATALOGO (IZQUIERDA) */
    .search-bar-container {
        margin-bottom: 20px;
    }

    .catalog-list {
        flex-grow: 1;
        overflow-y: auto;
        padding-right: 10px;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .product-row {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        cursor: pointer;
        transition: transform 0.1s, border-color 0.1s;
    }

        .product-row:hover {
            border-color: #3b82f6;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

    .prod-thumb {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 6px;
        background: #f8fafc;
        margin-right: 15px;
    }

    .prod-details {
        flex-grow: 1;
    }

    .prod-sku {
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .prod-title {
        font-weight: 600;
        color: #0f172a;
        margin: 0;
        line-height: 1.2;
        font-size: 1rem;
    }

    .prod-price-tag {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
    }

    .prod-stock-badge {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 600;
    }

    .stock-ok {
        background: #dcfce7;
        color: #166534;
    }

    .stock-low {
        background: #fee2e2;
        color: #991b1b;
    }

    /* TICKET (DERECHA - DARK MODE) */
    .ticket-header {
        padding: 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .ticket-body {
        flex-grow: 1;
        overflow-y: auto;
        padding: 15px;
    }

    .ticket-footer {
        padding: 20px;
        background: rgba(0,0,0,0.2);
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .ticket-item {
        background: var(--pos-dark-accent);
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid transparent;
    }

        .ticket-item:hover {
            border-color: rgba(255,255,255,0.2);
        }

    .t-qty {
        background: #0f172a;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: bold;
        font-size: 0.9rem;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .t-info {
        flex-grow: 1;
        overflow: hidden;
    }

    .t-name {
        font-size: 0.9rem;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .t-price {
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .t-subtotal {
        font-weight: bold;
        font-size: 1rem;
        color: var(--pos-highlight);
        margin-left: 10px;
    }

    .btn-del {
        color: #ef4444;
        background: transparent;
        border: none;
        padding: 5px;
        opacity: 0.7;
        transition: 0.2s;
    }

        .btn-del:hover {
            opacity: 1;
            transform: scale(1.1);
        }

    /* MÓVIL STICKY FOOTER */
    .mobile-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: var(--pos-dark-bg);
        color: white;
        padding: 15px;
        z-index: 1050;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 -4px 10px rgba(0,0,0,0.2);
        border-radius: 15px 15px 0 0;
    }

    /* AJUSTES RESPONSIVOS */
    /* CORRECCIÓN AQUÍ TAMBIÉN: @@media */
    @@media (max-width: 991.98px) {
        .pos-container {
            display: block;
            height: auto;
            padding-bottom: 90px;
        }

        .ticket-section {
            display: none;
        }

        .offcanvas-bottom {
            height: 80vh !important;
            background: var(--pos-dark-bg);
            color: white;
        }

        .offcanvas-header .btn-close {
            filter: invert(1);
        }
    }
</style>

<div class="pos-container">
    @* --- SECCIÓN CATÁLOGO (IZQUIERDA / MAIN) --- *@
    <div class="catalog-section">
        <div class="search-bar-container">
            <div class="input-group input-group-lg shadow-sm">
                <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-search text-primary"></i></span>
                <input type="text" id="inputBusqueda" class="form-control border-0 py-3" placeholder="Buscar producto o escanear (F2)..." autocomplete="off" autofocus>
                <button class="btn btn-white border-0 pe-3" onclick="$('#inputBusqueda').val('').focus()"><i class="bi bi-x-circle-fill text-muted"></i></button>
            </div>
        </div>

        <div id="contenedorResultados" class="catalog-list">
            @* ESTADO INICIAL *@
            <div class="d-flex flex-column align-items-center justify-content-center h-75 text-muted opacity-50">
                <i class="bi bi-upc-scan display-1 mb-3"></i>
                <h4>Listo para vender</h4>
                <p>Usa el buscador o la pistola de código</p>
            </div>
        </div>
    </div>

    @* --- SECCIÓN TICKET PC (DERECHA / DARK MODE) --- *@
    <div class="ticket-section d-none d-lg-flex">
        <div class="d-flex flex-column h-100" id="pcTicketContainer">
            @* El contenido se inyecta vía JS usando el template *@
        </div>
    </div>
</div>

@* --- COMPONENTE MÓVIL: OFFCANVAS TICKET --- *@
<div class="offcanvas offcanvas-bottom rounded-top-4" tabindex="-1" id="offcanvasTicket">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title fw-bold"><i class="bi bi-receipt me-2"></i>Ticket de Venta</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column bg-dark p-0">
        <div id="mobileTicketContainer" class="flex-grow-1 d-flex flex-column h-100"></div>
    </div>
</div>

@* --- MÓVIL: STICKY FOOTER --- *@
<div class="mobile-footer d-lg-none" id="mobileFooterBar" style="display:none !important;">
    <div>
        <small class="d-block text-secondary" style="font-size: 0.75rem;">Total a Pagar</small>
        <span class="fw-bold fs-3 text-white" id="mobileTotalDisplay">$0.00</span>
        <span class="badge bg-primary ms-2 rounded-pill" id="mobileCountBadge">0 items</span>
    </div>
    <button class="btn btn-success fw-bold rounded-pill px-4 shadow" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasTicket">
        Ver Ticket <i class="bi bi-chevron-up ms-1"></i>
    </button>
</div>

@* --- TEMPLATE DEL TICKET (PARA REUTILIZAR EN JS) --- *@
<script id="ticketTemplate" type="text/template">
    <div class="d-flex flex-column h-100">
        <div class="ticket-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-white"><i class="bi bi-cart3 me-2"></i>Venta Actual</h5>
            <button class="btn btn-sm btn-outline-danger border-0 text-danger-emphasis" onclick="limpiarTicket()" title="Vaciar">
                <i class="bi bi-trash3-fill"></i> Limpiar
            </button>
        </div>

        <div class="px-3 py-2 border-bottom border-secondary">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-transparent border-secondary text-secondary"><i class="bi bi-person-fill"></i></span>
                <input type="text" id="nombreCliente" class="form-control bg-transparent border-secondary text-white" placeholder="Cliente (Opcional - Público General)">
            </div>
        </div>

        <div id="listaTicketItems" class="ticket-body">
            </div>

        <div class="ticket-footer mt-auto">
            <div class="d-flex justify-content-between align-items-end mb-3">
                <span class="text-secondary fw-bold small">TOTAL:</span>
                <span class="h1 fw-bold mb-0" style="color: var(--pos-highlight);" id="displayTotalVenta">$0.00</span>
            </div>
            <div class="d-grid">
                <button class="btn btn-success btn-lg fw-bold rounded-3 shadow py-3" onclick="finalizarVenta()">
                    <i class="bi bi-cash-coin me-2"></i> COBRAR (F12)
                </button>
            </div>
        </div>
    </div>
</script>

@section Scripts {
    <script>
        let debounceTimer;

        $(document).ready(function() {
            // Inicializar estructuras
            renderTicketStructure();
            cargarTicket();

            // Atajos
            $(document).keydown(function(e) {
                if(e.key === "F12") { e.preventDefault(); finalizarVenta(); }
                if(e.key === "F2") { e.preventDefault(); $('#inputBusqueda').focus(); }
            });
        });

        // --- RENDERIZADO DE ESTRUCTURA DEL TICKET (PC Y MOVIL) ---
        function renderTicketStructure() {
            const template = document.getElementById('ticketTemplate').innerHTML;
            // Poner en PC
            $('#pcTicketContainer').html(template);
            // Poner en Móvil
            $('#mobileTicketContainer').html(template);

            // Sincronizar inputs de cliente (si escribes en uno, se copia al otro)
            $(document).on('input', '#nombreCliente', function() {
                const val = $(this).val();
                $('[id="nombreCliente"]').val(val);
            });
        }

        // --- BUSCADOR ---
        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer);
            const term = $(this).val();

            if (term.length < 2) {
                if(term.length === 0) $('#contenedorResultados').html('<div class="d-flex flex-column align-items-center justify-content-center h-75 text-muted opacity-50"><i class="bi bi-upc-scan display-1 mb-3"></i><h4>Listo para vender</h4><p>Usa el buscador o la pistola de código</p></div>');
                return;
            }

            debounceTimer = setTimeout(() => {
                $.get('/Ventas/BuscarProductos', { term: term }, function(data) {
                    renderizarResultados(data);
                });
            }, 300);
        });

        function renderizarResultados(productos) {
            const container = $('#contenedorResultados');
            container.empty();

            if (productos.length === 0) {
                container.append('<div class="text-center py-5 text-muted"><h5><i class="bi bi-emoji-frown me-2"></i>No encontrado</h5></div>');
                return;
            }

            productos.forEach(p => {
                const stockClass = p.stock < 5 ? 'stock-low' : 'stock-ok';
                const stockText = p.stock < 5 ? '¡Poco Stock!' : 'Disponible';

                container.append(`
                    <div class="product-row" onclick="agregarAlTicket(${p.id})">
                        <img src="${p.imagenUrl || '/images/no-image.png'}" class="prod-thumb">
                        <div class="prod-details">
                            <div class="d-flex justify-content-between">
                                <span class="prod-sku">${p.sku}</span>
                                <span class="prod-brand">${p.marcaPieza}</span>
                            </div>
                            <h6 class="prod-title text-truncate">${p.nombre}</h6>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="prod-stock-badge ${stockClass}">${p.stock} ${stockText}</span>
                                <span class="prod-price-tag">$${p.precioVenta.toFixed(2)}</span>
                            </div>
                        </div>
                        <div class="ms-3 text-primary"><i class="bi bi-plus-circle-fill fs-3"></i></div>
                    </div>
                `);
            });
        }

        // --- LÓGICA DEL TICKET ---
        function agregarAlTicket(id) {
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) {
                if (res.success) {
                    cargarTicket();
                    // Feedback sonoro o visual rápido
                    const Toast = Swal.mixin({ toast: true, position: 'bottom-start', showConfirmButton: false, timer: 1000, background: '#1e293b', color: '#fff' });
                    Toast.fire({ icon: 'success', title: 'Producto agregado' });
                } else {
                    Swal.fire({ icon: 'error', title: 'Atención', text: res.message });
                }
            });
        }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                // Actualizar TODOS los contenedores de items (PC y Móvil)
                const listas = $('[id="listaTicketItems"]');
                listas.empty();

                // Actualizar Totales
                $('[id="displayTotalVenta"]').text('$' + data.total);
                $('#mobileTotalDisplay').text('$' + data.total);
                $('#mobileCountBadge').text(data.count + ' items');

                // Mostrar/Ocultar Footer Móvil
                if(data.count > 0) {
                    $('#mobileFooterBar').attr('style', 'display: flex !important');
                } else {
                    $('#mobileFooterBar').hide();
                }

                if (data.items.length === 0) {
                    listas.html('<div class="text-center py-5 text-secondary opacity-50"><i class="bi bi-cart-x display-4"></i><p class="mt-2">Vacío</p></div>');
                    return;
                }

                data.items.forEach(item => {
                    const htmlItem = `
                        <div class="ticket-item">
                            <div class="d-flex align-items-center overflow-hidden flex-grow-1">
                                <div class="t-qty">${item.cantidad}</div>
                                <div class="t-info">
                                    <div class="t-name">${item.nombre}</div>
                                    <div class="t-price">$${item.precio.toFixed(2)} c/u</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="t-subtotal">$${(item.precio * item.cantidad).toFixed(2)}</div>
                                <button class="btn-del ms-3" onclick="eliminarDelTicket(${item.productoId})"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    `;
                    listas.append(htmlItem);
                });
            });
        }

        function eliminarDelTicket(id) {
            $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); });
        }

        function limpiarTicket() {
            $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); });
        }

        function finalizarVenta() {
            // Obtenemos el nombre del cliente desde CUALQUIERA de los inputs visibles
            const cliente = $('input[id="nombreCliente"]').filter(':visible').val() || $('input[id="nombreCliente"]').val();

            if ($('[id="listaTicketItems"]').first().find('.ticket-item').length === 0) {
                Swal.fire('Ticket Vacío', 'Agrega productos primero.', 'warning');
                return;
            }

            Swal.fire({
                title: '¿Cobrar?',
                text: "Total: " + $('[id="displayTotalVenta"]').first().text(),
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981', // Verde
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, Cobrar',
                cancelButtonText: 'Cancelar',
                background: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Ventas/FinalizarVenta', { nombreCliente: cliente }, function(res) {
                        if (res.success) {
                            // Cerrar Offcanvas si está abierto
                            const offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasTicket'));
                            if(offcanvas) offcanvas.hide();

                            Swal.fire({
                                title: '¡Venta Exitosa!',
                                html: `<h3 class="text-success">Folio #${res.pedidoId}</h3><p>Salida de inventario registrada.</p>`,
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                limpiarTicket();
                                $('#inputBusqueda').val('').focus();
                                $('#contenedorResultados').empty();
                                $('[id="nombreCliente"]').val('');
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}