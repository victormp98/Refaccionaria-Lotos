@{
    ViewData["Title"] = "Punto de Venta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>POS - Refaccionaria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* --- VARIABLES --- */
        :root {
            --bg-app: #f3f4f6;
            --color-primary: #2563eb;
            --color-success: #16a34a;
            --color-danger: #dc2626;
            --color-dark: #111827;
            --color-iva-on: #7c3aed;
        }

        body {
            background-color: var(--bg-app);
            font-family: system-ui, -apple-system, sans-serif;
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
        }

        /* --- LAYOUT GENERAL --- */
        .pos-wrapper {
            display: flex;
            height: 100%;
            width: 100%;
        }

        /* IZQUIERDA (Catálogo) */
        .left-panel {
            flex: 60%;
            display: flex;
            flex-direction: column;
            padding: 15px;
            border-right: 1px solid #e5e7eb;
        }

        .right-panel {
            flex: 40%;
            background: #fff;
            display: flex;
            flex-direction: column;
            box-shadow: -4px 0 15px rgba(0,0,0,0.05);
            z-index: 10;
        }

        /* BUSCADOR */
        .search-area {
            margin-bottom: 15px;
        }

        .search-input {
            height: 55px;
            font-size: 1.3rem;
            font-weight: 700;
            border: 2px solid var(--color-primary);
            border-radius: 8px;
            box-shadow: none !important;
        }

        /* GRID DE PRODUCTOS */
        .products-grid {
            flex-grow: 1;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
            align-content: start;
            padding-right: 5px;
            padding-bottom: 20px;
        }

        /* CARD */
        .prod-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 8px;
            cursor: pointer;
            transition: transform 0.1s;
            display: flex;
            flex-direction: column;
            height: 100%;
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

            .prod-card:active {
                transform: scale(0.96);
                border-color: var(--color-success);
            }

        .prod-img {
            width: 100%;
            height: 90px;
            object-fit: cover;
            background: #f9fafb;
            margin-bottom: 8px;
            border-radius: 4px;
        }

        .prod-sku {
            font-size: 0.65rem;
            color: #6b7280;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .prod-name {
            font-size: 0.8rem;
            font-weight: 600;
            line-height: 1.3;
            margin-bottom: 4px;
            color: var(--color-dark);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 2.6em;
        }

        .prod-price {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--color-success);
            text-align: right;
            margin-top: auto;
        }

        .prod-stock {
            position: absolute;
            top: 6px;
            right: 6px;
            background: rgba(255,255,255,0.95);
            padding: 2px 6px;
            font-size: 0.65rem;
            font-weight: 700;
            border-radius: 4px;
            border: 1px solid #e5e7eb;
            color: #4b5563;
        }

        /* TICKET (PC) */
        .ticket-header {
            background: var(--color-dark);
            color: white;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .ticket-list-container {
            flex-grow: 1;
            overflow-y: auto;
            background: #f9fafb;
            padding: 0;
        }

        .t-table {
            width: 100%;
            border-collapse: collapse;
        }

            .t-table th {
                background: #e5e7eb;
                position: sticky;
                top: 0;
                padding: 10px;
                font-size: 0.7rem;
                text-transform: uppercase;
                color: #4b5563;
                border-bottom: 1px solid #d1d5db;
                text-align: left;
            }

            .t-table td {
                padding: 10px;
                border-bottom: 1px solid #e5e7eb;
                vertical-align: middle;
                font-size: 0.9rem;
            }

        .qty-control {
            display: flex;
            align-items: center;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            background: white;
            overflow: hidden;
        }

        .btn-qty {
            border: none;
            background: #f9fafb;
            color: var(--color-primary);
            font-weight: bold;
            padding: 5px 10px;
            cursor: pointer;
        }

            .btn-qty:active {
                background: #e5e7eb;
            }

        .qty-val {
            font-weight: bold;
            font-size: 0.9rem;
            width: 30px;
            text-align: center;
            border-left: 1px solid #e5e7eb;
            border-right: 1px solid #e5e7eb;
        }

        .financial-summary {
            background: #f3f4f6;
            padding: 15px;
            border-top: 1px solid #d1d5db;
        }

        .fin-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: #4b5563;
        }

        .fin-total {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--color-dark);
            align-items: center;
        }

        /* BOTONERA PC */
        .action-panel {
            padding: 15px;
            background: white;
            border-top: 1px solid #e5e7eb;
            display: grid;
            grid-template-columns: 1fr 1fr 1.5fr;
            grid-template-rows: 1fr 1fr;
            gap: 8px;
            height: 140px;
        }

        .btn-big {
            border: none;
            border-radius: 6px;
            font-weight: 700;
            text-transform: uppercase;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.1s;
            color: white;
            font-size: 0.75rem;
        }

            .btn-big:active {
                filter: brightness(0.9);
                transform: translateY(1px);
            }

            .btn-big i {
                font-size: 1.4rem;
                margin-bottom: 4px;
            }

        .btn-cancel {
            background-color: var(--color-danger);
        }

        .btn-discount {
            background-color: #f59e0b;
        }

        .btn-client {
            background-color: #3b82f6;
        }

        .btn-iva-active {
            background-color: var(--color-iva-on);
            border: 2px solid var(--color-iva-on);
        }

        .btn-iva-inactive {
            background-color: white;
            color: #9ca3af;
            border: 2px solid #e5e7eb;
        }

        .btn-pay {
            background-color: var(--color-success);
            grid-column: 3;
            grid-row: 1 / span 2;
            font-size: 1.2rem;
        }

            .btn-pay i {
                font-size: 2rem;
            }

        /* ANIMACIONES */
        .flash-anim {
            animation: flash 0.3s;
        }

        @@keyframes flash {
            0% {
                background: #86efac;
            }

            100% {
                background: white;
            }
        }

        /* --- MÓVIL (AJUSTES CRÍTICOS) --- */
        .mobile-header {
            display: none;
        }

        @@media (max-width: 991.98px) {
            body {
                overflow: auto;
                height: auto;
                /* Padding superior IGUAL a la altura del header fijo para que no se encimen */
                padding-top: 70px;
                background: white;
            }

            .pos-wrapper {
                display: block;
                padding: 10px;
            }

            .left-panel {
                border: none;
                padding: 0;
            }

            .right-panel {
                display: none !important;
            }
            /* Ocultar panel derecho forzosamente */
            /* Grid Móvil: 2 columnas forzadas */
            .products-grid {
                grid-template-columns: repeat(2, 1fr); /* Siempre 2 columnas */
                gap: 10px;
                padding-bottom: 50px;
            }
            /* HEADER FIJO VISIBLE */
            .mobile-header {
                display: flex !important;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 70px; /* Altura fija */
                background: var(--color-dark);
                color: white;
                z-index: 9999; /* Encima de todo */
                align-items: center;
                justify-content: space-between;
                padding: 0 10px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            }
            /* Botones del Header Móvil */
            .mh-btn-list {
                width: 45px;
                height: 45px;
                background: rgba(255,255,255,0.15);
                border: 1px solid rgba(255,255,255,0.2);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 1.2rem;
                flex-shrink: 0; /* No encogerse */
            }

            .mh-info {
                text-align: right;
                flex-grow: 1;
                margin-right: 10px;
                line-height: 1.1;
            }

            .mh-label {
                font-size: 0.7rem;
                opacity: 0.8;
                display: block;
            }

            .mh-total {
                font-size: 1.2rem;
                font-weight: 800;
                color: #4ade80;
                display: block;
            }

            .mh-btn-pay {
                background: var(--color-success);
                color: white;
                border: none;
                height: 45px;
                padding: 0 20px;
                border-radius: 8px;
                font-weight: 700;
                font-size: 1rem;
                display: flex;
                align-items: center;
                gap: 5px;
                flex-shrink: 0; /* No encogerse */
                box-shadow: 0 0 10px rgba(34, 197, 94, 0.4);
            }
        }
    </style>
</head>
<body>

    @* HEADER MÓVIL *@
    <div class="mobile-header">
        <button class="mh-btn-list" onclick="verTicketMovil()">
            <i class="bi bi-receipt fs-4"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="mobBadge" style="display:none;">0</span>
        </button>
        <div class="text-end">
            <small class="d-block text-white-50" style="font-size:0.7rem; line-height:1;">Total a Pagar</small>
            <div class="mh-total" id="mobTotalDisplay">$0.00</div>
        </div>
        <button class="mh-btn-pay" onclick="abrirModalCobro()">
            COBRAR <i class="bi bi-chevron-right"></i>
        </button>
    </div>

    <div class="pos-wrapper">
        <div class="left-panel">
            <div class="search-area">
                <div class="input-group">
                    <span class="input-group-text bg-white border-2 border-primary border-end-0"><i class="bi bi-search fs-4 text-primary"></i></span>
                    <input type="text" id="inputBusqueda" class="form-control search-input border-start-0 ps-0" placeholder="BUSCAR / ESCANEAR (F2)..." autocomplete="off" autofocus>
                    <button class="btn btn-light border-2 border-start-0" onclick="$('#inputBusqueda').val('').focus()"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div id="contenedorResultados" class="products-grid">
                <div class="d-flex flex-column align-items-center justify-content-center w-100 h-100 text-muted opacity-50 pt-5">
                    <i class="bi bi-upc-scan" style="font-size: 4rem;"></i>
                    <h3 class="mt-3 fw-bold">LISTO PARA VENDER</h3>
                </div>
            </div>
        </div>

        <div class="right-panel d-none d-lg-flex">
            <div class="ticket-header">
                <div class="fw-bold"><i class="bi bi-cart3 me-2"></i>TICKET</div>
                <div class="small opacity-75">@User.Identity.Name</div>
            </div>
            <div class="ticket-list-container">
                <table class="t-table">
                    <thead><tr><th style="width:45%;">Descripción</th><th style="width:20%;">Precio</th><th style="width:20%;">Cant.</th><th style="width:15%;">Total</th><th style="width:5%;"></th></tr></thead>
                    <tbody id="tablaTicketBody"></tbody>
                </table>
                <div id="emptyTicketMsg" class="text-center py-5 text-muted"><p>Ticket Vacío</p></div>
            </div>
            <div class="financial-summary">
                <div class="fin-row"><span>Subtotal</span><span id="lblSubtotal">$0.00</span></div>
                <div class="fin-row"><span>IVA (16%)</span><span id="lblIVA">$0.00</span></div>
                <div class="fin-total"><span>TOTAL:</span><span id="lblTotal">$0.00</span></div>
            </div>
            <div class="action-panel">
                <button class="btn-big btn-cancel" onclick="limpiarTicket()"><i class="bi bi-trash3-fill"></i> Borrar</button>
                <button class="btn-big btn-client" onclick="asignarCliente()"><i class="bi bi-person-fill"></i> Cliente</button>
                <button class="btn-big btn-discount" onclick="Swal.fire('Tip', 'Próximamente', 'info')"><i class="bi bi-percent"></i> Desc.</button>
                <button id="btnIVAToggle" class="btn-big btn-iva-active" onclick="toggleIVA()"><i class="bi bi-receipt"></i> <span id="txtBtnIva">CON IVA</span></button>
                <button class="btn-big btn-pay" onclick="abrirModalCobro()"><i class="bi bi-cash-stack"></i> COBRAR</button>
            </div>
        </div>
    </div>

    @* OFFCANVAS MÓVIL *@
    <div class="offcanvas offcanvas-bottom" tabindex="-1" id="offcanvasTicket" style="height: 80vh;">
        <div class="offcanvas-header bg-dark text-white">
            <h5 class="offcanvas-title">Ticket Actual</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div id="mobileTicketContent" class="p-3"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let debounceTimer;
        let clienteActual = "";
        let aplicaIVA = true;
        let totalNumerico = 0;

        function playBeep() { try { const ctx = new (window.AudioContext || window.webkitAudioContext)(); const osc = ctx.createOscillator(); const g = ctx.createGain(); osc.connect(g); g.connect(ctx.destination); osc.frequency.value=1500; g.gain.value=0.05; osc.start(); setTimeout(()=>osc.stop(),80); } catch(e){} }

        $(document).ready(function() {
            cargarTicket();
            $(document).keydown(function(e) {
                if(e.key === "F12") { e.preventDefault(); abrirModalCobro(); }
                if(e.key === "F2") { e.preventDefault(); $('#inputBusqueda').focus(); }
            });
        });

        // Toggle IVA
        function toggleIVA() {
            aplicaIVA = !aplicaIVA;
            const btn = $('#btnIVAToggle');
            const txt = $('#txtBtnIva');
            if (aplicaIVA) { btn.removeClass('btn-iva-inactive').addClass('btn-iva-active'); txt.text('CON IVA'); }
            else { btn.removeClass('btn-iva-active').addClass('btn-iva-inactive'); txt.text('SIN IVA'); }
            recalcularTotalesVisuales();
        }

        function recalcularTotalesVisuales() {
            let subtotal = totalNumerico;
            let iva = 0;
            let totalFinal = totalNumerico;

            if (aplicaIVA) {
                iva = subtotal * 0.16;
                totalFinal = subtotal + iva;
            }

            $('#lblSubtotal').text('$' + subtotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#lblIVA').text('$' + iva.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#lblTotal').text('$' + totalFinal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#mobTotalDisplay').text('$' + totalFinal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        }

        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer);
            const term = $(this).val();
            if (term.length < 2) {
                if(term.length === 0) $('#contenedorResultados').html('<div class="d-flex flex-column align-items-center justify-content-center w-100 h-100 text-muted opacity-50 pt-5"><i class="bi bi-upc-scan" style="font-size: 4rem;"></i><h3 class="mt-3 fw-bold">LISTO PARA VENDER</h3></div>');
                return;
            }
            debounceTimer = setTimeout(() => { $.get('/Ventas/BuscarProductos', { term: term }, function(data) { renderizarResultados(data); }); }, 300);
        });

        function renderizarResultados(productos) {
            const container = $('#contenedorResultados'); container.empty();
            if (productos.length === 0) { container.append('<div class="col-12 text-center py-5 text-muted"><h3>No encontrado</h3></div>'); return; }
            productos.forEach(p => {
                const stockBadge = p.stock < 5 ? `<span class="prod-stock text-danger border-danger">POCO: ${p.stock}</span>` : `<span class="prod-stock">${p.stock} pzas</span>`;
                container.append(`<div id="prod-${p.id}" class="prod-card" onclick="agregarAlTicket(${p.id})">${stockBadge}<img src="${p.imagenUrl || '/images/no-image.png'}" class="prod-img"><div class="prod-sku">${p.sku}</div><div class="prod-name">${p.nombre}</div><div class="prod-price">$${p.precioVenta.toFixed(2)}</div></div>`);
            });
        }

        function agregarAlTicket(id) {
            const card = $(`#prod-${id}`); card.addClass('flash-anim'); setTimeout(() => card.removeClass('flash-anim'), 300);
            playBeep();
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) {
                if (res.success) cargarTicket();
                else Swal.fire({ icon: 'warning', title: 'Stock', text: res.message, toast: true, position: 'top' });
            });
        }

        // --- NUEVA FUNCIÓN RESTAR ---
        function restarUnidad(id) {
            $.post('/Ventas/RestarDelTicket', { id: id }, function(res) {
                if (res.success) cargarTicket();
            });
        }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                const tbody = $('#tablaTicketBody'); tbody.empty();
                totalNumerico = parseFloat(data.total.replace(/,/g, ''));
                if(data.count > 0) { $('#mobBadge').text(data.count).show(); $('#emptyTicketMsg').hide(); }
                else { $('#mobBadge').hide(); $('#emptyTicketMsg').show(); }

                data.items.forEach(item => {
                    tbody.append(`
                        <tr>
                            <td><div class="fw-bold text-dark small">${item.nombre}</div><div class="text-muted" style="font-size:0.7rem">${item.productoId}</div></td>
                            <td class="text-end">$${item.precio.toFixed(2)}</td>
                            <td>
                                <div class="qty-control">
                                    <button class="btn-qty" onclick="restarUnidad(${item.productoId})"><i class="bi bi-dash"></i></button>
                                    <div class="qty-val">${item.cantidad}</div>
                                    <button class="btn-qty" onclick="agregarAlTicket(${item.productoId})"><i class="bi bi-plus"></i></button>
                                </div>
                            </td>
                            <td class="text-end fw-bold">$${(item.precio * item.cantidad).toFixed(2)}</td>
                            <td class="text-center"><i class="bi bi-x-circle-fill text-danger fs-5" style="cursor:pointer" onclick="eliminarDelTicket(${item.productoId})"></i></td>
                        </tr>
                    `);
                });
                $('#mobileTicketContent').html($('.ticket-list-container').html());
                recalcularTotalesVisuales();
            });
        }

        function eliminarDelTicket(id) { $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); }); }
        function limpiarTicket() { $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); }); }
        function asignarCliente() { Swal.fire({ title: 'Cliente', input: 'text', inputValue: clienteActual, showCancelButton: true }).then((r) => { if(r.isConfirmed) { clienteActual = r.value; Swal.fire({icon:'success', title: 'Cliente Asignado', text: clienteActual || 'Público', toast: true, position: 'top', timer: 1000}); } }); }
        function verTicketMovil() { new bootstrap.Offcanvas(document.getElementById('offcanvasTicket')).show(); }

        function abrirModalCobro() {
            if (totalNumerico <= 0) { Swal.fire('Error', 'Ticket vacío', 'error'); return; }
            const textoCliente = clienteActual ? clienteActual : "Público General";
            const montoPagar = $('#lblTotal').text();

            Swal.fire({
                title: 'Cobrar: ' + montoPagar,
                html: `<p class="mb-3">Cliente: <strong>${textoCliente}</strong></p><div class="d-grid gap-3"><button id="btnEfectivo" class="btn btn-lg btn-success py-3 fw-bold shadow"><i class="bi bi-cash-coin me-2"></i> EFECTIVO</button><button id="btnTarjeta" class="btn btn-lg btn-primary py-3 fw-bold shadow"><i class="bi bi-credit-card-2-front me-2"></i> TARJETA</button></div>`,
                showConfirmButton: false, showCloseButton: true
            });
            setTimeout(() => {
                document.getElementById('btnEfectivo').onclick = function() { procesarVenta('Efectivo'); };
                document.getElementById('btnTarjeta').onclick = function() { procesarVenta('Tarjeta'); };
            }, 100);
        }

        function procesarVenta(metodo) {
            Swal.close();
            Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

            // --- ENVIAMOS EL IVA AL BACKEND ---
            $.post('/Ventas/FinalizarVenta', { nombreCliente: clienteActual, metodoPago: metodo, aplicaIVA: aplicaIVA }, function(res) {
                if (res.success) {
                    Swal.fire({ title: '¡Venta Exitosa!', html: `<h1 class="text-success display-4"><i class="bi bi-check-circle"></i></h1><h3>Folio #${res.pedidoId}</h3><p>Pago: <strong>${metodo}</strong></p>`, confirmButtonText: 'Nueva Venta', confirmButtonColor: '#1f2937', allowOutsideClick: false }).then(() => {
                        limpiarTicket(); clienteActual = ""; $('#inputBusqueda').val('').focus(); $('#contenedorResultados').empty();
                    });
                } else { Swal.fire('Error', res.message, 'error'); }
            }).fail(function() { Swal.fire('Error', 'No se pudo conectar', 'error'); });
        }
    </script>
</body>
</html>