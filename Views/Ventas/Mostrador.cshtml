@{
    ViewData["Title"] = "Punto de Venta";
}

<style>
    .hover-card {
        cursor: pointer;
        transition: all 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-3px);
            border: 1px solid #0d6efd !important;
            background-color: #f8f9fa;
        }

    /* Ajustes para Móvil */
    @@media (max-width: 991.98px) {
        .pos-col-search, .pos-col-ticket {
            display: none;
        }

        .pos-col-active {
            display: block;
        }

        .pos-tabs {
            display: flex !important;
        }
    }

    /* Ajustes PC */
    @@media (min-width: 992px) {
        .pos-col-search, .pos-col-ticket {
            display: block !important;
        }

        .pos-tabs {
            display: none !important;
        }
    }
</style>

<div class="container-fluid py-3">

    @* PESTAÑAS SOLO VISIBLES EN MÓVIL *@
    <div class="pos-tabs nav nav-pills nav-fill mb-3 bg-white p-2 rounded-pill shadow-sm">
        <a class="nav-link active rounded-pill fw-bold" id="tab-search" href="javascript:void(0)" onclick="switchTab('search')"><i class="bi bi-search me-1"></i> Catálogo</a>
        <a class="nav-link rounded-pill fw-bold" id="tab-ticket" href="javascript:void(0)" onclick="switchTab('ticket')">
            <i class="bi bi-receipt me-1"></i> Ticket
            <span class="badge bg-danger ms-1" id="badgeTicketCount" style="display:none">0</span>
        </a>
    </div>

    <div class="row g-3">
        @* IZQUIERDA: BUSCADOR *@
        <div class="col-lg-7 pos-col-search" id="view-search">
            <div class="card shadow-sm border-0 rounded-4" style="height: 85vh;">
                <div class="card-body p-4 d-flex flex-column">
                    <h4 class="fw-bold mb-3 d-none d-lg-block"><i class="bi bi-search text-primary me-2"></i>Catálogo Rápido</h4>

                    <div class="input-group input-group-lg mb-4 shadow-sm">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-4"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="inputBusqueda" class="form-control border-start-0 rounded-end-pill py-3"
                               placeholder="Buscar (Nombre, Marca, SKU)..." autofocus autocomplete="off">
                    </div>

                    <div id="contenedorResultados" class="row row-cols-1 row-cols-md-2 g-3 flex-grow-1 align-content-start overflow-auto" style="padding-bottom: 20px;">
                        <div class="col-12 text-center text-muted mt-5">
                            <i class="bi bi-upc-scan fs-1 d-block mb-2"></i>
                            <p>Escanea un código o escribe para buscar.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* DERECHA: TICKET *@
        <div class="col-lg-5 pos-col-ticket" id="view-ticket">
            <div class="card shadow-lg border-0 rounded-4 sticky-top" style="height: 85vh;">
                <div class="card-header bg-dark text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-receipt-cutoff me-2"></i>Ticket Actual</h5>
                    <button class="btn btn-sm btn-outline-danger text-white border-light" onclick="limpiarTicket()"><i class="bi bi-trash3-fill"></i></button>
                </div>

                <div class="card-body p-0 d-flex flex-column overflow-hidden">
                    <div id="listaTicket" class="flex-grow-1 overflow-auto p-3 bg-light">
                        @* ITEMS SE PINTAN AQUÍ *@
                    </div>
                </div>

                <div class="card-footer bg-white p-4 border-top">
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <label class="small fw-bold text-muted">Cliente</label>
                            <input type="text" id="nombreCliente" class="form-control bg-light" placeholder="Público General">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3">
                        <span class="h4 text-muted mb-0">Total:</span>
                        <span class="h2 fw-bold text-primary mb-0" id="totalVenta">$0.00</span>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg rounded-pill fw-bold shadow py-3" onclick="finalizarVenta()">
                            <i class="bi bi-check2-circle me-2"></i> COBRAR
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let debounceTimer;

        $(document).ready(function() {
            cargarTicket();
        });

        // --- FUNCIONES VISUALES MÓVIL ---
        function switchTab(tab) {
            $('.nav-link').removeClass('active');
            $('#tab-' + tab).addClass('active');

            if(tab === 'search') {
                $('#view-search').show();
                $('#view-ticket').hide();
                $('#inputBusqueda').focus();
            } else {
                $('#view-search').hide();
                $('#view-ticket').show();
            }
        }

        // --- BUSCADOR ---
        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer);
            const term = $(this).val();

            if (term.length < 2) {
                $('#contenedorResultados').html('<div class="col-12 text-center text-muted mt-5"><i class="bi bi-upc-scan fs-1 d-block mb-2"></i><p>Escanea un código o escribe para buscar.</p></div>');
                return;
            }

            debounceTimer = setTimeout(() => {
                $.get('/Ventas/BuscarProductos', { term: term }, function(data) {
                    renderizarResultados(data);
                });
            }, 300);
        });

        function renderizarResultados(productos) {
            const container = $('#contenedorResultados');
            container.empty();

            if (productos.length === 0) {
                container.append('<div class="col-12 text-center py-5 text-muted">Sin coincidencias</div>');
                return;
            }

            productos.forEach(p => {
                container.append(`
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm hover-card" onclick="agregarAlTicket(${p.id})">
                            <div class="card-body p-2 d-flex align-items-center">
                                <img src="${p.imagenUrl || '/images/no-image.png'}" class="rounded me-3 border" style="width: 60px; height: 60px; object-fit: cover;">
                                <div class="flex-grow-1 overflow-hidden">
                                    <h6 class="mb-0 fw-bold text-truncate text-dark">${p.nombre}</h6>
                                    <small class="text-muted d-block">${p.sku} | ${p.marcaPieza}</small>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <span class="fw-bold text-primary">$${p.precioVenta.toFixed(2)}</span>
                                        <span class="badge ${p.stock < 5 ? 'bg-danger' : 'bg-secondary'} rounded-pill">${p.stock} disp.</span>
                                    </div>
                                </div>
                                <div class="ms-2"><i class="bi bi-plus-circle-fill text-primary fs-3"></i></div>
                            </div>
                        </div>
                    </div>
                `);
            });
        }

        // --- TICKET ---
        function agregarAlTicket(id) {
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) {
                if (res.success) {
                    cargarTicket();
                    const toast = Swal.mixin({ toast: true, position: 'bottom-start', showConfirmButton: false, timer: 1500 });
                    toast.fire({ icon: 'success', title: 'Agregado' });
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                const lista = $('#listaTicket');
                lista.empty();
                $('#totalVenta').text('$' + data.total);

                // Actualizar Badge Móvil
                if(data.count > 0) {
                    $('#badgeTicketCount').text(data.count).show();
                } else {
                    $('#badgeTicketCount').hide();
                }

                if (data.items.length === 0) {
                    lista.html('<div class="text-center py-5 text-muted"><i class="bi bi-cart4 fs-1 d-block mb-2"></i><p>Ticket vacío</p></div>');
                    return;
                }

                data.items.forEach(item => {
                    lista.append(`
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div class="d-flex align-items-center overflow-hidden">
                                <span class="badge bg-primary rounded-pill me-2">${item.cantidad}</span>
                                <div class="text-truncate" style="max-width: 180px;">
                                    <div class="fw-bold text-dark small">${item.nombre}</div>
                                    <div class="text-muted small">$${item.precio.toFixed(2)} c/u</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="fw-bold me-3">$${(item.precio * item.cantidad).toFixed(2)}</span>
                                <button class="btn btn-sm text-danger p-0" onclick="eliminarDelTicket(${item.productoId})"><i class="bi bi-x-circle-fill"></i></button>
                            </div>
                        </div>
                    `);
                });
            });
        }

        function eliminarDelTicket(id) {
            $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); });
        }

        function limpiarTicket() {
            $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); });
        }

        function finalizarVenta() {
            const cliente = $('#nombreCliente').val();
            // Validar si hay items
            if ($('#listaTicket').find('.text-muted').length > 0) {
                Swal.fire('Ticket Vacío', 'Agrega productos antes de cobrar.', 'warning');
                return;
            }

            Swal.fire({
                title: '¿Procesar Cobro?',
                text: "Se registrará la salida del inventario.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2E86C1',
                confirmButtonText: 'Sí, Cobrar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Ventas/FinalizarVenta', { nombreCliente: cliente }, function(res) {
                        if (res.success) {
                            Swal.fire({
                                title: '¡Venta Exitosa!',
                                text: `Folio #${res.pedidoId} generado.`,
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                limpiarTicket();
                                $('#inputBusqueda').val('').focus();
                                $('#contenedorResultados').empty();
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}