@{
    ViewData["Title"] = "Punto de Venta";
}

<style>
    /* --- VARIABLES --- */
    :root {
        --pos-footer-height: 85px; /* Altura fija de la barra de botones */
        --pos-bg: #f1f5f9;
        --pos-dark: #1e293b;
    }

    body {
        background-color: var(--pos-bg);
    }

    /* --- LAYOUT PRINCIPAL --- */
    /* En PC, forzamos que no haya scroll en la ventana principal */
    @media (min-width: 992px) {
        body {
            overflow: hidden;
        }

        .pos-container {
            /* Ocupamos toda la altura visible, restando el espacio del footer */
            height: calc(100vh - var(--pos-footer-height) - 70px);
            display: flex;
            gap: 15px;
            padding: 15px;
            padding-bottom: 0; /* El footer está fijo, no necesitamos padding aquí */
        }
    }

    /* En MÓVIL, dejamos que fluya normal */
    @media (max-width: 991.98px) {
        .pos-container {
            display: block;
            padding: 10px;
            padding-bottom: 100px; /* Espacio vital para que el footer no tape el último producto */
        }
    }

    /* --- CATÁLOGO (IZQUIERDA) --- */
    .catalog-section {
        flex: 65%;
        background: white;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        overflow: hidden; /* Importante */
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .catalog-header {
        padding: 15px;
        background: white;
        border-bottom: 1px solid #f1f5f9;
    }

    .catalog-body {
        flex-grow: 1;
        overflow-y: auto; /* Scroll interno */
        padding: 10px;
    }

    /* Tarjeta Producto */
    .prod-row {
        display: flex;
        align-items: center;
        padding: 10px;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: 0.1s;
    }

        .prod-row:hover {
            background-color: #f8fafc;
        }

    .prod-img {
        width: 45px;
        height: 45px;
        border-radius: 6px;
        object-fit: cover;
        background: #eee;
        margin-right: 12px;
    }

    .prod-info {
        flex-grow: 1;
        min-width: 0;
    }

    .prod-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: #334155;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .prod-sku {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 600;
    }

    .prod-price {
        font-weight: 800;
        color: #0f172a;
        font-size: 1rem;
    }

    /* --- TICKET (DERECHA) --- */
    .ticket-section {
        flex: 35%;
        background: white;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .ticket-header {
        background: #334155;
        color: white;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ticket-body {
        flex-grow: 1;
        overflow-y: auto;
        padding: 0;
        background: #f8fafc;
    }

    .ticket-item {
        padding: 10px 15px;
        border-bottom: 1px dashed #cbd5e1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
    }

    .ticket-footer-info {
        padding: 15px;
        background: white;
        border-top: 1px solid #e2e8f0;
    }

    /* --- BARRA DE COMANDOS (FIXED FOOTER - LA SOLUCIÓN) --- */
    .command-bar {
        position: fixed; /* CLAVADO AL SUELO */
        bottom: 0;
        left: 0;
        width: 100%;
        height: var(--pos-footer-height);
        background: var(--pos-dark);
        z-index: 9999; /* ENCIMA DE TODO */
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        box-shadow: 0 -5px 20px rgba(0,0,0,0.3);
    }

    /* Botones de la barra */
    .btn-pos {
        height: 55px;
        border-radius: 8px;
        font-weight: 700;
        text-transform: uppercase;
        border: none;
        padding: 0 25px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: transform 0.1s;
    }

        .btn-pos:active {
            transform: scale(0.95);
        }

    .btn-pay {
        background: #22c55e;
        color: white;
        font-size: 1.2rem;
        flex-grow: 1;
        justify-content: center;
        max-width: 400px;
    }

    .btn-cancel {
        background: #ef4444;
        color: white;
    }

    .btn-client {
        background: #3b82f6;
        color: white;
    }

    /* RESPONSIVE */
    @media (max-width: 991.98px) {
        .ticket-section {
            display: none;
        }
        /* Ocultar ticket visual en móvil */
        .btn-pay {
            font-size: 1.1rem;
        }

        .command-bar {
            padding: 10px;
            height: 75px;
        }
        /* Un poco más delgada en móvil */
        .btn-pos {
            height: 45px;
            padding: 0 15px;
        }
    }
</style>

@* --- ÁREA PRINCIPAL --- *@
<div class="pos-container">
    @* IZQUIERDA: CATÁLOGO *@
    <div class="catalog-section">
        <div class="catalog-header">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-primary"></i></span>
                <input type="text" id="inputBusqueda" class="form-control border-start-0 ps-0" placeholder="Buscar producto (F2)..." autocomplete="off" autofocus>
                <button class="btn btn-light border" onclick="$('#inputBusqueda').val('').focus()"><i class="bi bi-x"></i></button>
            </div>
        </div>
        <div id="contenedorResultados" class="catalog-body">
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50">
                <i class="bi bi-upc-scan fs-1"></i>
                <p class="mt-2 fw-bold">Listo para vender</p>
            </div>
        </div>
    </div>

    @* DERECHA: TICKET VISUAL (SOLO PC) *@
    <div class="ticket-section d-none d-lg-flex">
        <div class="ticket-header">
            <h6 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>TICKET</h6>
            <button class="btn btn-sm btn-outline-light border-0 py-0" onclick="limpiarTicket()"><i class="bi bi-trash3"></i></button>
        </div>
        <div id="listaTicket" class="ticket-body">
            @* Items *@
        </div>
        <div class="ticket-footer-info">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">Total:</span>
                <span class="fs-2 fw-bold text-dark" id="lblTotalDisplay">$0.00</span>
            </div>
        </div>
    </div>
</div>

@* --- BARRA NEGRA INFERIOR (FIXED) --- *@
<div class="command-bar">
    @* Izquierda: Cliente *@
    <div class="d-flex align-items-center gap-2" style="flex: 1;">
        <button class="btn-pos btn-cancel" onclick="limpiarTicket()" title="Borrar">
            <i class="bi bi-trash3-fill"></i> <span class="d-none d-md-inline">Borrar</span>
        </button>
        <div class="input-group input-group-lg d-none d-md-flex" style="max-width: 300px;">
            <span class="input-group-text bg-dark border-secondary text-white border-end-0"><i class="bi bi-person-fill"></i></span>
            <input type="text" id="nombreCliente" class="form-control bg-dark border-secondary text-white border-start-0" placeholder="Cliente General">
        </div>
        <button class="btn-pos btn-client d-md-none" onclick="pedirClienteMovil()"><i class="bi bi-person-circle"></i></button>
    </div>

    @* Derecha: Cobrar *@
    <button class="btn-pos btn-pay shadow" onclick="finalizarVenta()">
        <span>COBRAR</span>
        <span class="bg-white text-success badge rounded-pill ms-2" id="btnTotal">$0.00</span>
    </button>
</div>

@section Scripts {
    <script>
        let debounceTimer;

        $(document).ready(function() {
            cargarTicket();

            // Atajos
            $(document).keydown(function(e) {
                if(e.key === "F12") { e.preventDefault(); finalizarVenta(); }
                if(e.key === "F2") { e.preventDefault(); $('#inputBusqueda').focus(); }
            });
        });

        function pedirClienteMovil() {
            Swal.fire({
                title: 'Cliente',
                input: 'text',
                inputValue: $('#nombreCliente').val(),
                showCancelButton: true
            }).then((r) => { if(r.isConfirmed) $('#nombreCliente').val(r.value); });
        }

        // --- BUSCADOR ---
        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer);
            const term = $(this).val();

            if (term.length < 2) {
                if(term.length === 0) $('#contenedorResultados').html('<div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50"><i class="bi bi-upc-scan fs-1"></i><p class="mt-2 fw-bold">Listo para vender</p></div>');
                return;
            }

            debounceTimer = setTimeout(() => {
                $.get('/Ventas/BuscarProductos', { term: term }, function(data) {
                    renderizarResultados(data);
                });
            }, 300);
        });

        function renderizarResultados(productos) {
            const container = $('#contenedorResultados');
            container.empty();

            if (productos.length === 0) {
                container.append('<div class="text-center py-5 text-muted">Sin resultados</div>');
                return;
            }

            productos.forEach(p => {
                const stockColor = p.stock < 5 ? 'text-danger' : 'text-success';
                container.append(`
                    <div class="prod-row" onclick="agregarAlTicket(${p.id})">
                        <img src="${p.imagenUrl || '/images/no-image.png'}" class="prod-img">
                        <div class="prod-info">
                            <div class="d-flex justify-content-between">
                                <h6 class="prod-title">${p.nombre}</h6>
                                <span class="prod-price">$${p.precioVenta.toFixed(2)}</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prod-sku">${p.sku}</span>
                                <span class="${stockColor} small fw-bold">${p.stock} disp.</span>
                            </div>
                        </div>
                    </div>
                `);
            });
        }

        // --- TICKET ---
        function agregarAlTicket(id) {
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) {
                if (res.success) {
                    cargarTicket();
                    const Toast = Swal.mixin({ toast: true, position: 'bottom-start', showConfirmButton: false, timer: 800 });
                    Toast.fire({ icon: 'success', title: 'Agregado' });
                } else {
                    Swal.fire({ icon: 'warning', text: res.message, toast: true, position: 'top' });
                }
            });
        }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                const lista = $('#listaTicket');
                lista.empty();

                $('#lblTotalDisplay').text('$' + data.total);
                $('#btnTotal').text('$' + data.total);

                if (data.items.length === 0) {
                    lista.html('<div class="text-center py-5 text-muted opacity-50"><p>Ticket vacío</p></div>');
                    return;
                }

                data.items.forEach(item => {
                    lista.append(`
                        <div class="ticket-item">
                            <div class="d-flex align-items-center overflow-hidden flex-grow-1">
                                <span class="badge bg-dark rounded-pill me-2">${item.cantidad}</span>
                                <div class="text-truncate">
                                    <div class="fw-bold small text-dark">${item.nombre}</div>
                                    <div class="text-muted" style="font-size:0.75rem">$${item.precio.toFixed(2)}</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="fw-bold me-2">$${(item.precio * item.cantidad).toFixed(2)}</span>
                                <i class="bi bi-x-circle text-danger" style="cursor:pointer" onclick="eliminarDelTicket(${item.productoId})"></i>
                            </div>
                        </div>
                    `);
                });
            });
        }

        function eliminarDelTicket(id) {
            $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); });
        }

        function limpiarTicket() {
            $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); });
        }

        function finalizarVenta() {
            const cliente = $('#nombreCliente').val();
            const total = $('#btnTotal').text();

            if (total === "$0.00") {
                Swal.fire('Ticket Vacío', 'Agrega productos.', 'info');
                return;
            }

            Swal.fire({
                title: 'Cobrar ' + total,
                text: "¿Confirmar la venta?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#22c55e',
                confirmButtonText: 'Sí, Cobrar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Ventas/FinalizarVenta', { nombreCliente: cliente }, function(res) {
                        if (res.success) {
                            Swal.fire({
                                title: '¡Venta Exitosa!',
                                html: `<h3>Folio #${res.pedidoId}</h3>`,
                                icon: 'success',
                                showCancelButton: true,
                                confirmButtonText: 'Nueva Venta',
                                cancelButtonText: 'Imprimir Ticket'
                            }).then((r) => {
                                if (!r.isConfirmed) {
                                    // Lógica imprimir ticket
                                    window.open('/Pedidos/Details/' + res.pedidoId, '_blank');
                                }
                                limpiarTicket();
                                $('#inputBusqueda').val('').focus();
                                $('#contenedorResultados').empty();
                                $('#nombreCliente').val('');
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}