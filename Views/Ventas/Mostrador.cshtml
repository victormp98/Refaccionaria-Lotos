@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Punto de Venta";
    // ESTA LÍNEA ES LA CLAVE: 'null' significa "No me pongas menús ni barras de admin"
    Layout = null;

    // Corrección para evitar errores si el ViewBag viene nulo
    int cajaId = ViewBag.CajaAbiertaId as int? ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>POS - Refaccionaria (Caja #@cajaId)</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-app: #e5e7eb;
            --color-primary: #2563eb;
            --color-success: #16a34a;
            --color-danger: #dc2626;
            --color-dark: #1f2937;
            --color-iva-on: #7c3aed;
        }

        /* RESET TOTAL PARA QUE NO SE VEA CHUECO */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100vh;
            overflow: hidden; /* Evita doble scroll */
            background-color: var(--bg-app);
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .pos-wrapper {
            display: flex;
            height: 100vh; /* Fuerza altura completa */
            width: 100vw; /* Fuerza ancho completo */
        }

        /* --- PANEL IZQUIERDO (BUSCADOR Y LISTA MÓVIL) --- */
        .left-panel {
            flex: 60%;
            display: flex;
            flex-direction: column;
            padding: 15px;
            border-right: 1px solid #ccc;
            height: 100%;
        }

        /* --- PANEL DERECHO (TICKET Y BOTONES) --- */
        .right-panel {
            flex: 40%;
            background: #fff;
            display: flex;
            flex-direction: column;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
            height: 100%;
        }

        /* ESTILOS DEL BUSCADOR */
        .search-area {
            margin-bottom: 15px;
        }

        .search-input {
            height: 60px;
            font-size: 1.5rem;
            font-weight: bold;
            border: 2px solid var(--color-primary);
            box-shadow: none !important;
        }

        /* GRID DE PRODUCTOS (RESULTADOS) */
        .products-grid {
            flex-grow: 1;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 10px;
            align-content: start;
            padding-right: 5px;
        }

        .prod-card {
            background: white;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 8px;
            cursor: pointer;
            transition: 0.1s;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .prod-card:active {
                transform: scale(0.95);
                border-color: var(--color-success);
            }

        .prod-img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            background: #f3f4f6;
            margin-bottom: 8px;
        }

        .prod-name {
            font-size: 0.85rem;
            font-weight: 700;
            height: 2.4em;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .prod-price {
            font-size: 1.1rem;
            font-weight: 900;
            color: var(--color-success);
            text-align: right;
            margin-top: auto;
        }

        /* TICKET TABLE */
        .ticket-header {
            background: var(--color-dark);
            color: white;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .ticket-list-container {
            flex-grow: 1;
            overflow-y: auto;
            background: #f9fafb;
        }

        .t-table {
            width: 100%;
            border-collapse: collapse;
        }

            .t-table th {
                background: #e5e7eb;
                position: sticky;
                top: 0;
                padding: 8px;
                font-size: 0.75rem;
                text-align: left;
                border-bottom: 1px solid #d1d5db;
            }

            .t-table td {
                padding: 10px 8px;
                border-bottom: 1px solid #e5e7eb;
                vertical-align: middle;
            }

        /* BOTONES DE CANTIDAD */
        .qty-control {
            display: flex;
            align-items: center;
            gap: 5px;
            border: 1px solid #d1d5db;
            border-radius: 4px;
            background: white;
            width: fit-content;
        }

        .btn-qty {
            border: none;
            background: transparent;
            color: var(--color-primary);
            font-weight: bold;
            padding: 2px 8px;
            cursor: pointer;
        }

        .qty-val {
            font-weight: bold;
            font-size: 0.9rem;
            width: 20px;
            text-align: center;
        }

        /* TOTALES */
        .financial-summary {
            background: #f3f4f6;
            padding: 15px 20px;
            border-top: 2px solid #d1d5db;
        }

        .fin-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: #4b5563;
        }

        .fin-total {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--color-dark);
        }

        /* BOTONES DE ACCIÓN (PANEL INFERIOR) */
        .action-panel {
            padding: 15px;
            background: white;
            border-top: 1px solid #e5e7eb;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 2fr;
            grid-template-rows: 1fr 1fr;
            gap: 10px;
            height: 160px;
        }

        .btn-big {
            border: none;
            border-radius: 4px;
            font-weight: 700;
            text-transform: uppercase;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
            font-size: 0.75rem;
            text-decoration: none;
        }

            .btn-big i {
                font-size: 1.3rem;
                margin-bottom: 3px;
            }

        /* COLORES DE BOTONES */
        .btn-exit {
            background-color: var(--color-danger);
        }

        .btn-client {
            background-color: #3b82f6;
        }

        .btn-cut {
            background-color: #4b5563;
        }

        .btn-reprint {
            background-color: #6b7280;
        }

        .btn-history {
            background-color: #0891b2;
        }

        .btn-iva-active {
            background-color: var(--color-iva-on);
            color: white;
            border: 2px solid var(--color-iva-on);
        }

        .btn-iva-inactive {
            background-color: white;
            color: #9ca3af;
            border: 2px solid #e5e7eb;
        }

        .btn-pay {
            background-color: var(--color-success);
            grid-column: 4;
            grid-row: 1 / span 2;
            font-size: 1.5rem;
        }

        /* --- MÓVIL / TABLET (< 992px) --- */
        @@media (max-width: 991.98px) {
            .pos-wrapper {
                display: grid;
                grid-template-columns: 1fr 90px;
            }
            /* Ajuste de barra lateral móvil */
            .left-panel {
                padding: 0;
                border: none;
                border-right: 2px solid #ccc;
                background: white;
            }

            .mobile-search-bar {
                display: flex;
                padding: 10px;
                border-bottom: 1px solid #ddd;
                height: 60px;
                flex-shrink: 0;
            }

            .mobile-input {
                width: 100%;
                height: 40px;
                border-radius: 8px;
                border: 1px solid #ccc;
                padding-left: 10px;
                background: #f9fafb;
            }
            /* Ajustes para lista de productos en móvil */
            .products-grid {
                display: none;
                background: white;
                max-height: 55vh;
                border-bottom: 1px solid #374151;
                grid-template-columns: 1fr !important;
            }

            .prod-card {
                flex-direction: row !important;
                align-items: center !important;
                height: auto !important;
                min-height: 60px !important;
                margin: 0 !important;
                border: none !important;
                border-bottom: 1px solid #eee !important;
            }

            .prod-img {
                width: 50px !important;
                height: 50px !important;
                margin: 0 10px 0 0 !important;
            }

            .prod-name {
                font-size: 0.9rem !important;
                text-align: left !important;
            }

            .prod-price {
                font-size: 1rem !important;
                min-width: 80px !important;
            }
            /* Ticket inline en móvil */
            .mobile-ticket-inline {
                display: flex;
                flex-direction: column;
                background: #f9fafb;
                flex: 1;
                overflow: hidden;
            }

            .m-ticket-header {
                background: #374151;
                color: white;
                padding: 8px 10px;
                font-weight: bold;
                display: flex;
                justify-content: space-between;
            }

            .m-ticket-body {
                flex: 1;
                overflow-y: auto;
            }

            .mt-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #e5e7eb;
                padding: 10px;
                background: white;
            }
            /* Barra lateral móvil */
            .mobile-sidebar {
                display: flex;
                flex-direction: column;
                background: var(--color-dark);
                padding: 5px;
                gap: 5px;
                overflow-y: auto;
            }

            .btn-mob {
                width: 100%;
                height: 55px;
                border-radius: 8px;
                border: none;
                background: rgba(255,255,255,0.1);
                color: white;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-size: 0.65rem;
                text-decoration: none;
            }

            .mob-pay {
                background: var(--color-success);
                height: 80px;
            }

            .mob-del {
                background: var(--color-danger);
            }
        }
    </style>
</head>
<body>

    @* ESCUDO DE SEGURIDAD *@
    @Html.AntiForgeryToken()

    @* --- MODALES --- *@

    <div class="modal fade" id="modalApertura" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white"><h5 class="modal-title fw-bold"><i class="bi bi-box-seam me-2"></i>APERTURA DE CAJA</h5></div>
                <div class="modal-body p-4 text-center">
                    <p class="text-muted mb-3">Tu turno está cerrado. Ingresa el fondo inicial.</p>
                    <div class="form-floating mb-3">
                        <input type="number" class="form-control fs-1 fw-bold text-center text-primary" id="txtFondoInicial" placeholder="0.00" value="500">
                        <label>Fondo Inicial ($)</label>
                    </div>
                    <button class="btn btn-primary btn-lg w-100 py-3 fw-bold" onclick="abrirCaja()">ABRIR CAJA</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCorte" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white"><h5 class="modal-title fw-bold">CORTE DE CAJA</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body p-0">
                    <div class="p-3 bg-light border-bottom">
                        <div class="d-flex justify-content-between mb-2"><span>Fondo Inicial:</span><strong id="lblCorteInicio">$0.00</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>Ventas Efectivo:</span><strong class="text-success" id="lblCorteEfectivo">$0.00</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>Ventas Tarjeta:</span><strong class="text-primary" id="lblCorteTarjeta">$0.00</strong></div>
                        <hr><div class="d-flex justify-content-between fs-5 fw-bold"><span>DEBE HABER (Efec):</span><span id="lblCorteEsperado">$0.00</span></div>
                    </div>
                    <div class="p-4">
                        <label class="form-label fw-bold text-muted small">EFECTIVO CONTADO (REAL)</label>
                        <input type="number" class="form-control fs-1 fw-bold text-center border-2 border-dark mb-3" id="txtMontoDeclarado" placeholder="0.00">
                        <button class="btn btn-danger btn-lg w-100 py-3 fw-bold" onclick="cerrarCaja()"><i class="bi bi-lock-fill me-2"></i> CERRAR TURNO</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCobroEfectivo" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i> PAGO EN EFECTIVO</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <span class="text-muted d-block small uppercase fw-bold">TOTAL A COBRAR</span>
                        <h1 class="display-4 fw-black text-dark" id="txtTotalEnModal">$0.00</h1>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-success">RECIBÍ DEL CLIENTE:</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-success text-white border-0">$</span>
                            <input type="number" id="txtMontoRecibido" class="form-control border-success fw-bold fs-2" placeholder="0.00" autofocus>
                        </div>
                    </div>
                    <div class="bg-light p-3 rounded-3 text-center mb-4 border">
                        <span class="text-muted d-block small fw-bold">CAMBIO (FERIA):</span>
                        <h2 class="display-6 fw-bold text-danger" id="txtCambioFinal">$0.00</h2>
                    </div>
                    <button id="btnConfirmarVentaEfectivo" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm" disabled>
                        <i class="bi bi-check-circle-fill me-2"></i> FINALIZAR VENTA
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* --- LAYOUT PRINCIPAL --- *@
    <div class="pos-wrapper">

        <div class="left-panel">
            <div class="search-area d-none d-lg-block">
                <div class="input-group">
                    <span class="input-group-text bg-white border-2 border-primary border-end-0"><i class="bi bi-search fs-4 text-primary"></i></span>
                    <input type="text" id="inputBusqueda" class="form-control search-input border-start-0 ps-0" placeholder="BUSCAR / ESCANEAR (F2)..." autocomplete="off" autofocus>
                    <button class="btn btn-light border-2 border-start-0" onclick="$('#inputBusqueda').val('').focus()"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>

            <div class="mobile-search-bar d-lg-none">
                <input type="text" id="inputBusquedaMovil" class="mobile-input" placeholder="🔍 Buscar..." autocomplete="off">
            </div>

            <div id="contenedorResultados" class="products-grid">
                <div class="d-none d-lg-flex flex-column align-items-center justify-content-center w-100 h-100 text-muted opacity-50 pt-5">
                    <i class="bi bi-upc-scan" style="font-size: 4rem;"></i>
                    <h3 class="mt-3 fw-bold">LISTO PARA VENDER</h3>
                </div>
            </div>

            <div class="mobile-ticket-inline d-lg-none">
                <div class="m-ticket-header"><span>TICKET ACTUAL</span><span id="mobTotalInline" class="text-warning">$0.00</span></div>
                <div id="mobileTicketList" class="m-ticket-body">
                    <div class="text-center text-muted small py-4 mt-5">Ticket Vacío</div>
                </div>
            </div>
        </div>

        <div class="right-panel d-none d-lg-flex">
            <div class="ticket-header">
                <div class="fw-bold"><i class="bi bi-cart3 me-2"></i> TICKET (Caja #@cajaId)</div>
                <div class="d-flex align-items-center gap-2">
                    <div class="small opacity-75 me-2">@User.Identity?.Name</div>
                    <button onclick="limpiarTicket()" class="btn btn-sm btn-outline-light border-0" title="Limpiar Ticket"><i class="bi bi-trash3"></i></button>
                </div>
            </div>

            <div class="ticket-list-container">
                <table class="t-table">
                    <thead><tr><th style="width:45%;">Descripción</th><th style="width:20%;">Precio</th><th style="width:20%;">Cant.</th><th style="width:15%;">Total</th><th style="width:5%;"></th></tr></thead>
                    <tbody id="tablaTicketBody"></tbody>
                </table>
                <div id="emptyTicketMsg" class="text-center py-5 text-muted"><p>Ticket Vacío</p></div>
            </div>

            <div class="financial-summary">
                <div class="fin-row"><span>Subtotal</span><span id="lblSubtotal">$0.00</span></div>
                <div class="fin-row"><span>IVA (16%)</span><span id="lblIVA">$0.00</span></div>
                <div class="fin-total"><span>TOTAL:</span><span id="lblTotal">$0.00</span></div>
            </div>

            <div class="action-panel">
                <a href="@Url.Action("Index", "Home")" class="btn-big btn-exit"><i class="bi bi-box-arrow-left"></i> SALIR</a>
                <button class="btn-big btn-client" onclick="asignarCliente()"><i class="bi bi-person-fill"></i> Cliente</button>
                <a href="@Url.Action("Index", "Pedidos")" target="_blank" class="btn-big btn-history"><i class="bi bi-clock-history"></i> Historial</a>
                <button class="btn-big btn-cut" onclick="prepararCorte()"><i class="bi bi-calculator"></i> CORTE</button>
                <button class="btn-big btn-reprint" onclick="reimprimirUltimo()"><i class="bi bi-printer-fill"></i> Ticket</button>
                <button id="btnIVAToggle" class="btn-big btn-iva-active" onclick="toggleIVA()"><i class="bi bi-receipt"></i> <span id="txtBtnIva">CON IVA</span></button>
                <button class="btn-big btn-pay" onclick="abrirModalCobro()"><i class="bi bi-cash-stack"></i> COBRAR</button>
            </div>
        </div>

        <div class="mobile-sidebar d-lg-none">
            <a href="/Home/Index" class="btn-mob mob-back"><i class="bi bi-box-arrow-left"></i><span>SALIR</span></a>
            <button class="btn-mob mob-client" onclick="asignarCliente()"><i class="bi bi-person-fill"></i><span>CTE</span></button>
            <button id="btnMobIva" class="btn-mob mob-iva-on" onclick="toggleIVA()"><i class="bi bi-percent"></i><span id="txtMobIva">CON IVA</span></button>
            <a href="@Url.Action("Index", "Pedidos")" class="btn-mob mob-hist"><i class="bi bi-clock-history"></i><span>HIST</span></a>
            <button class="btn-mob mob-del" onclick="limpiarTicket()"><i class="bi bi-trash3"></i><span>BORRAR</span></button>
            <button class="btn-mob mob-cut" onclick="prepararCorte()"><i class="bi bi-file-earmark-bar-graph"></i><span>CORTE</span></button>
            <button class="btn-mob mob-print" onclick="reimprimirUltimo()"><i class="bi bi-printer-fill"></i><span>TICKET</span></button>
            <button class="btn-mob mob-pay" onclick="abrirModalCobro()"><i class="bi bi-cash-stack"></i><span>COBRAR</span></button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // VARIABLES GLOBALES
        let debounceTimer;
        let clienteActual = "";
        let aplicaIVA = true;
        let totalNumerico = 0;
        const CAJA_ABIERTA_ID = @cajaId;
        let ultimoPedidoId = 0;
        let ultimoMontoRecibido = 0;

        // SONIDO BEEP
        function playBeep() { try { const ctx = new (window.AudioContext || window.webkitAudioContext)(); const osc = ctx.createOscillator(); const g = ctx.createGain(); osc.connect(g); g.connect(ctx.destination); osc.frequency.value=1500; g.gain.value=0.05; osc.start(); setTimeout(()=>osc.stop(),80); } catch(e){} }

        // INICIO
        $(document).ready(function() {
            if (CAJA_ABIERTA_ID === 0) {
                new bootstrap.Modal(document.getElementById('modalApertura')).show();
            } else { cargarTicket(); }

            // Teclas Rápidas
            $(document).keydown(function(e) {
                if(e.key === "F12") { e.preventDefault(); abrirModalCobro(); }
                if(e.key === "F2") { e.preventDefault(); $('#inputBusqueda').focus(); }
            });
            // Sync Buscador Móvil
            $('#inputBusquedaMovil').on('keyup', function() { $('#inputBusqueda').val($(this).val()).trigger('keyup'); });
        });

        // FUNCIONES
        function reimprimirUltimo() {
            if(ultimoPedidoId === 0) { Swal.fire('Aviso', 'No hay venta reciente en esta sesión.', 'info'); }
            else { window.open('/Ventas/ImprimirTicketVenta/' + ultimoPedidoId + '?recibido=' + ultimoMontoRecibido, '_blank'); }
        }

        function abrirCaja() {
            const monto = $('#txtFondoInicial').val();
            const token = $('input[name="__RequestVerificationToken"]').val();
            if (!monto || monto < 0) { Swal.fire('Error', 'Monto inválido', 'warning'); return; }
            $.post('/Ventas/AbrirCaja', { montoInicial: monto, "__RequestVerificationToken": token }, function(res) {
                if (res.success) location.reload();
                else Swal.fire('Error', res.message, 'error');
            });
        }

        function prepararCorte() {
            $.get('/Ventas/ObtenerDatosCorte', function(res) {
                if (res.success) {
                    $('#lblCorteInicio').text(fmtMoney(res.inicio)); $('#lblCorteEfectivo').text(fmtMoney(res.efectivo));
                    $('#lblCorteTarjeta').text(fmtMoney(res.tarjeta)); $('#lblCorteEsperado').text(fmtMoney(res.totalEsperado));
                    $('#txtMontoDeclarado').val(''); new bootstrap.Modal(document.getElementById('modalCorte')).show();
                } else Swal.fire('Error', res.message, 'error');
            });
        }

        function cerrarCaja() {
            const monto = $('#txtMontoDeclarado').val();
            const token = $('input[name="__RequestVerificationToken"]').val();
            if (monto === "") { Swal.fire('Ojo', 'Cuenta el dinero', 'warning'); return; }
            Swal.fire({title:'¿Confirmar Cierre?', icon:'warning', showCancelButton:true, confirmButtonText:'Sí, Cerrar'}).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Ventas/CerrarCaja', { montoDeclarado: monto, "__RequestVerificationToken": token }, function(res) {
                        if (res.success) window.location.href="/Home/Index";
                        else Swal.fire('Error', res.message, 'error');
                    });
                }
            });
        }

        function fmtMoney(amount) {
            let val = typeof amount === 'string' ? parseFloat(amount.replace(/,/g, '')) : amount;
            return '$' + val.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }

        function toggleIVA() {
            aplicaIVA = !aplicaIVA;
            const btn = $('#btnIVAToggle'); const txt = $('#txtBtnIva'); const btnMob = $('#btnMobIva'); const txtMob = $('#txtMobIva');
            if (aplicaIVA) { btn.removeClass('btn-iva-inactive').addClass('btn-iva-active'); txt.text('CON IVA'); btnMob.addClass('mob-iva-on'); txtMob.text('CON IVA'); }
            else { btn.removeClass('btn-iva-active').addClass('btn-iva-inactive'); txt.text('SIN IVA'); btnMob.removeClass('mob-iva-on'); txtMob.text('SIN IVA'); }
            recalcularTotalesVisuales();
        }

        function recalcularTotalesVisuales() {
            let subtotal = totalNumerico; let iva = 0; let totalFinal = totalNumerico;
            if (aplicaIVA) { iva = subtotal * 0.16; totalFinal = subtotal + iva; }
            $('#lblSubtotal').text(fmtMoney(subtotal));
            $('#lblIVA').text(fmtMoney(iva));
            $('#lblTotal').text(fmtMoney(totalFinal));
            $('#mobTotalInline').text(fmtMoney(totalFinal));
        }

        // BUSQUEDA
        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer); const term = $(this).val(); const listContainer = $('#contenedorResultados');
            if (term.length < 2) {
                if (window.innerWidth < 992) listContainer.hide();
                if(term.length===0) listContainer.html('<div class="d-none d-lg-flex flex-column align-items-center justify-content-center w-100 h-100 text-muted opacity-50 pt-5"><i class="bi bi-upc-scan" style="font-size:4rem;"></i><h3 class="mt-3 fw-bold">LISTO PARA VENDER</h3></div>');
                return;
            }
            if (window.innerWidth < 992) listContainer.show();
            debounceTimer = setTimeout(() => { $.get('/Ventas/BuscarProductos', { term: term }, function(data) { renderizarResultados(data); }); }, 300);
        });

        function renderizarResultados(productos) {
            const container = $('#contenedorResultados'); container.empty();
            if (productos.length === 0) { container.append('<div class="col-12 text-center py-3 text-muted small">No encontrado</div>'); return; }
            productos.forEach(p => { container.append(`<div id="prod-${p.id}" class="prod-card" onclick="agregarAlTicket(${p.id})"><img src="${p.imagenUrl||'/images/no-image.png'}" class="prod-img"><div class="prod-name">${p.nombre}</div><div class="prod-price">$${p.precioVenta.toFixed(2)}</div></div>`); });
        }

        // TICKET OPS
        function agregarAlTicket(id) {
            playBeep(); const card = $(`#prod-${id}`); card.css('background', '#dcfce7'); setTimeout(() => card.css('background', ''), 200);
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) { if (res.success) cargarTicket(); else Swal.fire({ icon: 'warning', title: 'Stock', text: res.message, toast: true, position: 'top' }); });
        }
        function restarUnidad(id) { $.post('/Ventas/RestarDelTicket', { id: id }, function(res) { if (res.success) cargarTicket(); }); }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                const tbody = $('#tablaTicketBody'); const mobList = $('#mobileTicketList'); tbody.empty(); mobList.empty();
                totalNumerico = parseFloat(data.total.replace(/,/g, ''));
                if(data.count > 0) { $('#emptyTicketMsg').hide(); } else { $('#emptyTicketMsg').show(); mobList.html('<div class="text-center text-muted small py-4 mt-5">Ticket Vacío</div>'); }
                data.items.forEach(item => {
                    const totalItem = (item.precio * item.cantidad).toFixed(2);
                    tbody.append(`<tr><td><div class="fw-bold text-dark small">${item.nombre}</div><div class="text-muted" style="font-size:0.7rem">${item.productoId}</div></td><td class="text-end">$${item.precio.toFixed(2)}</td><td><div class="qty-control"><button class="btn-qty" onclick="restarUnidad(${item.productoId})"><i class="bi bi-dash"></i></button><div class="qty-val">${item.cantidad}</div><button class="btn-qty" onclick="agregarAlTicket(${item.productoId})"><i class="bi bi-plus"></i></button></div></td><td class="text-end fw-bold">$${totalItem}</td><td class="text-center"><i class="bi bi-x-circle-fill text-danger fs-5" style="cursor:pointer" onclick="eliminarDelTicket(${item.productoId})"></i></td></tr>`);
                    mobList.append(`<div class="mt-item"><div class="mt-desc"><div class="fw-bold text-dark">${item.nombre}</div><div class="text-muted" style="font-size:0.7rem">$${item.precio.toFixed(2)} c/u</div></div><div class="mt-qty-box"><div class="mt-btn" onclick="restarUnidad(${item.productoId})">-</div><div>${item.cantidad}</div><div class="mt-btn" onclick="agregarAlTicket(${item.productoId})">+</div></div><div class="mt-total">$${totalItem}</div></div>`);
                });
                recalcularTotalesVisuales();
            });
        }
        function eliminarDelTicket(id) { $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); }); }
        function limpiarTicket() { $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); }); }
        function asignarCliente() { Swal.fire({ title: 'Cliente', input: 'text', inputValue: clienteActual, showCancelButton: true }).then((r) => { if(r.isConfirmed) { clienteActual = r.value; Swal.fire({icon:'success', title: 'Cliente Asignado', text: clienteActual || 'Público', toast: true, position: 'top', timer: 1000}); } }); }

        // COBRO
        function abrirModalCobro() {
            if (totalNumerico <= 0) { Swal.fire('Error', 'Ticket vacío', 'error'); return; }
            const totalConIvaStr = $('#lblTotal').text();
            const textoCliente = clienteActual ? clienteActual : "Público General";

            Swal.fire({
                title: 'Seleccionar Método',
                html: `
                    <p class="mb-3">Cliente: <strong>${textoCliente}</strong><br>Total: <span class="fs-4 fw-bold text-primary">${totalConIvaStr}</span></p>
                    <div class="d-grid gap-3">
                        <button id="btnPagarEfectivo" class="btn btn-lg btn-success py-3 fw-bold shadow"><i class="bi bi-cash-coin me-2"></i> EFECTIVO</button>
                        <button id="btnPagarTarjeta" class="btn btn-lg btn-primary py-3 fw-bold shadow"><i class="bi bi-credit-card-2-front me-2"></i> TARJETA</button>
                    </div>`,
                showConfirmButton: false, showCloseButton: true
            });

            setTimeout(() => {
                document.getElementById('btnPagarEfectivo').onclick = function() {
                    Swal.close();
                    $('#txtTotalEnModal').text(totalConIvaStr);
                    $('#txtMontoRecibido').val('').focus();
                    $('#txtCambioFinal').text('$0.00').removeClass('text-success').addClass('text-danger');
                    $('#btnConfirmarVentaEfectivo').prop('disabled', true);
                    new bootstrap.Modal(document.getElementById('modalCobroEfectivo')).show();
                };
                document.getElementById('btnPagarTarjeta').onclick = function() {
                    Swal.close();
                    // AQUÍ ENTRA LA LÓGICA DE TERMINAL EXTERNA QUE PLATICAMOS
                    procesarVenta('Tarjeta');
                };
            }, 100);
        }

        $('#txtMontoRecibido').on('input', function() {
            const totalStr = $('#txtTotalEnModal').text().replace('$', '').replace(',', '');
            const total = parseFloat(totalStr);
            const recibido = parseFloat($(this).val()) || 0;
            const cambio = recibido - total;

            if (cambio >= 0) {
                $('#txtCambioFinal').text(fmtMoney(cambio)).removeClass('text-danger').addClass('text-success');
                $('#btnConfirmarVentaEfectivo').prop('disabled', false);
            } else {
                $('#txtCambioFinal').text('$0.00').removeClass('text-success').addClass('text-danger');
                $('#btnConfirmarVentaEfectivo').prop('disabled', true);
            }
        });

        $('#btnConfirmarVentaEfectivo').on('click', function() {
            const modalEl = document.getElementById('modalCobroEfectivo');
            bootstrap.Modal.getInstance(modalEl).hide();
            procesarVenta('Efectivo');
        });

        function procesarVenta(metodo) {
            Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.post('/Ventas/FinalizarVenta', {
                nombreCliente: clienteActual,
                metodoPago: metodo,
                aplicaIVA: aplicaIVA,
                "__RequestVerificationToken": token
            }, function(res) {
                if (res.success) {
                    ultimoPedidoId = res.pedidoId;
                    ultimoMontoRecibido = (metodo === 'Efectivo') ? ($('#txtMontoRecibido').val() || 0) : 0;

                    Swal.fire({
                        title: '¡Venta Exitosa!',
                        html: `<h1 class="text-success display-4"><i class="bi bi-check-circle"></i></h1><h3>Folio #${res.pedidoId}</h3><p>Pago: <strong>${metodo}</strong></p>`,
                        showCancelButton: true,
                        confirmButtonText: '🖨️ Imprimir Ticket',
                        cancelButtonText: 'Cerrar',
                        confirmButtonColor: '#1f2937'
                    }).then((result) => {
                        if (result.isConfirmed) { reimprimirUltimo(); }
                        limpiarTicket(); clienteActual = ""; $('#inputBusqueda').val('').focus(); $('#contenedorResultados').empty(); $('#inputBusquedaMovil').val('');
                        if (window.innerWidth < 992) $('#contenedorResultados').hide();
                    });
                } else { Swal.fire('Error', res.message, 'error'); }
            }).fail(function() { Swal.fire('Error', 'No se pudo conectar con el servidor.', 'error'); });
        }
    </script>
</body>
</html>