@{
    ViewData["Title"] = "Punto de Venta";
    Layout = null;
    int cajaId = ViewBag.CajaAbiertaId != null ? (int)ViewBag.CajaAbiertaId : 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>POS - Refaccionaria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* --- ESTILOS BASE (TU ORIGINAL) --- */
        :root {
            --bg-app: #e5e7eb;
            --color-primary: #2563eb;
            --color-success: #16a34a;
            --color-danger: #dc2626;
            --color-dark: #1f2937;
            --color-iva-on: #7c3aed;
        }

        body {
            background-color: var(--bg-app);
            font-family: 'Segoe UI', system-ui, sans-serif;
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
        }

        .pos-wrapper {
            display: flex;
            height: 100%;
            width: 100%;
        }

        .left-panel {
            flex: 60%;
            display: flex;
            flex-direction: column;
            padding: 15px;
            border-right: 1px solid #ccc;
        }

        .right-panel {
            flex: 40%;
            background: #fff;
            display: flex;
            flex-direction: column;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
        }

        .search-area {
            margin-bottom: 15px;
        }

        .search-input {
            height: 60px;
            font-size: 1.5rem;
            font-weight: bold;
            border: 2px solid var(--color-primary);
            border-radius: 4px;
            box-shadow: none !important;
        }

        .products-grid {
            flex-grow: 1;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 10px;
            align-content: start;
            padding-right: 5px;
        }

        .prod-card {
            background: white;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 8px;
            cursor: pointer;
            transition: all 0.1s;
            display: flex;
            flex-direction: column;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

            .prod-card:active {
                transform: scale(0.95);
                border-color: var(--color-success);
            }

        .prod-img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            background: #f3f4f6;
            margin-bottom: 8px;
            border-radius: 2px;
        }

        .prod-name {
            font-size: 0.85rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 5px;
            color: var(--color-dark);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 2.4em;
        }

        .prod-price {
            font-size: 1.1rem;
            font-weight: 900;
            color: var(--color-success);
            text-align: right;
            margin-top: auto;
        }

        .ticket-header {
            background: var(--color-dark);
            color: white;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .ticket-list-container {
            flex-grow: 1;
            overflow-y: auto;
            background: #f9fafb;
        }

        .t-table {
            width: 100%;
            border-collapse: collapse;
        }

            .t-table th {
                background: #e5e7eb;
                position: sticky;
                top: 0;
                padding: 8px;
                font-size: 0.75rem;
                text-transform: uppercase;
                text-align: left;
                color: #374151;
                border-bottom: 1px solid #d1d5db;
            }

            .t-table td {
                padding: 10px 8px;
                border-bottom: 1px solid #e5e7eb;
                vertical-align: middle;
            }

        .qty-control {
            display: flex;
            align-items: center;
            gap: 5px;
            border: 1px solid #d1d5db;
            border-radius: 4px;
            background: white;
            width: fit-content;
        }

        .btn-qty {
            border: none;
            background: transparent;
            color: var(--color-primary);
            font-weight: bold;
            padding: 2px 8px;
            cursor: pointer;
        }

        .qty-val {
            font-weight: bold;
            font-size: 0.9rem;
            width: 20px;
            text-align: center;
        }

        .financial-summary {
            background: #f3f4f6;
            padding: 15px 20px;
            border-top: 2px solid #d1d5db;
        }

        .fin-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: #4b5563;
        }

        .fin-total {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--color-dark);
            align-items: center;
        }

        .action-panel {
            padding: 15px;
            background: white;
            border-top: 1px solid #e5e7eb;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 2fr;
            grid-template-rows: 1fr 1fr;
            gap: 10px;
            height: 160px;
        }

        .btn-big {
            border: none;
            border-radius: 4px;
            font-weight: 700;
            text-transform: uppercase;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.1s;
            color: white;
            font-size: 0.75rem;
            text-decoration: none;
        }

            .btn-big i {
                font-size: 1.3rem;
                margin-bottom: 3px;
            }

        .btn-exit {
            background-color: var(--color-danger);
        }

        .btn-client {
            background-color: #3b82f6;
        }

        .btn-cut {
            background-color: #4b5563;
        }

        .btn-reprint {
            background-color: #6b7280;
        }

        .btn-history {
            background-color: #0891b2;
        }

        .btn-iva-active {
            background-color: var(--color-iva-on);
            color: white;
            border: 2px solid var(--color-iva-on);
        }

        .btn-iva-inactive {
            background-color: white;
            color: #9ca3af;
            border: 2px solid #e5e7eb;
        }

        .btn-pay {
            background-color: var(--color-success);
            grid-column: 4;
            grid-row: 1 / span 2;
            font-size: 1.5rem;
        }

        /* MÓVIL */
        @@media (max-width: 991.98px) {
            .pos-wrapper {
                display: grid;
                grid-template-columns: 1fr 110px;
                height: 100vh;
                overflow: hidden;
            }

            .left-panel {
                padding: 0;
                border: none;
                border-right: 2px solid #ccc;
            }

            .mobile-search-bar {
                display: flex;
                align-items: center;
                padding: 10px;
                background: white;
                border-bottom: 1px solid #ddd;
                height: 60px;
            }

            .mobile-input {
                width: 100%;
                height: 40px;
                border-radius: 8px;
                border: 1px solid #ccc;
                padding-left: 10px;
                font-weight: bold;
                background: #f9fafb;
            }

            .mobile-ticket-inline {
                display: flex;
                flex-direction: column;
                background: #f9fafb;
                flex: 1 1 auto;
                min-height: 0;
                overflow: hidden;
            }

            .m-ticket-header {
                background: #374151;
                color: white;
                padding: 8px 10px;
                font-size: 0.85rem;
                font-weight: bold;
                display: flex;
                justify-content: space-between;
            }

            .m-ticket-body {
                flex: 1;
                overflow-y: auto;
                padding: 0;
            }

            .mt-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #e5e7eb;
                padding: 10px;
                font-size: 0.85rem;
                background: white;
            }

            .mobile-sidebar {
                display: flex;
                flex-direction: column;
                background: var(--color-dark);
                padding: 8px;
                gap: 8px;
                align-items: center;
                z-index: 100;
                overflow-y: auto;
            }

            .btn-mob {
                width: 100%;
                height: 55px;
                border-radius: 10px;
                border: none;
                background: rgba(255,255,255,0.1);
                color: white;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-size: 0.65rem;
                font-weight: bold;
                text-decoration: none;
            }

            .mob-pay {
                background: var(--color-success);
                height: 80px;
            }

            .right-panel {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="modal fade" id="modalApertura" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white"><h5 class="modal-title fw-bold">APERTURA DE CAJA</h5></div>
                <div class="modal-body p-4 text-center">
                    <p class="text-muted mb-3">Ingresa el fondo inicial.</p>
                    <div class="form-floating mb-3"><input type="number" class="form-control fs-1 fw-bold text-center text-primary" id="txtFondoInicial" value="500"><label>Fondo Inicial ($)</label></div>
                    <button class="btn btn-primary btn-lg w-100 py-3 fw-bold" onclick="abrirCaja()">ABRIR CAJA</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCorte" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white"><h5 class="modal-title fw-bold">CORTE DE CAJA</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between mb-2"><span>Fondo Inicial:</span><strong id="lblCorteInicio">$0.00</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>Ventas Efectivo:</span><strong class="text-success" id="lblCorteEfectivo">$0.00</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>Ventas Tarjeta:</span><strong class="text-primary" id="lblCorteTarjeta">$0.00</strong></div>
                    <hr>
                    <label class="form-label fw-bold">EFECTIVO CONTADO (REAL)</label>
                    <input type="number" class="form-control fs-1 fw-bold text-center border-dark mb-3" id="txtMontoDeclarado">
                    <button class="btn btn-danger btn-lg w-100 py-3 fw-bold" onclick="cerrarCaja()">CERRAR TURNO</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalFeria" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i> COBRO EN EFECTIVO</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <span class="text-muted small fw-bold">TOTAL A COBRAR</span>
                    <h1 class="display-4 fw-black text-dark mb-4" id="feriaTotalPagar">$0.00</h1>

                    <div class="form-group mb-3">
                        <label class="fw-bold text-success">RECIBIDO DEL CLIENTE:</label>
                        <input type="number" id="feriaMontoRecibido" class="form-control form-control-lg fs-1 fw-bold text-center border-success" placeholder="0.00" autofocus>
                    </div>

                    <div class="bg-light p-3 rounded border mb-4">
                        <span class="text-muted small fw-bold">CAMBIO A ENTREGAR (FERIA):</span>
                        <h2 class="display-6 fw-bold text-danger" id="feriaCambio">$0.00</h2>
                    </div>

                    <button id="btnFinalizarFeria" class="btn btn-success btn-lg w-100 py-3 fw-bold" disabled>CONFIRMAR Y FINALIZAR</button>
                </div>
            </div>
        </div>
    </div>

    <div class="pos-wrapper">
        <div class="left-panel">
            <div class="search-area d-none d-lg-block">
                <div class="input-group">
                    <span class="input-group-text bg-white border-2 border-primary border-end-0"><i class="bi bi-search fs-4 text-primary"></i></span>
                    <input type="text" id="inputBusqueda" class="form-control search-input border-start-0 ps-0" placeholder="BUSCAR / ESCANEAR (F2)..." autocomplete="off" autofocus>
                    <button class="btn btn-light border-2 border-start-0" onclick="$('#inputBusqueda').val('').focus()"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div class="mobile-search-bar"><input type="text" id="inputBusquedaMovil" class="mobile-input" placeholder="🔍 Buscar..."></div>
            <div id="contenedorResultados" class="products-grid"></div>

            <div class="mobile-ticket-inline">
                <div class="m-ticket-header"><span>TICKET ACTUAL</span><span id="mobTotalInline" class="text-warning">$0.00</span></div>
                <div id="mobileTicketList" class="m-ticket-body"></div>
            </div>
        </div>

        <div class="right-panel d-none d-lg-flex">
            <div class="ticket-header">
                <div class="fw-bold"><i class="bi bi-cart3 me-2"></i> TICKET (Caja #@cajaId)</div>
                <button onclick="limpiarTicket()" class="btn btn-sm btn-outline-light border-0"><i class="bi bi-trash3"></i></button>
            </div>
            <div class="ticket-list-container">
                <table class="t-table">
                    <thead><tr><th style="width:45%;">Descripción</th><th style="width:20%;">Precio</th><th style="width:20%;">Cant.</th><th style="width:15%;">Total</th><th></th></tr></thead>
                    <tbody id="tablaTicketBody"></tbody>
                </table>
                <div id="emptyTicketMsg" class="text-center py-5 text-muted"><p>Ticket Vacío</p></div>
            </div>
            <div class="financial-summary">
                <div class="fin-row"><span>Subtotal</span><span id="lblSubtotal">$0.00</span></div>
                <div class="fin-row"><span>IVA (16%)</span><span id="lblIVA">$0.00</span></div>
                <div class="fin-total"><span>TOTAL:</span><span id="lblTotal">$0.00</span></div>
            </div>

            <div class="action-panel">
                <a href="@Url.Action("Index", "Home")" class="btn-big btn-exit"><i class="bi bi-box-arrow-left"></i> SALIR</a>
                <button class="btn-big btn-client" onclick="asignarCliente()"><i class="bi bi-person-fill"></i> Cliente</button>
                <a href="@Url.Action("Index", "Pedidos")" target="_blank" class="btn-big btn-history"><i class="bi bi-clock-history"></i> Historial</a>
                <button class="btn-big btn-cut" onclick="prepararCorte()"><i class="bi bi-calculator"></i> CORTE</button>
                <button class="btn-big btn-reprint" onclick="reimprimirUltimo()"><i class="bi bi-printer-fill"></i> Ticket</button>
                <button id="btnIVAToggle" class="btn-big btn-iva-active" onclick="toggleIVA()"><i class="bi bi-receipt"></i> <span id="txtBtnIva">CON IVA</span></button>
                <button class="btn-big btn-pay" onclick="abrirModalCobro()"><i class="bi bi-cash-stack"></i> COBRAR</button>
            </div>
        </div>

        <div class="mobile-sidebar">
            <a href="/Home/Index" class="btn-mob mob-back"><i class="bi bi-box-arrow-left"></i><span>SALIR</span></a>
            <button class="btn-mob mob-client" onclick="asignarCliente()"><i class="bi bi-person-fill"></i><span>CTE</span></button>
            <button class="btn-mob mob-pay" onclick="abrirModalCobro()"><i class="bi bi-cash-stack"></i><span>COBRAR</span></button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let debounceTimer;
        let clienteActual = "";
        let aplicaIVA = true;
        let totalNumerico = 0;
        const CAJA_ABIERTA_ID = @cajaId;
        let ultimoPedidoId = 0;

        function playBeep() { try { const ctx = new (window.AudioContext || window.webkitAudioContext)(); const osc = ctx.createOscillator(); const g = ctx.createGain(); osc.connect(g); g.connect(ctx.destination); osc.frequency.value=1500; g.gain.value=0.05; osc.start(); setTimeout(()=>osc.stop(),80); } catch(e){} }

        $(document).ready(function() {
            if (CAJA_ABIERTA_ID === 0) {
                new bootstrap.Modal(document.getElementById('modalApertura')).show();
            } else { cargarTicket(); }

            $(document).keydown(function(e) {
                if(e.key === "F12") { e.preventDefault(); abrirModalCobro(); }
                if(e.key === "F2") { e.preventDefault(); $('#inputBusqueda').focus(); }
            });

            $('#inputBusquedaMovil').on('keyup', function() { $('#inputBusqueda').val($(this).val()).trigger('keyup'); });
        });

        // --- CAJA Y CORTE (TU LÓGICA ORIGINAL) ---
        function abrirCaja() {
            const monto = $('#txtFondoInicial').val();
            if (!monto || monto < 0) { Swal.fire('Monto inválido', '', 'warning'); return; }
            $.post('/Ventas/AbrirCaja', { montoInicial: monto }, function(res) { if (res.success) location.reload(); });
        }

        function prepararCorte() {
            $.get('/Ventas/ObtenerDatosCorte', function(res) {
                if (res.success) {
                    $('#lblCorteInicio').text(fmtMoney(res.inicio)); $('#lblCorteEfectivo').text(fmtMoney(res.efectivo));
                    $('#lblCorteTarjeta').text(fmtMoney(res.tarjeta)); $('#lblCorteEsperado').text(fmtMoney(res.totalEsperado));
                    new bootstrap.Modal(document.getElementById('modalCorte')).show();
                }
            });
        }

        function cerrarCaja() {
            const monto = $('#txtMontoDeclarado').val();
            if (monto === "") return;
            $.post('/Ventas/CerrarCaja', { montoDeclarado: monto }, function(res) { if (res.success) window.location.href="/Home/Index"; });
        }

        function fmtMoney(amount) { return '$' + amount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }

        // --- MANEJO DE TICKET ---
        function toggleIVA() {
            aplicaIVA = !aplicaIVA;
            $('#btnIVAToggle').toggleClass('btn-iva-active btn-iva-inactive');
            $('#txtBtnIva').text(aplicaIVA ? 'CON IVA' : 'SIN IVA');
            recalcularTotalesVisuales();
        }

        function recalcularTotalesVisuales() {
            let subtotal = totalNumerico;
            let iva = aplicaIVA ? subtotal * 0.16 : 0;
            let totalFinal = subtotal + iva;
            $('#lblSubtotal').text(fmtMoney(subtotal));
            $('#lblIVA').text(fmtMoney(iva));
            $('#lblTotal').text(fmtMoney(totalFinal));
            $('#mobTotalInline').text(fmtMoney(totalFinal));
        }

        $('#inputBusqueda').on('keyup', function() {
            clearTimeout(debounceTimer);
            const term = $(this).val();
            if (term.length < 2) return;
            debounceTimer = setTimeout(() => {
                $.get('/Ventas/BuscarProductos', { term: term }, function(data) {
                    const container = $('#contenedorResultados');
                    container.empty();
                    data.forEach(p => {
                        container.append(`<div class="prod-card" onclick="agregarAlTicket(${p.id})"><img src="${p.imagenUrl||'/images/no-image.png'}" class="prod-img"><div class="prod-name">${p.nombre}</div><div class="prod-price">$${p.precioVenta.toFixed(2)}</div></div>`);
                    });
                });
            }, 300);
        });

        function agregarAlTicket(id) {
            playBeep();
            $.post('/Ventas/AgregarAlTicket', { id: id }, function(res) { if (res.success) cargarTicket(); });
        }

        function cargarTicket() {
            $.get('/Ventas/ObtenerTicket', function(data) {
                const tbody = $('#tablaTicketBody'); const mobList = $('#mobileTicketList');
                tbody.empty(); mobList.empty();
                totalNumerico = parseFloat(data.total.replace(/,/g, ''));
                data.items.forEach(item => {
                    const sub = (item.precio * item.cantidad).toFixed(2);
                    tbody.append(`<tr><td>${item.nombre}</td><td>$${item.precio.toFixed(2)}</td><td>${item.cantidad}</td><td class="fw-bold">$${sub}</td><td><i class="bi bi-x-circle text-danger" onclick="eliminarDelTicket(${item.productoId})"></i></td></tr>`);
                    mobList.append(`<div class="mt-item"><div><b>${item.nombre}</b><br><small>$${item.precio.toFixed(2)} x ${item.cantidad}</small></div><div class="fw-bold">$${sub}</div></div>`);
                });
                recalcularTotalesVisuales();
            });
        }

        function eliminarDelTicket(id) { $.post('/Ventas/EliminarDelTicket', { id: id }, function() { cargarTicket(); }); }
        function limpiarTicket() { $.post('/Ventas/LimpiarTicket', function() { cargarTicket(); }); }
        function asignarCliente() { Swal.fire({ title: 'Cliente', input: 'text', inputValue: clienteActual }).then(r => { if(r.isConfirmed) clienteActual = r.value; }); }
        function reimprimirUltimo() { if(ultimoPedidoId > 0) window.open('/Ventas/ImprimirTicketVenta/' + ultimoPedidoId, '_blank'); }

        // ==========================================
        // PROCESO DE COBRO DINÁMICO (FERIA VS DIRECTO)
        // ==========================================

        function abrirModalCobro() {
            if (totalNumerico <= 0) { Swal.fire('Ticket vacío', '', 'error'); return; }
            const totalActual = $('#lblTotal').text();

            Swal.fire({
                title: 'Cobrar ' + totalActual,
                html: `
                    <div class="d-grid gap-2">
                        <button id="btnEfectivo" class="btn btn-success btn-lg py-3 fw-bold"><i class="bi bi-cash"></i> EFECTIVO (Mostrador)</button>
                        <button id="btnTarjeta" class="btn btn-primary btn-lg py-3 fw-bold"><i class="bi bi-credit-card"></i> TARJETA / LÍNEA</button>
                    </div>`,
                showConfirmButton: false, showCloseButton: true
            });

            setTimeout(() => {
                // FLUJO EFECTIVO: Abrir modal de Feria
                document.getElementById('btnEfectivo').onclick = function() {
                    Swal.close();
                    $('#feriaTotalPagar').text(totalActual);
                    $('#feriaMontoRecibido').val('').focus();
                    $('#feriaCambio').text('$0.00').removeClass('text-success').addClass('text-danger');
                    $('#btnFinalizarFeria').prop('disabled', true);
                    new bootstrap.Modal(document.getElementById('modalFeria')).show();
                };

                // FLUJO TARJETA: Proceso directo (Monto exacto)
                document.getElementById('btnTarjeta').onclick = function() {
                    Swal.close();
                    procesarVenta('Tarjeta');
                };
            }, 100);
        }

        // Script para calcular cambio en tiempo real
        $('#feriaMontoRecibido').on('input', function() {
            const total = parseFloat($('#feriaTotalPagar').text().replace('$', '').replace(',', ''));
            const recibido = parseFloat($(this).val()) || 0;
            const cambio = recibido - total;

            if (cambio >= 0) {
                $('#feriaCambio').text(fmtMoney(cambio)).removeClass('text-danger').addClass('text-success');
                $('#btnFinalizarFeria').prop('disabled', false);
            } else {
                $('#feriaCambio').text('$0.00').removeClass('text-success').addClass('text-danger');
                $('#btnFinalizarFeria').prop('disabled', true);
            }
        });

        $('#btnFinalizarFeria').click(function() {
            bootstrap.Modal.getInstance(document.getElementById('modalFeria')).hide();
            procesarVenta('Efectivo');
        });

        // ESTA FUNCIÓN ES LA QUE CONECTA CON TU CONTROLLER (KARDEX, STOCK, ETC)
        function procesarVenta(metodo) {
            Swal.fire({ title: 'Procesando...', didOpen: () => Swal.showLoading() });

            $.post('/Ventas/FinalizarVenta', {
                nombreCliente: clienteActual,
                metodoPago: metodo,
                aplicaIVA: aplicaIVA
            }, function(res) {
                if (res.success) {
                    ultimoPedidoId = res.pedidoId;
                    Swal.fire({ icon: 'success', title: 'Venta Exitosa', text: 'Folio: #' + res.pedidoId, confirmButtonText: 'Ticket' }).then((r) => {
                        if (r.isConfirmed) window.open('/Ventas/ImprimirTicketVenta/' + res.pedidoId, '_blank');
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }
    </script>
</body>
</html>