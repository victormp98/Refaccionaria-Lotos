@model RefaccionariaWeb.Models.Pedido
@{
    Layout = null;

    // 1. LÓGICA MATEMÁTICA PARA DESGLOSAR EL IVA
    // Buscamos si en la dirección (donde guardamos info extra) dice "Con IVA"
    bool llevaIVA = Model.DireccionEnvio != null && Model.DireccionEnvio.Contains("Con IVA");
    
    decimal total = Model.TotalPedido;
    decimal subtotal = total;
    decimal iva = 0;

    if (llevaIVA)
    {
        subtotal = total / 1.16m; // Desglosamos hacia atrás
        iva = total - subtotal;
    }

    // 2. DETECTAR MÉTODO DE PAGO
    string metodoPago = "Desconocido";
    if (Model.DireccionEnvio.Contains("Efectivo")) { metodoPago = "EFECTIVO"; }
    else if (Model.DireccionEnvio.Contains("Tarjeta")) { metodoPago = "TARJETA"; }

    // 3. RECIBIR EL "DINERO ENTREGADO" DESDE LA URL (Truco para mostrar la feria)
    // Cuando llames a esta vista, podrás pasar ?recibido=500
    decimal recibido = 0;
    decimal cambio = 0;
    string recibidoStr = Context.Request.Query["recibido"];
    
    if (decimal.TryParse(recibidoStr, out recibido))
    {
        cambio = recibido - total;
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ticket #@Model.Id</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            margin: 0;
            padding: 0;
            background: #eee;
            display: flex;
            justify-content: center; /* Centrar en pantalla PC */
        }

        .ticket {
            background: white;
            width: 76mm; /* Ancho seguro para impresora de 80mm (dejando 2mm de cada lado) */
            padding: 5px 10px; /* Margen interno para que no se pegue al borde */
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            margin-top: 20px;
        }

        .center { text-align: center; }
        .right { text-align: right; }
        .bold { font-weight: bold; }
        
        .header-title { font-size: 16px; font-weight: 900; margin-bottom: 5px; }
        .header-info { font-size: 10px; color: #333; margin-bottom: 2px; }

        .divider {
            border-bottom: 1px dashed #000;
            margin: 8px 0;
        }

        .row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3px;
        }

        .prod-table { width: 100%; border-collapse: collapse; margin-top: 5px; }
        .prod-table th { text-align: left; border-bottom: 1px solid #000; font-size: 10px; }
        .prod-table td { vertical-align: top; padding-top: 4px; font-size: 11px; }
        .col-cant { width: 15%; text-align: center; }
        .col-desc { width: 55%; }
        .col-imp { width: 30%; text-align: right; }

        .totals-section { margin-top: 10px; }
        .total-row { display: flex; justify-content: space-between; font-size: 12px; }
        .total-big { 
            font-size: 18px; 
            font-weight: 900; 
            border-top: 2px solid #000; 
            padding-top: 5px; 
            margin-top: 5px; 
        }

        .payment-info {
            margin-top: 10px;
            border: 1px solid #000;
            padding: 5px;
            font-size: 11px;
        }

        .no-print {
            position: fixed;
            top: 10px;
            right: 10px;
            display: flex;
            gap: 10px;
            background: rgba(255,255,255,0.8);
            padding: 10px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
        }

        .btn { padding: 8px 15px; border-radius: 5px; cursor: pointer; font-weight: bold; border: none; font-size: 12px; }
        .btn-print { background: #000; color: white; }
        .btn-close { background: white; border: 1px solid #000; }

        /* --- AQUÍ ESTÁ LA MAGIA PARA LA IMPRESORA --- */
        @@media print {
            body { 
                background: white; 
                margin: 0; 
                padding: 0; 
            }
            .ticket { 
                box-shadow: none; 
                margin: 0; 
                width: 100%; /* Ocupa el ancho disponible del papel */
                padding: 2mm 5mm 0 2mm; /* ARRIBA DERECHA ABAJO IZQUIERDA */
                /* Ajuste clave: 5mm a la derecha y 2mm a la izquierda */
            }
            .no-print { display: none; }
            @@page { 
                margin: 0; 
                size: auto; 
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()" class="btn btn-print">🖨️ IMPRIMIR</button>
        <button onclick="window.close()" class="btn btn-close">CERRAR</button>
    </div>

    <div class="ticket">
        <div class="center">
            <div class="header-title">REFACCIONARIA UT</div>
            <div class="header-info">RFC: XAXX-010101-000</div> <div class="header-info">Calle Principal #123, Centro</div>
            <div class="header-info">Reynosa, Tamaulipas. CP 88500</div>
            <div class="header-info">Tel: (899) 123-4567</div>
        </div>

        <div class="divider"></div>

        <div class="row"><span>FOLIO:</span> <span class="bold">#@Model.Id</span></div>
        <div class="row"><span>FECHA:</span> <span>@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span></div>
        <div class="row"><span>CLIENTE:</span> <span style="max-width: 150px; text-align:right;">@(Model.NombreReceptor ?? "Público General")</span></div>
        
        <div class="divider"></div>

        <table class="prod-table">
            <thead>
                <tr>
                    <th class="col-cant">C.</th>
                    <th class="col-desc">DESCRIPCIÓN</th>
                    <th class="col-imp">IMPORTE</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Detalles)
                {
                    <tr>
                        <td class="col-cant">@item.Cantidad</td>
                        <td class="col-desc">
                            <span class="bold">@item.Producto.Nombre</span><br>
                            <span style="font-size:9px;">PU: $@item.PrecioUnitario.ToString("N2")</span>
                        </td>
                        <td class="col-imp">$@((item.Cantidad * item.PrecioUnitario).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="divider"></div>

        <div class="totals-section">
            @if (llevaIVA)
            {
                <div class="total-row"><span>SUBTOTAL:</span> <span>$@subtotal.ToString("N2")</span></div>
                <div class="total-row"><span>IVA (16%):</span> <span>$@iva.ToString("N2")</span></div>
            }
            
            <div class="row total-big">
                <span>TOTAL:</span>
                <span>$@total.ToString("N2")</span>
            </div>
        </div>

        <div class="payment-info">
            <div class="row"><span>FORMA PAGO:</span> <span class="bold">@metodoPago</span></div>
            
            @if (recibido > 0)
            {
                <div class="row"><span>EFECTIVO:</span> <span>$@recibido.ToString("N2")</span></div>
                <div class="row"><span>CAMBIO:</span> <span class="bold">$@cambio.ToString("N2")</span></div>
            }
        </div>

        <div class="center" style="margin-top:20px; font-size:11px;">
            ¡GRACIAS POR SU PREFERENCIA!<br>
            <div style="font-size:9px; margin-top:5px;">
                CUALQUIER DUDA O ACLARACIÓN<br>
                PRESENTAR ESTE TICKET.
            </div>
            <div style="margin-top:10px;">www.refaccionaria-ut.com</div>
        </div>
        <div class="center">.</div>
    </div>
</body>
</html>