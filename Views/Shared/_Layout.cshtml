@using RefaccionariaWeb.Extensions
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RefaccionariaUt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* ESTILOS PC */
        .nav-pc-link {
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: 0.2s;
            display: flex;
            align-items: center;
            color: #333;
            text-decoration: none;
        }

            .nav-pc-link:hover {
                background: #f8f9fa;
                color: #2E86C1 !important;
            }

        /* ESTILOS MÓVIL Y BARRA INFERIOR */
        @@media (max-width: 991.98px) {
            .nav-mobile-bottom {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                height: 70px;
                background: white;
                display: flex;
                justify-content: space-around;
                align-items: center;
                box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
                z-index: 4000;
                border-top: 1px solid #f0f0f0;
            }

            .nav-mobile-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                color: #666;
                font-size: 0.75rem;
                text-decoration: none !important;
                flex: 1;
            }

                .nav-mobile-item i {
                    font-size: 1.4rem;
                    color: #2E86C1;
                }

            body {
                padding-bottom: 85px !important;
            }
        }

        #ml-menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100% - 70px);
            background: #f4f4f4;
            z-index: 3000;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

            #ml-menu-overlay.active {
                transform: translateX(0);
            }

        .ml-menu-header {
            background: linear-gradient(135deg, #2E86C1 0%, #1B2631 100%);
            color: white;
            padding: 2.5rem 1.5rem 1.8rem;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
        }

        .ml-menu-close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            font-size: 2.5rem;
            color: white;
            cursor: pointer;
        }

        .ml-menu-item {
            display: flex;
            align-items: center;
            padding: 1rem 1.2rem;
            color: #333;
            text-decoration: none !important;
            border-bottom: 1px solid #f8f8f8;
            background: white;
            margin-bottom: 2px;
        }

            .ml-menu-item i {
                font-size: 1.3rem;
                margin-right: 1.2rem;
                color: #2E86C1;
                width: 25px;
                text-align: center;
            }
    </style>
</head>
<body class="bg-light">

    @* MENÚ LATERAL (MOBILE OVERLAY) *@
    <div id="ml-menu-overlay">
        <div class="ml-menu-header shadow">
            <span class="ml-menu-close" onclick="toggleMLMenu()">&times;</span>
            <div class="d-flex align-items-center mt-2">
                <div class="bg-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                    <i class="bi bi-person-circle text-primary fs-2"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-white">Hola, @(User.Identity.IsAuthenticated? User.Identity.Name : "Invitado")</h5>
                    <p class="mb-0 small text-white opacity-75">Refaccionaria Lotos</p>
                </div>
            </div>
        </div>

        <div class="p-3">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="rounded-4 overflow-hidden shadow-sm">
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack"></i> Ventas</a>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed"></i> Almacén</a>
                    <a class="ml-menu-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a>
                    <a class="ml-menu-item" asp-controller="Scraps" asp-action="Index"><i class="bi bi-trash3 text-danger"></i> Reportar Scrap</a>
                </div>
            }
        </div>
        <div class="mt-auto p-4 bg-white border-top">
            <partial name="_LoginPartial" />
        </div>
    </div>

    @* NAVBAR PRINCIPAL (PC Y MÓVIL SUPERIOR) *@
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-light py-2">
            <div class="container-fluid px-3">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-gear-wide-connected text-primary"></i> RefaccionariaUt
                    </a>
                    @* AQUÍ RECUPERAMOS LOS BOTONES DE LOGIN PARA PC *@
                    <div class="d-none d-lg-block">
                        <partial name="_LoginPartial" />
                    </div>
                </div>

                @* BUSCADOR GLOBAL (Solo si no es Almacén) *@
                @if (!User.IsInRole("Almacen"))
                {
                    <div class="row justify-content-center w-100 mt-2 mx-0">
                        <div class="col-12 col-lg-8">
                            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex rounded-pill border bg-light overflow-hidden shadow-sm">
                                <input name="searchString" class="form-control border-0 bg-transparent px-3 py-1" type="search" placeholder="Buscar refacción...">
                                <button class="btn border-0 text-muted" type="submit"><i class="bi bi-search"></i></button>
                            </form>
                        </div>
                    </div>
                }

                @* NAVEGACIÓN PC (CENTRAL) *@
                <div class="d-none d-lg-flex justify-content-center w-100 mt-2 border-top pt-2 gap-2">
                    <a class="nav-pc-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-2 text-primary"></i> Catálogo</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
                        {
                            <a class="nav-pc-link" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack me-2 text-primary"></i> Ventas</a>
                            <a class="nav-pc-link" asp-controller="Scraps" asp-action="Index"><i class="bi bi-trash3 me-2 text-danger"></i> Scrap</a>
                        }
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mb-5 mt-3">
        <main role="main">@RenderBody()</main>
    </div>

    @* BARRA MÓVIL INFERIOR PERSISTENTE *@
    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account")
    {
        <div class="nav-mobile-bottom d-lg-none">
            <a asp-controller="Home" asp-action="Index" class="nav-mobile-item"><i class="bi bi-house"></i><span>Inicio</span></a>
            @if (User.IsInRole("Almacen"))
            {
                <a asp-controller="Pedidos" asp-action="Almacen" class="nav-mobile-item"><i class="bi bi-truck-flatbed"></i><span>Surtir</span></a>
            }
            else if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
            {
                <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Almacen"))
            {
                <a asp-controller="Scraps" asp-action="Index" class="nav-mobile-item"><i class="bi bi-trash3 text-danger"></i><span>Scrap</span></a>
            }
            <a href="javascript:void(0)" class="nav-mobile-item" onclick="toggleMLMenu()"><i class="bi bi-list"></i><span>Menú</span></a>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleMLMenu() {
            var menu = document.getElementById('ml-menu-overlay');
            if(menu) {
                menu.classList.toggle('active');
                document.body.classList.toggle('no-scroll');
            }
        }
    </script>
</body>
</html>