<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lotos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .nav-pc-link {
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: 0.2s;
            display: flex;
            align-items: center;
        }

            .nav-pc-link:hover {
                background: #f8f9fa;
                color: #2E86C1 !important;
            }

            .nav-pc-link i {
                font-size: 1.1rem;
            }

        .search-container {
            position: relative;
            pointer-events: none;
        }

            .search-container form {
                pointer-events: auto;
            }

        @@media (max-width: 767.98px) {
            .nav-mobile-bottom {
                z-index: 2010; /* Elevado para estar sobre el overlay */
            }

            body {
                padding-bottom: 140px !important;
            }
        }

        /* --- ESTILOS MENÚ FULL SCREEN (ML STYLE) --- */
        #ml-menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100% - 70px); /* Deja espacio para el nav inferior */
            background: #fff;
            z-index: 2000;
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

            #ml-menu-overlay.active {
                transform: translateX(0);
            }

        .ml-menu-header {
            background: linear-gradient(135deg, #2E86C1 0%, #1B2631 100%);
            color: white;
            padding: 2rem 1.5rem;
            position: relative;
        }

        .ml-menu-close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            font-size: 2rem;
            color: white;
            cursor: pointer;
        }

        .ml-menu-section {
            padding: 1.5rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .ml-menu-section-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: #999;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: 1px;
        }

        .ml-menu-item {
            display: flex;
            align-items: center;
            padding: 0.8rem 0;
            color: #333;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 500;
        }

            .ml-menu-item i {
                font-size: 1.4rem;
                margin-right: 1rem;
                color: #2E86C1;
                width: 30px;
                text-align: center;
            }
    </style>
</head>
<body class="bg-light">
    @* --- MENÚ FULL SCREEN OVERLAY --- *@
    <div id="ml-menu-overlay">
        <div class="ml-menu-header">
            <span class="ml-menu-close" onclick="toggleMLMenu()">&times;</span>
            <div class="d-flex align-items-center mt-2">
                <div class="bg-white rounded-circle p-2 me-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-person-fill text-primary fs-2"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-bold">Hola, @(User.Identity.IsAuthenticated? User.Identity.Name : "Invitado")</h4>
                    <p class="mb-0 small opacity-75">RefaccionariaUt Panel</p>
                </div>
            </div>
        </div>

        @if (User.Identity.IsAuthenticated)
        {
            @* SECCIÓN PARA CLIENTES (Para que no se vea vacío) *@
            @if (User.IsInRole("Cliente"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Mi Cuenta</div>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index">
                        <i class="bi bi-bag-check"></i> Mis Pedidos
                    </a>
                    <a class="ml-menu-item" href="#">
                        <i class="bi bi-person-gear"></i> Mis Datos (Próximamente)
                    </a>
                    <a class="ml-menu-item" href="#">
                        <i class="bi bi-geo-alt"></i> Direcciones Guardadas
                    </a>
                </div>
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Soporte</div>
                    <a class="ml-menu-item" href="#">
                        <i class="bi bi-question-circle"></i> Ayuda / FAQ
                    </a>
                </div>
            }

            @* SECCIÓN LOGÍSTICA (Admin, Almacén, Mostrador) *@
            @if (User.IsInRole("Admin") || User.IsInRole("Almacen") || User.IsInRole("Mostrador"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Logística y Almacén</div>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Almacen">
                        <i class="bi bi-truck-flatbed"></i> Panel Almacén
                    </a>
                    <a class="ml-menu-item" href="#">
                        <i class="bi bi-trash3 text-danger"></i> Reportes de Scrap (Próximamente)
                    </a>
                </div>
            }

            @* SECCIÓN VENTAS (Admin, Mostrador) *@
            @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Gestión de Ventas</div>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Monitor de Ventas
                    </a>
                    <a class="ml-menu-item" href="#">
                        <i class="bi bi-pc-display-horizontal"></i> Venta Mostrador
                    </a>
                </div>

                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Catálogo y Stock</div>
                    <a class="ml-menu-item" asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Inventario
                    </a>
                    <a class="ml-menu-item" asp-controller="Vehiculos" asp-action="Index">
                        <i class="bi bi-car-front"></i> Vehículos
                    </a>
                    <a class="ml-menu-item" asp-controller="Compatibilidades" asp-action="Index">
                        <i class="bi bi-diagram-3"></i> Relaciones
                    </a>
                </div>
            }

            @* SECCIÓN ADMIN *@
            @if (User.IsInRole("Admin"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Configuración</div>
                    <a class="ml-menu-item" asp-controller="Configuracion" asp-action="Edit">
                        <i class="bi bi-shop"></i> Mi Tienda
                    </a>
                    <a class="ml-menu-item" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people"></i> Personal
                    </a>
                </div>
            }
        }

        <div class="ml-menu-section mt-auto bg-light">
            <partial name="_LoginPartial" />
        </div>
    </div>

    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-light py-2">
            <div class="container-fluid px-3">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-gear-wide-connected text-primary"></i> RefaccionariaUt
                    </a>
                    <div class="ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>

                @if (!User.IsInRole("Almacen"))
                {
                    <div class="search-container row justify-content-center w-100 mt-2 mx-0">
                        <div class="col-12 col-lg-8 px-1">
                            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex rounded-pill border bg-light w-100 overflow-hidden shadow-sm">
                                <input name="searchString" class="form-control border-0 bg-transparent px-3 py-2" type="search" placeholder="Buscar refacciones...">
                                <button class="btn border-0 text-muted" type="submit"><i class="bi bi-search"></i></button>
                            </form>
                        </div>
                    </div>
                }

                <div class="d-none d-lg-flex justify-content-center w-100 mt-2 border-top pt-2">
                    @if (!User.IsInRole("Almacen"))
                    {
                        <a class="nav-link text-dark nav-pc-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid me-2 text-primary"></i> Catálogo
                        </a>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Index">
                                <i class="bi bi-cash-stack me-2 text-primary"></i> Ventas
                            </a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Almacen") || User.IsInRole("Mostrador"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Almacen">
                                <i class="bi bi-truck-flatbed me-2 text-primary"></i> Almacén
                            </a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Productos" asp-action="Index">
                                <i class="bi bi-box-seam me-2 text-primary"></i> Inventario
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people me-2 text-primary"></i> Personal
                            </a>
                        }

                        @if (User.IsInRole("Cliente"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Index">
                                <i class="bi bi-bag-check me-2 text-primary"></i> Mis Pedidos
                            </a>
                            <a class="nav-link text-dark nav-pc-link fs-6 px-3 position-relative" asp-controller="Carrito" asp-action="Index">
                                <i class="bi bi-cart3 me-2 text-primary"></i> Mi Carrito
                                @{
                                    var cPC = Context.Session.GetObject<List<RefaccionariaWeb.Models.DTOs.ItemCarrito>>("Carrito");
                                    var tPC = cPC?.Sum(x => x.Cantidad) ?? 0;
                                }
                                @if (tPC > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem">@tPC</span>
                                }
                            </a>
                        }
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mb-5 mt-3">
        <main role="main">@RenderBody()</main>
    </div>

    @* BARRA MÓVIL (NAV INFERIOR) *@
    <div class="nav-mobile-bottom d-lg-none">
        @if (User.IsInRole("Almacen"))
        {
            <a asp-controller="Pedidos" asp-action="Almacen" class="nav-mobile-item"><i class="bi bi-truck-flatbed"></i><span>Surtir</span></a>
            <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-journal-check"></i><span>Envíos</span></a>
        }
        else if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
        {
            <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
            <a asp-controller="Pedidos" asp-action="Almacen" class="nav-mobile-item"><i class="bi bi-truck-flatbed"></i><span>Almacén</span></a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="nav-mobile-item"><i class="bi bi-house"></i><span>Inicio</span></a>
            <a asp-controller="Carrito" asp-action="Index" class="nav-mobile-item position-relative">
                <i class="bi bi-cart3"></i><span>Carrito</span>
                @{
                    var tMob = Context.Session.GetObject<List<RefaccionariaWeb.Models.DTOs.ItemCarrito>>("Carrito")?.Sum(x => x.Cantidad) ?? 0;
                }
                @if (tMob > 0)
                {
                    <span class="position-absolute top-0 start-60 badge rounded-pill bg-danger" style="font-size:0.6rem">@tMob</span>
                }
            </a>
        }

        @if (User.IsInRole("Cliente"))
        {
            <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item">
                <i class="bi bi-bag-check"></i><span>Pedidos</span>
            </a>
        }

        <a href="javascript:void(0)" class="nav-mobile-item" onclick="toggleMLMenu()">
            <i class="bi bi-list"></i><span>Menú</span>
        </a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleMLMenu() {
            document.getElementById('ml-menu-overlay').classList.toggle('active');
            if(document.getElementById('ml-menu-overlay').classList.contains('active')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = 'auto';
            }
        }

        @if (TempData["AlertaCarrito"] != null)
        {
                <text>
                    Swal.fire({
                        title: '¡Agregado!',
                        html: 'Añadiste <strong>@TempData["CantidadAgregada"]</strong> de:<br>@TempData["ProductoAgregado"]',
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#2E86C1',
                        confirmButtonText: 'Ver Carrito',
                        cancelButtonText: 'Seguir viendo'
                    }).then((result) => { if (result.isConfirmed) { window.location.href = '@Url.Action("Index", "Carrito")'; } });
                </text>
        }
        @if (TempData["Error"] != null)
        {
                <text>
                    Swal.fire({ icon: 'warning', title: 'Atención', text: '@TempData["Error"]' });
                </text>
        }
    </script>
</body>
</html>