<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lotos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .nav-pc-link {
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: 0.2s;
        }

            .nav-pc-link:hover {
                background: #f8f9fa;
                color: #0d6efd !important;
            }

        body {
            padding-bottom: 70px;
        }
    </style>
</head>
<body class="bg-light">
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light container-fluid px-4">
            <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index">
                <i class="bi bi-gear-wide-connected text-primary"></i> RefaccionariaUt
            </a>
            <div class="d-flex align-items-center ms-auto">
                <div class="d-none d-lg-flex me-3">
                    <a class="nav-link text-dark nav-pc-link" asp-controller="Home" asp-action="Index">Catálogo</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Cliente"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Index">Mis Pedidos</a>
                        }
                        else
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Index">Ventas</a>
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Productos" asp-action="Index">Stock</a>
                        }
                    }
                </div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main class="container-fluid py-4">@RenderBody()</main>

    <div class="fixed-bottom bg-white border-top d-lg-none d-flex justify-content-around py-2 shadow">
        <a asp-controller="Home" asp-action="Index" class="text-center text-decoration-none text-dark small">
            <i class="bi bi-house d-block fs-4"></i>Inicio
        </a>
        <a asp-controller="Carrito" asp-action="Index" class="text-center text-decoration-none text-dark small">
            <i class="bi bi-cart3 d-block fs-4"></i>Carrito
        </a>
        <a asp-controller="Pedidos" asp-action="Index" class="text-center text-decoration-none text-dark small">
            <i class="bi bi-bag d-block fs-4"></i>Pedidos
        </a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>