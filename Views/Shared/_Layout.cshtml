@using RefaccionariaWeb.Extensions
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RefaccionariaUt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .nav-pc-link {
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: 0.2s;
            display: flex;
            align-items: center;
            color: #333;
            text-decoration: none;
        }

            .nav-pc-link:hover {
                background: #f8f9fa;
                color: #2E86C1 !important;
            }

        .dropdown-menu {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 1rem;
        }

        .dropdown-item {
            border-radius: 10px;
            padding: 0.6rem 1rem;
            font-weight: 500;
        }

        @@media (max-width: 991.98px) {
            .nav-mobile-bottom {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                height: 70px;
                background: white;
                display: flex;
                justify-content: space-around;
                align-items: center;
                box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
                z-index: 4000;
                border-top: 1px solid #f0f0f0;
            }

            .nav-mobile-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                color: #666;
                font-size: 0.75rem;
                text-decoration: none !important;
                flex: 1;
            }

                .nav-mobile-item i {
                    font-size: 1.4rem;
                    color: #2E86C1;
                }

            body {
                padding-bottom: 85px !important;
            }
        }

        #ml-menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100% - 70px);
            background: #f4f4f4;
            z-index: 3000;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

            #ml-menu-overlay.active {
                transform: translateX(0);
            }

        .ml-menu-header {
            background: linear-gradient(135deg, #2E86C1 0%, #1B2631 100%);
            color: white;
            padding: 2.5rem 1.5rem 1.8rem;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            position: relative;
        }

        .ml-menu-close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            font-size: 2.5rem;
            color: white;
            cursor: pointer;
        }

        .ml-menu-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #888;
            font-weight: 800;
            padding: 1rem 1.2rem 0.5rem;
            letter-spacing: 0.5px;
        }

        .ml-card-menu {
            background: white;
            border-radius: 15px;
            margin-bottom: 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            overflow: hidden;
            margin: 0 1rem;
        }

        .ml-menu-item {
            display: flex;
            align-items: center;
            padding: 1rem 1.2rem;
            color: #333;
            text-decoration: none !important;
            font-size: 1rem;
            font-weight: 500;
            border-bottom: 1px solid #f8f8f8;
        }

            .ml-menu-item i {
                font-size: 1.3rem;
                margin-right: 1.2rem;
                color: #2E86C1;
                width: 25px;
                text-align: center;
            }
    </style>
</head>
<body class="bg-light">

    @* MENÚ LATERAL MÓVIL *@
    <div id="ml-menu-overlay">
        <div class="ml-menu-header shadow">
            <span class="ml-menu-close" onclick="toggleMLMenu()">&times;</span>
            <div class="d-flex align-items-center mt-2">
                <div class="bg-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;"><i class="bi bi-person-circle text-primary fs-2"></i></div>
                <div>
                    <h5 class="mb-0 fw-bold text-white">Hola, @(User.Identity.IsAuthenticated? User.Identity.Name : "Invitado")</h5>
                    <p class="mb-0 small text-white opacity-75">Refaccionaria Lotos</p>
                </div>
            </div>
        </div>

        <div class="ml-menu-content">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="ml-menu-section-title">Operaciones</div>
                <div class="ml-card-menu">
                    @if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
                    {
                        <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack"></i> Ventas</a>
                        <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed"></i> Surtir Productos</a>
                        @* CORRECCIÓN ENLACE SCRAP *@
                        <a class="ml-menu-item" asp-controller="Scraps" asp-action="Index"><i class="bi bi-trash3"></i> Reportar Scrap</a>
                    }
                    @if (User.IsInRole("Cliente"))
                    {
                        <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-receipt"></i> Mis Pedidos</a>
                    }
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
                {
                    <div class="ml-menu-section-title">Inventario y Red</div>
                    <div class="ml-card-menu">
                        <a class="ml-menu-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a>
                        <a class="ml-menu-item" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a>
                        <a class="ml-menu-item" asp-controller="Compatibilidades" asp-action="Index"><i class="bi bi-diagram-3"></i> Compatibilidades</a>
                    </div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="ml-menu-section-title">Configuración</div>
                    <div class="ml-card-menu">
                        <a class="ml-menu-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i> Usuarios</a>
                        <a class="ml-menu-item" asp-controller="Configuracion" asp-action="Edit"><i class="bi bi-geo-alt"></i> Dirección sucursal</a>
                    </div>
                }
            }
        </div>
        <div class="mt-auto p-4 bg-white border-top"><partial name="_LoginPartial" /></div>
    </div>

    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-light py-2">
            <div class="container-fluid px-3">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index"><i class="bi bi-gear-wide-connected text-primary"></i> RefaccionariaUt</a>
                    <div class="d-none d-lg-block"><partial name="_LoginPartial" /></div>
                </div>

                @* CONDICIONAL PARA EL BUSCADOR GLOBAL: Solo aparece en el Catálogo *@
                @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
                {
                    <div class="row justify-content-center w-100 mt-2 mx-0">
                        <div class="col-12 col-lg-8">
                            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex rounded-pill border bg-light overflow-hidden shadow-sm">
                                <input name="searchString" class="form-control border-0 bg-transparent px-3 py-1" type="search" placeholder="Buscar refacción...">
                                <button class="btn border-0 text-muted" type="submit"><i class="bi bi-search"></i></button>
                            </form>
                        </div>
                    </div>
                }

                <div class="d-none d-lg-flex justify-content-center w-100 mt-2 border-top pt-2 gap-2">
                    <a class="nav-pc-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-2 text-primary"></i> Catálogo</a>

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Cliente"))
                        {
                            <a class="nav-pc-link" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-receipt me-2 text-primary"></i> Mis Pedidos</a>
                            <a class="nav-pc-link" asp-controller="Carrito" asp-action="Index"><i class="bi bi-cart3 me-2 text-primary"></i> Carrito</a>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
                        {
                            <a class="nav-pc-link" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack me-2 text-primary"></i> Ventas</a>
                            <a class="nav-pc-link" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed me-2 text-primary"></i> Surtir</a>
                            <a class="nav-pc-link" asp-controller="Scraps" asp-action="Index"><i class="bi bi-trash3 me-2 text-primary"></i> Scrap</a>

                            @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
                            {
                                <div class="dropdown">
                                    <a class="nav-pc-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-ui-checks-grid me-2 text-primary"></i> Gestión</a>
                                    <ul class="dropdown-menu shadow">
                                        <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a></li>
                                        <li><a class="dropdown-item" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Compatibilidades" asp-action="Index"><i class="bi bi-diagram-3"></i> Compatibilidades</a></li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i> Usuarios</a></li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <a class="nav-pc-link" asp-controller="Carrito" asp-action="Index"><i class="bi bi-cart3 me-2 text-primary"></i> Carrito</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mb-5 mt-3"><main role="main">@RenderBody()</main></div>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account")
    {
        <div class="nav-mobile-bottom d-lg-none">
            <a asp-controller="Home" asp-action="Index" class="nav-mobile-item"><i class="bi bi-house"></i><span>Inicio</span></a>

            @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
            {
                <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
            }

            @if (!User.Identity.IsAuthenticated || User.IsInRole("Cliente"))
            {
                <a asp-controller="Carrito" asp-action="Index" class="nav-mobile-item position-relative">
                    <i class="bi bi-cart3"></i><span>Carrito</span>
                    @{
                        var countMob = Context.Session.GetObject<List<RefaccionariaWeb.Models.DTOs.ItemCarrito>>("Carrito")?.Sum(x => x.Cantidad) ?? 0;
                    }
                    @if (countMob > 0)
                    {
                        <span class="position-absolute top-0 start-60 badge rounded-pill bg-danger" style="font-size:0.6rem">@countMob</span>
                    }
                </a>
            }

            <a href="javascript:void(0)" class="nav-mobile-item" onclick="toggleMLMenu()"><i class="bi bi-list"></i><span>Menú</span></a>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleMLMenu() { var menu = document.getElementById('ml-menu-overlay'); if(menu) menu.classList.toggle('active'); }

        $(document).ready(function() {
            var successMsg = '@TempData["Success"]' || '@TempData["CartMessage"]';
            var errorMsg = '@TempData["Error"]';

            if(successMsg) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Añadido!',
                    text: successMsg,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }

            if(errorMsg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: errorMsg,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 4000
                });
            }
        });
    </script>
</body>
</html>