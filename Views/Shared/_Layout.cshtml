@using RefaccionariaWeb.Extensions
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lotos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* Estilos PC */
        .nav-pc-link {
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: 0.2s;
            display: flex;
            align-items: center;
        }

            .nav-pc-link:hover {
                background: #f8f9fa;
                color: #2E86C1 !important;
            }

        /* Ajuste de scroll para el body cuando el menú está abierto */
        .no-scroll {
            overflow: hidden !important;
        }

        @@media (max-width: 991.98px) {
            .nav-mobile-bottom {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                height: 70px;
                background: white;
                display: flex;
                justify-content: space-around;
                align-items: center;
                box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
                z-index: 3000 !important;
                border-top: 1px solid #f0f0f0;
            }

            .nav-mobile-item {
                color: #1B2631;
                text-decoration: none !important;
                text-align: center;
                font-size: 0.7rem;
                font-weight: 700;
                flex: 1;
            }

                .nav-mobile-item i {
                    font-size: 1.4rem;
                    display: block;
                    margin-bottom: 2px;
                }

            body {
                /* Si no es cuenta de acceso, dejamos espacio para la barra */
                padding-bottom: @( (ViewContext.RouteData.Values["controller"]?.ToString() == "Account") ? "0px" : "80px" ) !important;
            }
        }

        /* --- MENÚ OVERLAY ML STYLE --- */
        #ml-menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: @( (ViewContext.RouteData.Values["controller"]?.ToString() == "Account") ? "100%" : "calc(100% - 70px)" );
            background: #fff;
            z-index: 2500;
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

            #ml-menu-overlay.active {
                transform: translateX(0);
            }

        .ml-menu-header {
            background: linear-gradient(135deg, #2E86C1 0%, #1B2631 100%);
            color: white;
            padding: 2.5rem 1.5rem 1.5rem;
            position: relative;
        }

        .ml-menu-close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            font-size: 2.5rem;
            color: white;
            cursor: pointer;
            line-height: 1;
        }

        .ml-menu-section {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .ml-menu-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #aaa;
            font-weight: 800;
            margin-bottom: 0.8rem;
        }

        .ml-menu-item {
            display: flex;
            align-items: center;
            padding: 0.7rem 0;
            color: #333;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 500;
        }

            .ml-menu-item i {
                font-size: 1.3rem;
                margin-right: 1rem;
                color: #2E86C1;
                width: 25px;
            }
    </style>
</head>
<body class="bg-light">
    <div id="ml-menu-overlay">
        <div class="ml-menu-header">
            <span class="ml-menu-close" onclick="toggleMLMenu()">&times;</span>
            <div class="d-flex align-items-center mt-2">
                <div class="bg-white rounded-circle me-3 shadow-sm" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-person-fill text-primary fs-3"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold">Hola, @(User.Identity.IsAuthenticated? User.Identity.Name : "Invitado")</h5>
                    <p class="mb-0 small opacity-75">Refaccionaria Lotos</p>
                </div>
            </div>
        </div>

        @if (User.Identity.IsAuthenticated)
        {
            @if (User.IsInRole("Cliente"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Mi Actividad</div>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-bag-check"></i> Mis Pedidos</a>
                    <a class="ml-menu-item" href="#"><i class="bi bi-person-gear"></i> Mi Perfil</a>
                </div>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Almacen") || User.IsInRole("Mostrador"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Operaciones</div>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed"></i> Almacén</a>
                    <a class="ml-menu-item" href="#"><i class="bi bi-trash3 text-danger"></i> Scrap (Prox.)</a>
                </div>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
            {
                <div class="ml-menu-section">
                    <div class="ml-menu-section-title">Administración</div>
                    <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack"></i> Ventas</a>
                    <a class="ml-menu-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a>
                </div>
            }
        }
        <div class="ml-menu-section mt-auto bg-light border-top">
            <partial name="_LoginPartial" />
        </div>
    </div>

    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-light py-2">
            <div class="container-fluid px-3">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-gear-wide-connected text-primary"></i> Lotos
                    </a>
                    <div class="ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>

                @* Buscador Movil y PC *@
                @if (!User.IsInRole("Almacen"))
                {
                    <div class="row justify-content-center w-100 mt-2 mx-0">
                        <div class="col-12 col-lg-8 px-1">
                            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex rounded-pill border bg-light w-100 overflow-hidden shadow-sm">
                                <input name="searchString" class="form-control border-0 bg-transparent px-3 py-1" type="search" placeholder="Buscar refacción...">
                                <button class="btn border-0 text-muted" type="submit"><i class="bi bi-search"></i></button>
                            </form>
                        </div>
                    </div>
                }

                @* Navegación PC *@
                <div class="d-none d-lg-flex justify-content-center w-100 mt-2 border-top pt-2">
                    <a class="nav-link text-dark nav-pc-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-2 text-primary"></i> Catálogo</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack me-2 text-primary"></i> Ventas</a>
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam me-2 text-primary"></i> Inventario</a>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Almacen") || User.IsInRole("Mostrador"))
                        {
                            <a class="nav-link text-dark nav-pc-link" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed me-2 text-primary"></i> Almacén</a>
                        }
                        @if (User.IsInRole("Cliente"))
                        {
                            <a class="nav-link text-dark nav-pc-link position-relative" asp-controller="Carrito" asp-action="Index">
                                <i class="bi bi-cart3 me-2 text-primary"></i> Carrito
                                @{
                                    var tPC = Context.Session.GetObject<List<RefaccionariaWeb.Models.DTOs.ItemCarrito>>("Carrito")?.Sum(x => x.Cantidad) ?? 0;
                                }
                                @if (tPC > 0)
                                {
                                    <span class="badge rounded-pill bg-danger ms-1">@tPC</span>
                                }
                            </a>
                        }
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mb-5 mt-3">
        <main role="main">@RenderBody()</main>
    </div>

    @* BARRA MÓVIL PERSISTENTE *@
    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account")
    {
        <div class="nav-mobile-bottom d-lg-none">
            @if (User.IsInRole("Almacen"))
            {
                <a asp-controller="Pedidos" asp-action="Almacen" class="nav-mobile-item"><i class="bi bi-truck-flatbed"></i><span>Surtir</span></a>
                <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-journal-check"></i><span>Envíos</span></a>
            }
            else if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
            {
                <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
                <a asp-controller="Pedidos" asp-action="Almacen" class="nav-mobile-item"><i class="bi bi-truck-flatbed"></i><span>Almacén</span></a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="nav-mobile-item"><i class="bi bi-house"></i><span>Inicio</span></a>
                <a asp-controller="Carrito" asp-action="Index" class="nav-mobile-item position-relative">
                    <i class="bi bi-cart3"></i><span>Carrito</span>
                    @{
                        var tMob = Context.Session.GetObject<List<RefaccionariaWeb.Models.DTOs.ItemCarrito>>("Carrito")?.Sum(x => x.Cantidad) ?? 0;
                    }
                    @if (tMob > 0)
                    {
                        <span class="position-absolute top-0 start-60 badge rounded-pill bg-danger" style="font-size:0.6rem">@tMob</span>
                    }
                </a>
            }
            <a href="javascript:void(0)" class="nav-mobile-item" onclick="toggleMLMenu()"><i class="bi bi-list"></i><span>Menú</span></a>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleMLMenu() {
            var menu = document.getElementById('ml-menu-overlay');
            if(menu) {
                menu.classList.toggle('active');
                document.body.classList.toggle('no-scroll');
            }
        }

        @if (TempData["AlertaCarrito"] != null)
        {
                <text>
                    Swal.fire({
                        title: '¡Agregado!',
                        html: 'Añadiste <strong>@TempData["CantidadAgregada"]</strong> de:<br>@TempData["ProductoAgregado"]',
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#2E86C1',
                        confirmButtonText: 'Ver Carrito',
                        cancelButtonText: 'Seguir viendo'
                    }).then((result) => { if (result.isConfirmed) { window.location.href = '@Url.Action("Index", "Carrito")'; } });
                </text>
        }
        @if (TempData["Error"] != null)
        {
                <text>
                    Swal.fire({ icon: 'warning', title: 'Atención', text: '@TempData["Error"]' });
                </text>
        }
    </script>
</body>
</html>