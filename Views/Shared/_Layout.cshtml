@using RefaccionariaWeb.Extensions
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RefaccionariaUt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* ESTILOS NAVEGACIÓN PC */
        .nav-pc-link {
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: 0.2s;
            display: flex;
            align-items: center;
            color: #333;
            text-decoration: none;
        }

            .nav-pc-link:hover {
                background: #f8f9fa;
                color: #2E86C1 !important;
            }

        .dropdown-menu {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 1rem;
        }

        .dropdown-item {
            border-radius: 10px;
            padding: 0.6rem 1rem;
            font-weight: 500;
        }

            .dropdown-item i {
                margin-right: 10px;
                color: #2E86C1;
            }

        /* BARRA MÓVIL INFERIOR */
        @@media (max-width: 991.98px) {
            .nav-mobile-bottom {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                height: 70px;
                background: white;
                display: flex;
                justify-content: space-around;
                align-items: center;
                box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
                z-index: 4000;
                border-top: 1px solid #f0f0f0;
            }

            .nav-mobile-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                color: #666;
                font-size: 0.75rem;
                text-decoration: none !important;
                flex: 1;
            }

                .nav-mobile-item i {
                    font-size: 1.4rem;
                    color: #2E86C1;
                }

            body {
                padding-bottom: 85px !important;
            }
        }

        /* OVERLAY SECCIONADO (EL QUE ESTABA CHIDO) */
        #ml-menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100% - 70px);
            background: #f4f4f4;
            z-index: 3000;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

            #ml-menu-overlay.active {
                transform: translateX(0);
            }

        .ml-menu-header {
            background: linear-gradient(135deg, #2E86C1 0%, #1B2631 100%);
            color: white;
            padding: 2.5rem 1.5rem 1.8rem;
            position: relative;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
        }

        .ml-menu-close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            font-size: 2.5rem;
            color: white;
            cursor: pointer;
        }

        .ml-menu-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #888;
            font-weight: 800;
            padding: 1rem 1.2rem 0.5rem;
            letter-spacing: 0.5px;
        }

        .ml-card-menu {
            background: white;
            border-radius: 15px;
            margin-bottom: 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            overflow: hidden;
            margin: 0 1rem;
        }

        .ml-menu-item {
            display: flex;
            align-items: center;
            padding: 1rem 1.2rem;
            color: #333;
            text-decoration: none !important;
            font-size: 1rem;
            font-weight: 500;
            border-bottom: 1px solid #f8f8f8;
        }

            .ml-menu-item i {
                font-size: 1.3rem;
                margin-right: 1.2rem;
                color: #2E86C1;
                width: 25px;
                text-align: center;
            }
    </style>
</head>
<body class="bg-light">

    @* MENÚ OVERLAY MÓVIL SECCIONADO *@
    <div id="ml-menu-overlay">
        <div class="ml-menu-header shadow">
            <span class="ml-menu-close" onclick="toggleMLMenu()">&times;</span>
            <div class="d-flex align-items-center mt-2">
                <div class="bg-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                    <i class="bi bi-person-circle text-primary fs-2"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold">Hola, @(User.Identity.IsAuthenticated? User.Identity.Name : "Invitado")</h5>
                    <p class="mb-0 small opacity-75">Refaccionaria Lotos</p>
                </div>
            </div>
        </div>

        <div class="ml-menu-content">
            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Admin") || User.IsInRole("Mostrador") || User.IsInRole("Almacen"))
                {
                    <div class="ml-menu-section-title">Operaciones Diarias</div>
                    <div class="ml-card-menu">
                        <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack"></i> Ventas</a>
                        <a class="ml-menu-item" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed"></i> Almacén</a>
                        <a class="ml-menu-item" asp-controller="Scraps" asp-action="Index"><i class="bi bi-trash3 text-danger"></i> Reportar Scrap</a>
                    </div>

                    <div class="ml-menu-section-title">Catálogo y Red</div>
                    <div class="ml-card-menu">
                        <a class="ml-menu-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a>
                        <a class="ml-menu-item" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a>
                        <a class="ml-menu-item" asp-controller="Compatibilidades" asp-action="Index"><i class="bi bi-diagram-3"></i> Compatibilidades</a>
                    </div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="ml-menu-section-title">Configuración Admin</div>
                    <div class="ml-card-menu">
                        <a class="ml-menu-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i> Personal / Usuarios</a>
                        <a class="ml-menu-item" asp-controller="Configuracion" asp-action="Edit"><i class="bi bi-gear"></i> Ajustes</a>
                    </div>
                }
            }
        </div>
        <div class="mt-auto p-4 bg-white border-top">
            <partial name="_LoginPartial" />
        </div>
    </div>

    @* NAVBAR PC - COMPLETA CON TODOS LOS BOTONES *@
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-light py-2">
            <div class="container-fluid px-3">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-gear-wide-connected text-primary"></i> RefaccionariaUt
                    </a>
                    <div class="d-none d-lg-block">
                        <partial name="_LoginPartial" />
                    </div>
                </div>

                <div class="d-none d-lg-flex justify-content-center w-100 mt-2 border-top pt-2 gap-2">
                    <a class="nav-pc-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-2 text-primary"></i> Catálogo</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a class="nav-pc-link" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-cash-stack me-2 text-primary"></i> Ventas</a>
                        <a class="nav-pc-link" asp-controller="Pedidos" asp-action="Almacen"><i class="bi bi-truck-flatbed me-2 text-primary"></i> Almacén</a>

                        <div class="dropdown">
                            <a class="nav-pc-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-ui-checks-grid me-2 text-primary"></i> Gestión
                            </a>
                            <ul class="dropdown-menu shadow">
                                <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a></li>
                                <li><a class="dropdown-item" asp-controller="Scraps" asp-action="Index"><i class="bi bi-trash3 text-danger"></i> Scrap</a></li>
                                <li><a class="dropdown-item" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i> Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Configuracion" asp-action="Edit"><i class="bi bi-gear"></i> Ajustes</a></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid mb-5 mt-3">
        <main role="main">@RenderBody()</main>
    </div>

    @* BARRA MÓVIL INFERIOR SECCIONADA *@
    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account")
    {
        <div class="nav-mobile-bottom d-lg-none">
            <a asp-controller="Home" asp-action="Index" class="nav-mobile-item"><i class="bi bi-house"></i><span>Inicio</span></a>
            @if (User.IsInRole("Almacen"))
            {
                <a asp-controller="Pedidos" asp-action="Almacen" class="nav-mobile-item"><i class="bi bi-truck-flatbed"></i><span>Surtir</span></a>
            }
            else if (User.IsInRole("Admin") || User.IsInRole("Mostrador"))
            {
                <a asp-controller="Pedidos" asp-action="Index" class="nav-mobile-item"><i class="bi bi-cash-stack"></i><span>Ventas</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Almacen"))
            {
                <a asp-controller="Scraps" asp-action="Index" class="nav-mobile-item"><i class="bi bi-trash3 text-danger"></i><span>Scrap</span></a>
            }
            <a href="javascript:void(0)" class="nav-mobile-item" onclick="toggleMLMenu()"><i class="bi bi-list"></i><span>Menú</span></a>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleMLMenu() {
            var menu = document.getElementById('ml-menu-overlay');
            if(menu) {
                menu.classList.toggle('active');
                document.body.classList.toggle('no-scroll');
            }
        }
    </script>
</body>
</html>