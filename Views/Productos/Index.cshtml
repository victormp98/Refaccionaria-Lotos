@model IEnumerable<RefaccionariaWeb.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="container mt-4">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Crear Nuevo Producto</a>
            <a asp-action="Papelera" class="btn btn-secondary"><i class="bi bi-trash me-2"></i>Ver Papelera</a>
        }
    </p>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>SKU</th>
                    <th>Precio Venta</th>
                    <th>Stock</th>
                    <th>Visibilidad</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/no-image.png" : item.ImagenUrl)" class="rounded border me-3" style="width: 40px; height: 40px; object-fit: cover;" />
                                <span class="fw-bold">@Html.DisplayFor(modelItem => item.Nombre)</span>
                            </div>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.SKU)</td>
                        <td>@Html.DisplayFor(modelItem => item.PrecioVenta)</td>
                        <td>@Html.DisplayFor(modelItem => item.Stock)</td>
                        <td>
                            @if (item.EsVisibleEnLinea)
                            {
                                <span class="badge bg-success">Online</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Oculto</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Detalles"><i class="bi bi-search"></i></a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                    
                                    <!-- Botón para Alternar Visibilidad Web (Usa un form para POST) -->
                                    <form asp-action="AlternarVisibilidadWeb" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(item.EsVisibleEnLinea ? "btn-outline-info" : "btn-outline-secondary")" title="@(item.EsVisibleEnLinea ? "Ocultar de la Web" : "Mostrar en la Web")">
                                            <i class="bi @(item.EsVisibleEnLinea ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                        </button>
                                    </form>

                                    <!-- Botón para Mover a Papelera (Usa un form para POST) -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="get" class="d-inline">
                                         <button type="submit" class="btn btn-sm btn-outline-danger" title="Mover a Papelera">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }

                                @* Nuevo Botón 'Compra' para Admin y Almacen *@
                                @if (User.IsInRole("Admin") || User.IsInRole("Almacen"))
                                {
                                    <a asp-action="Compra" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Registrar Compra"><i class="bi bi-box-seam"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>