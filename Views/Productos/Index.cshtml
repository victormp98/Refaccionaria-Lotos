@model IEnumerable<RefaccionariaWeb.Models.Producto>
@{
    ViewData["Title"] = "Inventario";
}

<style>
    :root {
        --primary-soft: #e3f2fd;
        --secondary-soft: #f5f5f5;
        --danger-soft: #ffebee;
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
        text-decoration: none;
    }

    .btn-edit {
        background: var(--primary-soft);
        color: #0d6efd;
    }

    .btn-view {
        background: var(--secondary-soft);
        color: #6c757d;
    }

    .btn-del {
        background: var(--danger-soft);
        color: #dc3545;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-2">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam-fill text-primary"></i> Inventario</h2>
        <div class="d-flex gap-2">
            <a asp-action="Papelera" class="btn btn-outline-danger rounded-pill px-3 fw-bold"><i class="bi bi-trash3"></i> Papelera</a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow fw-bold"><i class="bi bi-plus-lg"></i> Nuevo</a>
        </div>
    </div>

    @* PC *@
    <div class="table-responsive d-none d-md-block shadow-sm rounded-4 overflow-hidden border">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Producto</th>
                    <th>Marca</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/no-image.png" : item.ImagenUrl)" class="rounded-3 me-3 border" style="width: 45px; height: 45px; object-fit: cover;" />
                                <div><div class="fw-bold">@item.Nombre</div><small class="text-muted">@item.SKU</small></div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.MarcaPieza</span></td>
                        <td class="fw-bold text-success">$@item.PrecioVenta</td>
                        <td><span class="badge @(item.Stock < 5 ? "bg-danger" : "bg-dark") rounded-pill px-3">@item.Stock pzas</span></td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit"><i class="bi bi-pencil-square"></i> Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view"><i class="bi bi-eye"></i> Ver</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-del"><i class="bi bi-trash"></i> Quitar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* MÓVIL *@
    <div class="d-block d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 border-start border-5 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/no-image.png" : item.ImagenUrl)" class="rounded-3 border me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-0">@item.Nombre</h6>
                            <div class="text-muted small">@item.MarcaPieza | SKU: @item.SKU</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">Papelera</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>