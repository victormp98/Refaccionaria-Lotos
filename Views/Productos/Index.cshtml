@model IEnumerable<RefaccionariaWeb.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
    string currentFilter = ViewData["CurrentFilter"] as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-2">
        <h1 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam me-2"></i> Inventario de Productos</h1>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Papelera" class="btn btn-outline-danger rounded-pill px-3 fw-bold"><i class="bi bi-trash3"></i> Papelera</a>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow fw-bold"><i class="bi bi-plus-lg"></i> Nuevo Producto</a>
            }
        </div>
    </div>

    <!-- Buscador -->
    <form asp-action="Index" asp-controller="Productos" method="get" class="mb-4">
        <div class="input-group shadow-sm rounded-pill overflow-hidden border">
            <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0" placeholder="Buscar por Nombre, SKU o Marca...">
            <button class="btn btn-primary border-0 fw-bold" type="submit">Buscar</button>
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <a asp-action="Index" asp-controller="Productos" class="btn btn-outline-secondary border-0" title="Limpiar búsqueda"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>

    <!-- Vista de Tabla para Escritorio -->
    <div class="d-none d-lg-block shadow-sm rounded-4 overflow-hidden border">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Producto</th>
                    <th>SKU</th>
                    <th>Precio Venta</th>
                    <th>Stock</th>
                    <th>Visibilidad</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/no-image.png" : item.ImagenUrl)" class="rounded border me-3" style="width: 40px; height: 40px; object-fit: cover;" />
                                <span class="fw-bold">@item.Nombre</span>
                            </div>
                        </td>
                        <td>@item.SKU</td>
                        <td>@item.PrecioVenta.ToString("C")</td>
                        <td>@item.Stock</td>
                        <td>
                            @if (item.EsVisibleEnLinea)
                            {
                                <span class="badge bg-success">Online</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Oculto</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Detalles"><i class="bi bi-search"></i></a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Almacen"))
                                {
                                    <a asp-action="Compra" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Registrar Compra"><i class="bi bi-box-seam"></i></a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="AlternarVisibilidadWeb" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(item.EsVisibleEnLinea ? "btn-outline-info" : "btn-outline-secondary")" title="@(item.EsVisibleEnLinea ? "Ocultar de la Web" : "Mostrar en la Web")">
                                            <i class="bi @(item.EsVisibleEnLinea ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="get" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Mover a Papelera"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Vista de Tarjetas para Móvil (Diseño estandarizado con Vehículos) -->
    <div class="d-lg-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 shadow-sm border-0 rounded-4 border-start border-5 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="fw-bold mb-0">@item.Nombre</h6>
                            <small class="text-muted">SKU: @item.SKU</small>
                        </div>
                        <span class="badge bg-light text-dark border rounded-pill">@item.PrecioVenta.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge @(item.Stock > 0 ? "bg-dark" : "bg-danger")">Stock: @item.Stock</span>
                        @if (item.EsVisibleEnLinea)
                        {
                            <span class="badge bg-success">Online</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Oculto</span>
                        }
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top mt-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Detalles</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Almacen"))
                        {
                            <a asp-action="Compra" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success rounded-pill px-3">Surtir</a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Editar</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="get" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Quitar</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
