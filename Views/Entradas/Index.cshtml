@model IEnumerable<RefaccionariaWeb.Models.Producto>

@{
    ViewData["Title"] = "Entradas de Almacén";
}

<style>
    /* Estilo de tarjeta idéntico al de Scrap */
    .card-entrada {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
    }

        .card-entrada:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .img-container {
        height: 180px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        position: relative;
    }

    .img-producto {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }

    .badge-sku {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(5px);
        color: #333;
        font-weight: 700;
        font-size: 0.7rem;
        padding: 5px 12px;
        border-radius: 50px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    /* Buscador estilo píldora */
    .search-pill {
        border-radius: 50px;
        padding: 10px 25px;
        border: 2px solid #e9ecef;
        transition: 0.3s;
        background: #fff;
    }

        .search-pill:focus-within {
            border-color: #198754;
            box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.1);
        }

    /* Botón flotante o superior redondeado */
    .btn-historial {
        border-radius: 50px;
        font-weight: 600;
        padding: 8px 20px;
    }
</style>

<div class="container mt-3 mb-5">
    @* Cabecera *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Entradas</h3>
            <p class="text-muted small mb-0">Gestión de stock de almacén</p>
        </div>
        @* Botón que solo va al historial de entradas *@
        <a asp-action="Historial" class="btn btn-outline-success btn-historial shadow-sm">
            <i class="bi bi-clock-history me-1"></i> Ver Historial
        </a>
    </div>

    @* Buscador *@
    <div class="search-pill d-flex align-items-center mb-4 shadow-sm">
        <i class="bi bi-search text-muted me-2"></i>
        <input type="text" id="inputBusqueda" class="form-control border-0 bg-transparent p-0"
               placeholder="Buscar por nombre o SKU..." onkeyup="filtrarProductos()">
    </div>

    @* Grid de Tarjetas *@
    <div class="row g-3" id="listaProductos">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 card-item">
                <div class="card card-entrada shadow-sm h-100">
                    <div class="img-container">
                        <span class="badge-sku">@item.SKU</span>
                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                        {
                            <img src="@item.ImagenUrl" class="img-producto" alt="@item.Nombre">
                        }
                        else
                        {
                            <i class="bi bi-image text-light-emphasis display-1"></i>
                        }
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <h6 class="fw-bold text-dark mb-2">@item.Nombre</h6>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-10 text-success rounded-3 px-2 py-1 small fw-bold">
                                <i class="bi bi-box-seam me-1"></i>Stock: @item.Stock
                            </div>
                        </div>
                        <button class="btn btn-success w-100 rounded-pill mt-auto fw-bold py-2 shadow-sm"
                                onclick="abrirModal(@item.Id, '@item.Nombre')">
                            <i class="bi bi-plus-circle me-2"></i>Registrar Entrada
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Modal de Registro (Verde) *@
<div class="modal fade" id="modalEntrada" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 25px;">
            <div class="modal-header border-0 bg-success text-white p-4" style="border-radius: 25px 25px 0 0;">
                <h5 class="modal-title fw-bold"><i class="bi bi-arrow-down-circle me-2"></i>Nueva Entrada</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RegistrarEntrada" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="productoId" id="modalProdId" />
                    <div class="text-center mb-4">
                        <p class="text-muted small mb-1">PRODUCTO SELECCIONADO</p>
                        <h5 id="modalProdNombre" class="fw-bold text-dark"></h5>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">CANTIDAD A INGRESAR</label>
                        <input type="number" name="cantidad" class="form-control form-control-lg border-2 rounded-4" min="1" required />
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold small text-muted">REFERENCIA O FACTURA</label>
                        <input type="text" name="referencia" class="form-control border-2 rounded-4" placeholder="Ej. Factura #4450" />
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModal(id, nombre) {
            document.getElementById('modalProdId').value = id;
            document.getElementById('modalProdNombre').innerText = nombre;
            new bootstrap.Modal(document.getElementById('modalEntrada')).show();
        }

        function filtrarProductos() {
            let filtro = document.getElementById('inputBusqueda').value.toLowerCase();
            let cards = document.getElementsByClassName('card-item');
            for (let card of cards) {
                let texto = card.innerText.toLowerCase();
                card.style.display = texto.includes(filtro) ? "" : "none";
            }
        }
    </script>
}