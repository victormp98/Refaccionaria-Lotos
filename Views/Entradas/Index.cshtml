@model IEnumerable<RefaccionariaWeb.Models.Producto>

@{
    ViewData["Title"] = "Entradas de Almacén";
}

<div class="container mt-3 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0"><i class="bi bi-box-arrow-in-right text-success"></i> Entradas</h4>
        <a asp-action="Historial" class="btn btn-sm btn-outline-success rounded-pill px-3">
            <i class="bi bi-clock-history"></i> Ver Historial
        </a>
    </div>

    @* Buscador Píldora *@
    <div class="d-flex align-items-center mb-4 border rounded-pill bg-white shadow-sm px-3 py-1">
        <i class="bi bi-search text-muted me-2"></i>
        <input type="text" id="buscador" class="form-control border-0 bg-transparent" placeholder="Buscar producto..." onkeyup="filtrar()">
    </div>

    <div class="row g-3" id="contenedorProductos">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 item-producto">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                    @* Contenedor de Imagen igual a Scrap *@
                    <div style="height: 180px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; padding: 10px;">
                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                        {
                            <img src="@item.ImagenUrl" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                        }
                        else
                        {
                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <h6 class="fw-bold mb-0">@item.Nombre</h6>
                            <small class="text-muted">@item.SKU</small>
                        </div>

                        <p class="small text-muted mb-3">
                            <i class="bi bi-archive"></i> Stock: <span class="fw-bold text-primary">@item.Stock</span>
                        </p>

                        <button type="button" class="btn btn-success w-100 rounded-pill fw-bold mt-auto"
                                onclick="abrirModal(@item.Id, '@item.Nombre')">
                            <i class="bi bi-plus-lg"></i> Registrar Entrada
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Modal de Registro *@
<div class="modal fade" id="modalEntrada" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 20px;">
            <form asp-action="RegistrarEntrada" method="post">
                <div class="modal-header border-0 bg-success text-white" style="border-radius: 20px 20px 0 0;">
                    <h5 class="modal-title fw-bold">Nueva Entrada</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <input type="hidden" name="productoId" id="mId" />
                    <p class="text-muted mb-1 small">PRODUCTO</p>
                    <h5 id="mNombre" class="fw-bold mb-4"></h5>

                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold">Cantidad</label>
                        <input type="number" name="cantidad" class="form-control rounded-pill" min="1" required />
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold">Referencia</label>
                        <input type="text" name="referencia" class="form-control rounded-pill" placeholder="Ej. Factura #001" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModal(id, nombre) {
            document.getElementById('mId').value = id;
            document.getElementById('mNombre').innerText = nombre;
            new bootstrap.Modal(document.getElementById('modalEntrada')).show();
        }
        function filtrar() {
            let v = document.getElementById('buscador').value.toLowerCase();
            let items = document.getElementsByClassName('item-producto');
            for (let i = 0; i < items.length; i++) {
                items[i].style.display = items[i].innerText.toLowerCase().includes(v) ? "" : "none";
            }
        }
    </script>
}