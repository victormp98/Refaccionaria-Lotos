@model IEnumerable<RefaccionariaWeb.Models.MovimientoInventario>

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold"><i class="bi bi-clock-history text-success"></i> Historial de Entradas</h4>
        <a asp-action="Index" class="btn btn-sm btn-secondary rounded-pill">Volver</a>
    </div>

    <div class="table-responsive shadow-sm rounded-4 bg-white p-3">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Usuario</th>
                    <th>Referencia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="small">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-bold">@item.Producto?.Nombre</td>
                        <td class="text-success fw-bold">+@item.Cantidad</td>
                        <td>@item.NombreUsuario</td>
                        <td class="small text-muted">@item.Referencia</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>